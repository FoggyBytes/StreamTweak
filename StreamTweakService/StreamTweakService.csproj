<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SelfContained>false</SelfContained>
    <AssemblyName>StreamTweakService</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
    <!--
      10.2.0: System.IO.Pipes.AccessControl 5.0.0 and the System.Text.Json 8.0.6 pin are gone.
      On .NET 10 both are part of the shared framework (the SDK flags them NU1510), so the
      runtime the setup installs services them — including the two DoS CVEs the pin closed on
      the 8.0 line (CVE-2024-30105, CVE-2024-43485).
    -->
  </ItemGroup>

  <ItemGroup>
    <!-- The GPU power state that crosses the pipe (9.2.0). One file for both sides: the
         service does not reference StreamTweak.Core, so it compiles this one by link. -->
    <Compile Include="..\StreamTweak.Core\Nvidia\GpuPowerState.cs" Link="Shared\GpuPowerState.cs" />
    <!-- The "is a stream live?" probe (10.0.0): asked once more right before the service
         restarts the streaming server (Sync and restart, SECURITY.md). -->
    <Compile Include="..\StreamTweak.Core\UdpSockets.cs" Link="Shared\UdpSockets.cs" />
  </ItemGroup>

</Project>
