<Application
    x:Class="StreamTweak.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 3 Fluent control styles -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- StreamTweak design system (fonts, colors, styles, converters) -->
                <ResourceDictionary Source="ms-appx:///Themes/StreamTweakStyles.xaml"/>
                <!-- StreamTweak 8.0 additive layer (master-detail rail, 8.0 pages) -->
                <ResourceDictionary Source="ms-appx:///Themes/StreamTweak8.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
