<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:StreamTweak.Converters">

    <!-- ═══════════════════════════════════════════════════════════════════════
         STREAMTWEAK DESIGN SYSTEM — v6.0 Redesign
         Tutti i valori in pixel logici (device-independent).
         CharacterSpacing: unità 1/1000 em  (0.08em = 80, -0.02em = -20)
    ════════════════════════════════════════════════════════════════════════ -->

    <!-- ── FONTS ─────────────────────────────────────────────────────── -->
    <FontFamily x:Key="DMSans">ms-appx:///Resources/DMSans-Regular.ttf#DM Sans</FontFamily>
    <FontFamily x:Key="DMSansMedium">ms-appx:///Resources/DMSans-Medium.ttf#DM Sans</FontFamily>
    <FontFamily x:Key="DMSansSemiBold">ms-appx:///Resources/DMSans-SemiBold.ttf#DM Sans</FontFamily>
    <FontFamily x:Key="JetBrainsMono">ms-appx:///Resources/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
    <FontFamily x:Key="JetBrainsMonoMedium">ms-appx:///Resources/JetBrainsMono-Medium.ttf#JetBrains Mono</FontFamily>

    <!-- ── COLOR TOKENS ──────────────────────────────────────────────────────── -->
    <!-- Superfici — semi-trasparenti per lasciare filtrare Mica.
         Alpha ridotto (50–88%) per lasciare emergere l'effetto Mica Base. -->
    <SolidColorBrush x:Key="STBackground"     Color="Transparent"/>
    <SolidColorBrush x:Key="STSidebar"        Color="Transparent"/>
    <SolidColorBrush x:Key="STCard"           Color="#E60C0C0E"/>
    <SolidColorBrush x:Key="STInput"          Color="#E6141416"/>
    <SolidColorBrush x:Key="STTitlebar"       Color="Transparent"/>

    <!-- Bordi -->
    <SolidColorBrush x:Key="STBorder"         Color="#2a2724"/>
    <SolidColorBrush x:Key="STBorderSubtle"   Color="#1a1815"/>
    <SolidColorBrush x:Key="STBorderActive"   Color="#59379957"/>

    <!-- Testo -->
    <SolidColorBrush x:Key="STTextPrimary"    Color="#FCFBFA"/>
    <SolidColorBrush x:Key="STTextSecondary"  Color="#DEDAD6"/>
    <SolidColorBrush x:Key="STTextMuted"      Color="#A8A49F"/>
    <SolidColorBrush x:Key="STTextDim"        Color="#8C8884"/>
    <SolidColorBrush x:Key="STTextGhost"      Color="#3a3835"/>

    <!-- Semantici — versioni più brillanti per testo/icone ad alto contrasto -->
    <SolidColorBrush x:Key="STSuccess"        Color="#4ade80"/>
    <SolidColorBrush x:Key="STWarning"        Color="#fbbf24"/>
    <SolidColorBrush x:Key="STDanger"         Color="#f87171"/>

    <!-- Accent puro (SystemAccentColor, non la variante Light2 usata da WinUI3 di default) -->
    <SolidColorBrush x:Key="STAccent"         Color="#4ade80"/>

    <!-- Force the OS system accent to StreamTweak green, so built-in WinUI controls
         that reference the accent IMPLICITLY (ListView selection indicator, ProgressRing
         spinner, focus visuals, RadioButton/Slider, hyperlinks, …) never fall back to the
         blue OS accent. App-authored controls use the ST_* brushes; these cover the rest. -->
    <Color x:Key="SystemAccentColor">#FF4ade80</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"          Color="#4ade80"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"        Color="#E64ade80"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"         Color="#CC4ade80"/>
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush"         Color="#514ade80"/>
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush"  Color="#4ade80"/>
    <!-- Selection indicators do NOT all share one key: each control family has its own.
         Overriding SystemAccentColor / AccentFillColor* is not enough for these, so any
         new control that shows a selection pill must be added here or it renders in the
         OS accent (e.g. the ComboBox pill stayed orange until this key was added). -->
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush"            Color="#4ade80"/>
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor"   Color="#4ade80"/>
    <!-- Accent TEXT (HyperlinkButton, accent-coloured text) — lighter green for
         readable link text on the dark surfaces. -->
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"      Color="#86efac"/>
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush"    Color="#86efac"/>
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush"     Color="#4ade80"/>
    <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush"     Color="#514ade80"/>

    <!-- Badge backgrounds (a bassa opacità) -->
    <SolidColorBrush x:Key="STBadgeGreenBg"   Color="#264ade80"/>
    <SolidColorBrush x:Key="STBadgeGreenBdr"  Color="#4D4ade80"/>
    <SolidColorBrush x:Key="STBadgeGrayBg"    Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="STBadgeGrayBdr"   Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="STBadgeRedBg"     Color="#26ef4444"/>
    <SolidColorBrush x:Key="STBadgeRedBdr"    Color="#4Def4444"/>

    <!-- Active session banner -->
    <SolidColorBrush x:Key="STActiveSessionBg"  Color="#104ade80"/>
    <SolidColorBrush x:Key="STNicNoticeBg"       Color="#0F4ade80"/>

    <!-- ── TYPOGRAPHY ──────────────────────────────────────────────────────── -->

    <!-- Page title: DM Sans SemiBold 20px -->
    <Style x:Key="ST_PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="{StaticResource DMSansSemiBold}"/>
        <Setter Property="FontSize"          Value="20"/>
        <Setter Property="Foreground"        Value="{StaticResource STTextPrimary}"/>
        <Setter Property="CharacterSpacing"  Value="-20"/>
    </Style>

    <!-- Page subtitle: DM Sans 13px muted -->
    <Style x:Key="ST_PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{StaticResource DMSans}"/>
        <Setter Property="FontSize"    Value="13"/>
        <Setter Property="Foreground"  Value="{StaticResource STTextDim}"/>
    </Style>

    <!-- Card / section header label: DM Sans SemiBold 11px uppercase -->
    <Style x:Key="ST_SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="{StaticResource DMSansSemiBold}"/>
        <Setter Property="FontSize"          Value="11"/>
        <Setter Property="Foreground"        Value="{StaticResource STTextPrimary}"/>
        <Setter Property="CharacterSpacing"  Value="80"/>
    </Style>

    <!-- Row label: DM Sans Medium 14px -->
    <Style x:Key="ST_RowLabel" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{StaticResource DMSansMedium}"/>
        <Setter Property="FontSize"    Value="14"/>
        <Setter Property="Foreground"  Value="#e8e4e0"/>
    </Style>

    <!-- Row description: DM Sans 12px muted -->
    <Style x:Key="ST_RowDescription" TargetType="TextBlock">
        <Setter Property="FontFamily"    Value="{StaticResource DMSans}"/>
        <Setter Property="FontSize"      Value="12"/>
        <Setter Property="Foreground"    Value="{StaticResource STTextDim}"/>
        <Setter Property="TextWrapping"  Value="Wrap"/>
    </Style>

    <!-- Body text: DM Sans 13px secondary -->
    <Style x:Key="ST_Body" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{StaticResource DMSans}"/>
        <Setter Property="FontSize"     Value="13"/>
        <Setter Property="Foreground"   Value="{StaticResource STTextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Small body text: DM Sans 12px muted -->
    <Style x:Key="ST_BodySmall" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{StaticResource DMSans}"/>
        <Setter Property="FontSize"    Value="12"/>
        <Setter Property="Foreground"  Value="{StaticResource STTextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ── Value styles ──────────────────────────────────────────────────────
         8.0: these were JetBrains Mono. The app is now unified on a single
         typeface (DM Sans) everywhere except the Glossary, which keeps its
         deliberate terminal look via its own inline font. The x:Key names still
         say "Mono" — they are referenced from 9 files, so renaming them would be
         churn with no visual effect; treat the name as "value text", not a font.
         The JetBrainsMono/JetBrainsMonoMedium FontFamily resources above are
         deliberately kept so this is a one-line revert. -->

    <!-- Value: 13px -->
    <Style x:Key="ST_MonoValue" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{StaticResource DMSans}"/>
        <Setter Property="FontSize"    Value="13"/>
        <Setter Property="Foreground"  Value="{StaticResource STTextSecondary}"/>
    </Style>

    <!-- Value small: 12px -->
    <Style x:Key="ST_MonoValueSmall" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{StaticResource DMSans}"/>
        <Setter Property="FontSize"    Value="12"/>
        <Setter Property="Foreground"  Value="{StaticResource STTextSecondary}"/>
    </Style>

    <!-- Secondary value (max / peak / frame count): same font, dimmer grey -->
    <Style x:Key="ST_MonoValueDim" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{StaticResource DMSans}"/>
        <Setter Property="FontSize"    Value="12"/>
        <Setter Property="Foreground"  Value="{StaticResource STTextMuted}"/>
    </Style>

    <!-- Medium value: 18px — last session header -->
    <Style x:Key="ST_MonoMedium" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="{StaticResource DMSansMedium}"/>
        <Setter Property="FontSize"          Value="18"/>
        <Setter Property="Foreground"        Value="{StaticResource STTextPrimary}"/>
        <Setter Property="CharacterSpacing"  Value="-20"/>
    </Style>

    <!-- Badge text: 12px Medium -->
    <Style x:Key="ST_BadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{StaticResource DMSansMedium}"/>
        <Setter Property="FontSize"    Value="12"/>
    </Style>

    <!-- Footer ghost text: DM Sans 12px ghost -->
    <Style x:Key="ST_FooterText" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{StaticResource DMSans}"/>
        <Setter Property="FontSize"    Value="12"/>
        <Setter Property="Foreground"  Value="{StaticResource STTextDim}"/>
    </Style>

    <!-- ── CARD CONTAINERS ──────────────────────────────────────────────────── -->

    <!-- Card standard: 10px radius, 20px padding, semi-trasparente -->
    <Style x:Key="ST_Card" TargetType="Border">
        <Setter Property="Background"       Value="{StaticResource STCard}"/>
        <Setter Property="BorderBrush"      Value="{StaticResource STBorder}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="CornerRadius"     Value="10"/>
        <Setter Property="Padding"          Value="20"/>
    </Style>

    <!-- Card no-padding (per liste con item border-bottom) -->
    <Style x:Key="ST_CardNoPad" TargetType="Border">
        <Setter Property="Background"       Value="{StaticResource STCard}"/>
        <Setter Property="BorderBrush"      Value="{StaticResource STBorder}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="CornerRadius"     Value="10"/>
    </Style>

    <!-- Input container: sfondo #242220 -->
    <Style x:Key="ST_InputBorder" TargetType="Border">
        <Setter Property="Background"       Value="{StaticResource STInput}"/>
        <Setter Property="BorderBrush"      Value="{StaticResource STBorder}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="CornerRadius"     Value="8"/>
        <Setter Property="Padding"          Value="14,12"/>
    </Style>

    <!-- ── BUTTON STYLES ────────────────────────────────────────────────────── -->
    <!-- Each colored style includes a ControlTemplate so PointerOver/Pressed
         "lights up" in the button's own color instead of WinUI3's default grey.
         Secondary and Ghost keep native states (neutral appearance, no color).  -->

    <!-- Shared accent-color hover brushes used by ST_ButtonPrimary's template -->
    <SolidColorBrush x:Key="ST_AccentHoverBg"    Color="#86efac" Opacity="0.18"/>
    <SolidColorBrush x:Key="ST_AccentHoverFg"    Color="#86efac"/>
    <SolidColorBrush x:Key="ST_AccentHoverBdr"   Color="#86efac"/>
    <SolidColorBrush x:Key="ST_AccentPressedBg"  Color="#16a34a"  Opacity="0.12"/>
    <SolidColorBrush x:Key="ST_AccentPressedFg"  Color="#16a34a"/>
    <SolidColorBrush x:Key="ST_AccentPressedBdr" Color="#16a34a"/>

    <!-- Reusable minimal ControlTemplate setter shared across colored styles.
         Each style provides its own Template setter with per-color inline values. -->

    <!-- Primary: accent color outline — fill tinted, border e testo accent -->
    <Style x:Key="ST_ButtonPrimary" TargetType="Button">
        <Setter Property="FontFamily"       Value="{StaticResource DMSansMedium}"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="Padding"          Value="14,6"/>
        <Setter Property="CornerRadius"     Value="6"/>
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#4ade80" Opacity="0.12"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground"       Value="#4ade80"/>
        <Setter Property="BorderBrush"      Value="#4ade80"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      AutomationProperties.AccessibilityView="Raw">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ST_AccentHoverBg}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ST_AccentHoverBdr}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ST_AccentHoverFg}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ST_AccentPressedBg}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ST_AccentPressedBdr}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ST_AccentPressedFg}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary: sfondo bianco 7%, testo secondary -->
    <Style x:Key="ST_ButtonSecondary" TargetType="Button">
        <Setter Property="FontFamily"       Value="{StaticResource DMSansMedium}"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="Padding"          Value="14,6"/>
        <Setter Property="CornerRadius"     Value="6"/>
        <Setter Property="Background"       Value="#12FFFFFF"/>
        <Setter Property="Foreground"       Value="{StaticResource STTextSecondary}"/>
        <Setter Property="BorderBrush"      Value="#1AFFFFFF"/>
        <Setter Property="BorderThickness"  Value="1"/>
    </Style>

    <!-- Tile: card cliccabile con hover glow + nav arrow fade -->
    <Style x:Key="ST_TileButton" TargetType="Button">
        <Setter Property="Background"                 Value="{StaticResource STCard}"/>
        <Setter Property="BorderBrush"                Value="{StaticResource STBorder}"/>
        <Setter Property="BorderThickness"            Value="1"/>
        <Setter Property="CornerRadius"               Value="9"/>
        <Setter Property="Padding"                    Value="16,12"/>
        <Setter Property="HorizontalAlignment"        Value="Stretch"/>
        <Setter Property="VerticalAlignment"          Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment"   Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow"  Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="NavArrow"   Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow"  Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="NavArrow"   Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow"  Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0"/>
                                        <DoubleAnimation Storyboard.TargetName="NavArrow"   Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="TileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  AutomationProperties.AccessibilityView="Raw"/>
                                <FontIcon x:Name="NavArrow"
                                          Glyph="&#xE8A7;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{StaticResource STTextMuted}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Top"
                                          Opacity="0"/>
                            </Grid>
                        </Border>

                        <!-- White glow overlay — sits on top of TileBorder, same corner radius -->
                        <Border x:Name="HoverGlow"
                                Background="#0EFFFFFF"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost: trasparente, testo dim -->
    <Style x:Key="ST_ButtonGhost" TargetType="Button">
        <Setter Property="FontFamily"       Value="{StaticResource DMSansMedium}"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="Padding"          Value="14,6"/>
        <Setter Property="CornerRadius"     Value="6"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{StaticResource STTextMuted}"/>
        <Setter Property="BorderBrush"      Value="#14FFFFFF"/>
        <Setter Property="BorderThickness"  Value="1"/>
    </Style>

    <!-- Green: start streaming -->
    <Style x:Key="ST_ButtonGreen" TargetType="Button">
        <Setter Property="FontFamily"       Value="{StaticResource DMSansMedium}"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="Padding"          Value="14,6"/>
        <Setter Property="CornerRadius"     Value="6"/>
        <Setter Property="Background"       Value="#1F4ade80"/>
        <Setter Property="Foreground"       Value="#4ade80"/>
        <Setter Property="BorderBrush"      Value="#4D4ade80"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      AutomationProperties.AccessibilityView="Raw">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#2D4ade80"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#664ade80"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#86efac"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#124ade80"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#4D4ade80"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#4ade80"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger: stop / clear -->
    <Style x:Key="ST_ButtonDanger" TargetType="Button">
        <Setter Property="FontFamily"       Value="{StaticResource DMSansMedium}"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="Padding"          Value="14,6"/>
        <Setter Property="CornerRadius"     Value="6"/>
        <Setter Property="Background"       Value="#1Aef4444"/>
        <Setter Property="Foreground"       Value="#ef4444"/>
        <Setter Property="BorderBrush"      Value="#40ef4444"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      AutomationProperties.AccessibilityView="Raw">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#2Def4444"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#66ef4444"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#fca5a5"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#12ef4444"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#44ef4444"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#ef4444"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── TOGGLE SWITCH ─────────────────────────────────────────────────────
         Override dei resource WinUI3 usati internamente da ToggleSwitch.
         OnContent/OffContent vanno impostati a "" nel XAML.
         Fill/Stroke On → SystemAccentColor (WinUI3 usa Light2 di default).
         ToggleSwitchThemeMinWidth: WinUI3 riserva 154px (spazio On/Off label).
         Impostarlo a 0 fa sì che il controllo occupi solo la track (~40px),
         eliminando il "blue box" vuoto alla destra dell'interruttore.
    ────────────────────────────────────────────────────────────────────────── -->
    <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>

    <SolidColorBrush x:Key="ToggleSwitchFillOn"               Color="#4ade80"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver"    Color="#4ade80"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed"        Color="#16a34a"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn"             Color="#4ade80"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver"  Color="#4ade80"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed"      Color="#16a34a"/>

    <Style x:Key="ST_Toggle" TargetType="ToggleSwitch">
        <Setter Property="OnContent"        Value=""/>
        <Setter Property="OffContent"       Value=""/>
        <Setter Property="FontFamily"       Value="{StaticResource DMSans}"/>
        <Setter Property="MinWidth"         Value="0"/>
        <Setter Property="Margin"           Value="0"/>
        <Setter Property="Padding"          Value="0"/>
    </Style>

    <!-- ── CHECKBOX checked-state colours ──────────────────────────────────────
         WinUI3 default CheckBox uses SystemAccentColor when checked, which is
         pink/coral on systems where the user picked an accent in that range.
         Override the INDICATOR BOX colours (CheckBackgroundFill / Stroke / Glyph)
         only — NOT CheckBoxBackground, which is the whole control's background
         and would paint the entire row green. Palette matches ST_ButtonGreen.
    ────────────────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked"               Color="#4ade80"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver"    Color="#4ade80"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed"        Color="#16a34a"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled"       Color="#334ade80"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked"             Color="#4ade80"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver"  Color="#4ade80"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed"      Color="#16a34a"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled"     Color="#334ade80"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked"              Color="#111110"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver"   Color="#111110"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed"       Color="#111110"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled"      Color="#88111110"/>

    <!-- ── INFO BOX (callout accent-tinted) -->
    <Style x:Key="ST_InfoBox" TargetType="Border">
        <Setter Property="Background"       Value="#14C8562A"/>
        <Setter Property="BorderBrush"      Value="#33C8562A"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="CornerRadius"     Value="8"/>
        <Setter Property="Padding"          Value="14,10"/>
    </Style>

    <!-- ── SECTION SEPARATOR ─────────────────────────────────────────────────── -->
    <Style x:Key="ST_Separator" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource STBorderSubtle}"/>
        <Setter Property="Height"          Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- ── GLOBAL CONVERTERS ─────────────────────────────────────────── -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    <converters:HexToSolidColorBrushConverter x:Key="HexToSolidColorBrushConverter"/>
    <converters:BoolToInfoBarSeverityConverter x:Key="BoolToInfoBarSeverityConverter"/>
    <converters:CoverPathToBitmapConverter x:Key="CoverPathToBitmapConverter"/>

</ResourceDictionary>
