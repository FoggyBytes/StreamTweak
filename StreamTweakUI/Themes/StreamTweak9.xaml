<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:StreamTweak.Converters">

    <!-- ═══════════════════════════════════════════════════════════════════════
         STREAMTWEAK 9.0 — design system layer
         Merged after StreamTweakStyles.xaml and StreamTweak8.xaml: every older key
         keeps working, the 9.0 pages use the ST9 keys below.
         Cards are the near-black of 8.x (STCard / STBorder) straight over Mica, with no
         lighter sheet between the sidebar and the page; labels are sentence
         case, numbers are DM Sans SemiBold with a smaller unit next to them, and the
         mint accent is the only colour that is not a state. Green / amber / red mean
         Excellent / Good / Poor (or on / attention / off) and are always paired with
         a word, never used alone.
    ════════════════════════════════════════════════════════════════════════ -->

    <!-- ── COLOUR TOKENS ─────────────────────────────────────────────────── -->
    <!-- Cards as in 8.7 (STCard, STBorder): the translucent white of the first 9.0 cut read
         light grey next to the host pages and the sidebar. -->
    <SolidColorBrush x:Key="ST9Card"        Color="#E60C0C0E"/>
    <SolidColorBrush x:Key="ST9CardHover"   Color="#E6141416"/>
    <SolidColorBrush x:Key="ST9CardStroke"  Color="#2a2724"/>
    <SolidColorBrush x:Key="ST9Inset"       Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="ST9Pane"        Color="#FF0C0C0E"/>  <!-- the card black, opaque: side panels over a page -->
    <SolidColorBrush x:Key="ST9Stroke"      Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ST9Stroke2"     Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="ST9Text"        Color="#F2F5F3"/>
    <SolidColorBrush x:Key="ST9Text2"       Color="#C8CFCB"/>
    <SolidColorBrush x:Key="ST9Text3"       Color="#929A96"/>
    <SolidColorBrush x:Key="ST9Text4"       Color="#646B67"/>
    <SolidColorBrush x:Key="ST9Mint"        Color="#4ade80"/>
    <SolidColorBrush x:Key="ST9Mint2"       Color="#86efac"/>
    <SolidColorBrush x:Key="ST9MintInk"     Color="#052e16"/>
    <SolidColorBrush x:Key="ST9MintSoft"    Color="#214ade80"/>
    <SolidColorBrush x:Key="ST9MintStroke"  Color="#594ade80"/>
    <SolidColorBrush x:Key="ST9Amber"       Color="#fbbf24"/>
    <SolidColorBrush x:Key="ST9AmberSoft"   Color="#21fbbf24"/>
    <SolidColorBrush x:Key="ST9AmberStroke" Color="#59fbbf24"/>
    <SolidColorBrush x:Key="ST9Red"         Color="#fca5a5"/>
    <SolidColorBrush x:Key="ST9RedSoft"     Color="#21f87171"/>
    <SolidColorBrush x:Key="ST9RedStroke"   Color="#59f87171"/>
    <SolidColorBrush x:Key="ST9Blue"        Color="#38bdf8"/>
    <SolidColorBrush x:Key="ST9BlueSoft"    Color="#1F38bdf8"/>
    <SolidColorBrush x:Key="ST9BlueStroke"  Color="#5938bdf8"/>
    <SolidColorBrush x:Key="ST9GreySoft"    Color="#0FFFFFFF"/>
    <!-- Chart series, validated for colour-blind separation on the dark surface -->
    <SolidColorBrush x:Key="ST9Series1"     Color="#3987e5"/>
    <SolidColorBrush x:Key="ST9Series2"     Color="#d95926"/>
    <SolidColorBrush x:Key="ST9Series3"     Color="#199e70"/>

    <!-- ── TYPE ──────────────────────────────────────────────────────────── -->
    <Style x:Key="ST9_PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily"       Value="{StaticResource DMSansSemiBold}"/>
        <Setter Property="FontSize"         Value="28"/>
        <Setter Property="CharacterSpacing" Value="-20"/>
        <Setter Property="Foreground"       Value="{StaticResource ST9Text}"/>
        <Setter Property="TextWrapping"     Value="Wrap"/>
    </Style>
    <Style x:Key="ST9_PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{StaticResource DMSans}"/>
        <Setter Property="FontSize"     Value="13.5"/>
        <Setter Property="Foreground"   Value="{StaticResource ST9Text3}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth"     Value="780"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="ST9_SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DMSansSemiBold}"/>
        <Setter Property="FontSize"   Value="17"/>
        <Setter Property="Foreground" Value="{StaticResource ST9Text}"/>
    </Style>
    <Style x:Key="ST9_CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{StaticResource DMSansSemiBold}"/>
        <Setter Property="FontSize"     Value="15.5"/>
        <Setter Property="Foreground"   Value="{StaticResource ST9Text}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="ST9_Hint" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{StaticResource DMSans}"/>
        <Setter Property="FontSize"     Value="12.5"/>
        <Setter Property="Foreground"   Value="{StaticResource ST9Text3}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="ST9_Small" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{StaticResource DMSans}"/>
        <Setter Property="FontSize"     Value="12.5"/>
        <Setter Property="Foreground"   Value="{StaticResource ST9Text3}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ST9_Label" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{StaticResource DMSansMedium}"/>
        <Setter Property="FontSize"     Value="12.5"/>
        <Setter Property="Foreground"   Value="{StaticResource ST9Text3}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="ST9_Body" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{StaticResource DMSans}"/>
        <Setter Property="FontSize"     Value="13.5"/>
        <Setter Property="Foreground"   Value="{StaticResource ST9Text2}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ST9_RowTitle" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{StaticResource DMSansMedium}"/>
        <Setter Property="FontSize"     Value="13.5"/>
        <Setter Property="Foreground"   Value="{StaticResource ST9Text}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="ST9_Value" TargetType="TextBlock">
        <Setter Property="FontFamily"       Value="{StaticResource DMSansSemiBold}"/>
        <Setter Property="FontSize"         Value="24"/>
        <Setter Property="CharacterSpacing" Value="-20"/>
        <Setter Property="Foreground"       Value="{StaticResource ST9Text}"/>
    </Style>
    <Style x:Key="ST9_ValueL" TargetType="TextBlock" BasedOn="{StaticResource ST9_Value}">
        <Setter Property="FontSize" Value="34"/>
    </Style>
    <Style x:Key="ST9_ValueS" TargetType="TextBlock" BasedOn="{StaticResource ST9_Value}">
        <Setter Property="FontSize" Value="19"/>
    </Style>
    <Style x:Key="ST9_Unit" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="{StaticResource DMSansMedium}"/>
        <Setter Property="FontSize"          Value="12.5"/>
        <Setter Property="Foreground"        Value="{StaticResource ST9Text3}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin"            Value="3,0,0,3"/>
    </Style>
    <Style x:Key="ST9_Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily"       Value="{StaticResource DMSansSemiBold}"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="CharacterSpacing" Value="90"/>
        <Setter Property="Foreground"       Value="{StaticResource ST9Mint2}"/>
    </Style>
    <Style x:Key="ST9_Mono" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontSize"     Value="12.5"/>
        <Setter Property="Foreground"   Value="{StaticResource ST9Text2}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ── SURFACES ──────────────────────────────────────────────────────── -->
    <Style x:Key="ST9_Card" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource ST9Card}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource ST9CardStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="10"/>
        <Setter Property="Padding"         Value="20,18"/>
    </Style>
    <Style x:Key="ST9_CardFlat" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource ST9Card}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource ST9CardStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="10"/>
    </Style>
    <Style x:Key="ST9_Hero" TargetType="Border">
        <Setter Property="Background"      Value="#FF0E0F0F"/>
        <Setter Property="BorderBrush"     Value="{StaticResource ST9CardStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="14"/>
    </Style>
    <Style x:Key="ST9_Inset" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource ST9Inset}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource ST9Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="10"/>
        <Setter Property="Padding"         Value="12,10"/>
    </Style>
    <Style x:Key="ST9_IconBubble" TargetType="Border">
        <Setter Property="Width"           Value="34"/>
        <Setter Property="Height"          Value="34"/>
        <Setter Property="CornerRadius"    Value="9"/>
        <Setter Property="Background"      Value="{StaticResource ST9GreySoft}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ST9_Divider" TargetType="Border">
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Background" Value="{StaticResource ST9Stroke}"/>
        <Setter Property="Margin"     Value="0,14"/>
    </Style>
    <!-- One settings row: title + hint on the left, the control on the right. -->
    <Style x:Key="ST9_SetRow" TargetType="Border">
        <Setter Property="BorderBrush"     Value="{StaticResource ST9Stroke}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding"         Value="0,13"/>
    </Style>
    <Style x:Key="ST9_SetRowLast" TargetType="Border" BasedOn="{StaticResource ST9_SetRow}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="0,13,0,2"/>
    </Style>

    <!-- ── TAGS (state pills: always a word, never colour alone) ─────────── -->
    <Style x:Key="ST9_TagGreen" TargetType="Border">
        <Setter Property="CornerRadius"    Value="4"/>
        <Setter Property="Padding"         Value="7,2,7,3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background"      Value="{StaticResource ST9MintSoft}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource ST9MintStroke}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="ST9_TagAmber" TargetType="Border" BasedOn="{StaticResource ST9_TagGreen}">
        <Setter Property="Background"  Value="{StaticResource ST9AmberSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ST9AmberStroke}"/>
    </Style>
    <Style x:Key="ST9_TagRed" TargetType="Border" BasedOn="{StaticResource ST9_TagGreen}">
        <Setter Property="Background"  Value="{StaticResource ST9RedSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ST9RedStroke}"/>
    </Style>
    <Style x:Key="ST9_TagBlue" TargetType="Border" BasedOn="{StaticResource ST9_TagGreen}">
        <Setter Property="Background"  Value="{StaticResource ST9BlueSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ST9BlueStroke}"/>
    </Style>
    <Style x:Key="ST9_TagGrey" TargetType="Border" BasedOn="{StaticResource ST9_TagGreen}">
        <Setter Property="Background"  Value="{StaticResource ST9GreySoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ST9Stroke2}"/>
    </Style>
    <Style x:Key="ST9_TagText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DMSansSemiBold}"/>
        <Setter Property="FontSize"   Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource ST9Text2}"/>
    </Style>
    <Style x:Key="ST9_TagTextGreen" TargetType="TextBlock" BasedOn="{StaticResource ST9_TagText}">
        <Setter Property="Foreground" Value="{StaticResource ST9Mint}"/>
    </Style>
    <Style x:Key="ST9_TagTextAmber" TargetType="TextBlock" BasedOn="{StaticResource ST9_TagText}">
        <Setter Property="Foreground" Value="{StaticResource ST9Amber}"/>
    </Style>
    <Style x:Key="ST9_TagTextRed" TargetType="TextBlock" BasedOn="{StaticResource ST9_TagText}">
        <Setter Property="Foreground" Value="{StaticResource ST9Red}"/>
    </Style>
    <Style x:Key="ST9_TagTextBlue" TargetType="TextBlock" BasedOn="{StaticResource ST9_TagText}">
        <Setter Property="Foreground" Value="{StaticResource ST9Blue}"/>
    </Style>

    <!-- ── BUTTONS ───────────────────────────────────────────────────────────
         Each style carries its own template so hover/pressed stay in the button's own
         palette instead of WinUI's grey theme resources. -->

    <!-- Primary: filled mint, dark text — one per view, for the main action. -->
    <Style x:Key="ST9_ButtonPrimary" TargetType="Button">
        <Setter Property="FontFamily"      Value="{StaticResource DMSansSemiBold}"/>
        <Setter Property="FontSize"        Value="13.5"/>
        <Setter Property="Padding"         Value="14,6"/>
        <Setter Property="MinHeight"       Value="32"/>
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Background"      Value="#4ade80"/>
        <Setter Property="Foreground"      Value="#052e16"/>
        <Setter Property="BorderBrush"     Value="#4ade80"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- OuterBorderEdge: the fill runs under the border. Inset inside it (the
                         default), the anti-aliased seam between the two showed as a grey ring of
                         pixels on the rounded corners of the solid green. -->
                    <ContentPresenter x:Name="ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BackgroundSizing="OuterBorderEdge"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      AutomationProperties.AccessibilityView="Raw">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#6ee7a0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#6ee7a0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#22c55e"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#22c55e"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Subtle: 6 % white, for secondary actions. -->
    <Style x:Key="ST9_ButtonSubtle" TargetType="Button">
        <Setter Property="FontFamily"      Value="{StaticResource DMSansMedium}"/>
        <Setter Property="FontSize"        Value="13.5"/>
        <Setter Property="Padding"         Value="14,6"/>
        <Setter Property="MinHeight"       Value="32"/>
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Background"      Value="#0FFFFFFF"/>
        <Setter Property="Foreground"      Value="{StaticResource ST9Text}"/>
        <Setter Property="BorderBrush"     Value="#24FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      AutomationProperties.AccessibilityView="Raw">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#1AFFFFFF"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#0AFFFFFF"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost: no fill, no border; for toolbar actions and icon buttons. -->
    <Style x:Key="ST9_ButtonGhost" TargetType="Button" BasedOn="{StaticResource ST9_ButtonSubtle}">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground"  Value="{StaticResource ST9Text2}"/>
    </Style>

    <!-- Icon-only ghost button, 32×32. -->
    <Style x:Key="ST9_IconButton" TargetType="Button" BasedOn="{StaticResource ST9_ButtonGhost}">
        <Setter Property="Width"     Value="32"/>
        <Setter Property="Height"    Value="32"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding"   Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}"/>
        <Setter Property="FontSize"  Value="14"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
    </Style>

    <!-- Danger outline: destructive actions. -->
    <Style x:Key="ST9_ButtonDanger" TargetType="Button" BasedOn="{StaticResource ST9_ButtonSubtle}">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#73f87171"/>
        <Setter Property="Foreground"  Value="#fca5a5"/>
    </Style>

    <!-- Clickable tile (Dashboard host-setup tiles, list rows that open something). -->
    <Style x:Key="ST9_Tile" TargetType="Button">
        <Setter Property="Background"                 Value="{StaticResource ST9Inset}"/>
        <Setter Property="BorderBrush"                Value="{StaticResource ST9Stroke}"/>
        <Setter Property="BorderThickness"            Value="1"/>
        <Setter Property="CornerRadius"               Value="9"/>
        <Setter Property="Padding"                    Value="12,10"/>
        <Setter Property="HorizontalAlignment"        Value="Stretch"/>
        <Setter Property="VerticalAlignment"          Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      AutomationProperties.AccessibilityView="Raw">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#12FFFFFF"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#2EFFFFFF"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#08FFFFFF"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter chip: a pill ToggleButton; checked = selected. -->
    <Style x:Key="ST9_Chip" TargetType="ToggleButton">
        <Setter Property="FontFamily"      Value="{StaticResource DMSans}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Padding"         Value="12,4,12,5"/>
        <Setter Property="MinHeight"       Value="30"/>
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Background"      Value="#08FFFFFF"/>
        <Setter Property="Foreground"      Value="{StaticResource ST9Text2}"/>
        <Setter Property="BorderBrush"     Value="#24FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <ContentPresenter x:Name="ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      AutomationProperties.AccessibilityView="Raw">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="#12FFFFFF"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="#06FFFFFF"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background"  Value="#1FFFFFFF"/>
                                        <Setter Target="ContentPresenter.BorderBrush" Value="#47FFFFFF"/>
                                        <Setter Target="ContentPresenter.Foreground"  Value="#F2F5F3"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background"  Value="#29FFFFFF"/>
                                        <Setter Target="ContentPresenter.BorderBrush" Value="#47FFFFFF"/>
                                        <Setter Target="ContentPresenter.Foreground"  Value="#F2F5F3"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background"  Value="#14FFFFFF"/>
                                        <Setter Target="ContentPresenter.BorderBrush" Value="#47FFFFFF"/>
                                        <Setter Target="ContentPresenter.Foreground"  Value="#F2F5F3"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List rows without the Fluent item chrome: the row draws its own. -->
    <Style x:Key="ST9_PlainListItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding"   Value="0"/>
        <Setter Property="Margin"    Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <!-- Game cover tile in the Library grid -->
    <Style x:Key="ST9_CoverItem" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin"  Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment"   Value="Stretch"/>
    </Style>

    <!-- Search box look -->
    <Style x:Key="ST9_SearchBox" TargetType="TextBox">
        <Setter Property="FontFamily"   Value="{StaticResource DMSans}"/>
        <Setter Property="FontSize"     Value="13.5"/>
        <Setter Property="MinHeight"    Value="32"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- Cover loaders: the hero / sheet cover and the Library tiles. The backdrop behind a
         hero is Controls/CoverGradient, not a cover. -->
    <converters:CoverPathToBitmapConverter x:Key="CoverPathToBitmapLargeConverter" DecodeWidth="360"/>
    <converters:CoverPathToBitmapConverter x:Key="CoverPathToBitmapTileConverter" DecodeWidth="320"/>

</ResourceDictionary>
