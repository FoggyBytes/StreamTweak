<Window
    x:Class="StreamTweak.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StreamTweak"
    Title="StreamTweak">

    <!-- Mica: blends desktop wallpaper into the dark surfaces semi-trasparenti. -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>  <!-- custom title bar strip -->
            <RowDefinition Height="*"/>   <!-- sidebar + content -->
        </Grid.RowDefinitions>

        <!-- ── ROW 1: NavigationView ─────────────────────────────────────── -->
        <NavigationView x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            CompactPaneLength="52"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            AlwaysShowHeader="False"
            IsTitleBarAutoPaddingEnabled="False"
            FontFamily="{StaticResource DMSans}"
            SelectionChanged="NavView_SelectionChanged">

            <!-- ── MAIN NAV ITEMS ─────────────────────────────────────────── -->
            <NavigationView.MenuItems>

                <NavigationViewItem x:Name="NavHome" Tag="Home" Content="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Network" Content="Network">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE701;" FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Display" Content="Display">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Audio" Content="Audio">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE767;" FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Apps" Content="Apps"
                                   Margin="0,24,0,0">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="GameLibrary" Content="Game Library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Store" Content="Store">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BF;" FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Logs" Content="Logs"
                                   Margin="0,24,0,0">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F9;" FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <!-- ── FOOTER NAV ITEMS (Glossary + Settings) ────────────────── -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="Glossary" Content="Glossary">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE82D;" FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Settings" Content="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Content frame — Transparent so Mica bleeds through the page bg -->
            <Frame x:Name="ContentFrame" Background="Transparent"/>

        </NavigationView>

        <!-- ── BOTTOM-RIGHT OVERLAY: version + update indicator ───────────────
             Anchored at the bottom-right of the content area (Row 1 spans the
             sidebar + content; HorizontalAlignment=Right keeps the badge over
             the content frame, not the pane). MainWindow.xaml.cs subscribes to
             AppStateService.UpdateAvailabilityChanged and toggles the update
             link visibility / text when GitHub reports a newer release. -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,20,14"
                    Spacing="2"
                    IsHitTestVisible="True">
            <TextBlock x:Name="SidebarVersionText"
                       Style="{StaticResource ST_FooterText}"
                       HorizontalAlignment="Right"/>
            <HyperlinkButton x:Name="SidebarUpdateLink"
                             Visibility="Collapsed"
                             Padding="0"
                             FontFamily="{StaticResource DMSans}"
                             FontSize="11"
                             Foreground="{StaticResource STWarning}"
                             HorizontalAlignment="Right"
                             Click="SidebarUpdateLink_Click"
                             ToolTipService.ToolTip="Open the GitHub releases page"/>
        </StackPanel>

        <!-- ── ROW 0: custom title bar ───────────────────────────────────── -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Background="{StaticResource STTitlebar}">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="8" Margin="16,0,0,0"
                        IsHitTestVisible="False">
                <Image Source="ms-appx:///Resources/streamtweak.ico"
                       Width="14" Height="14"
                       VerticalAlignment="Center"/>
                <TextBlock Text="StreamTweak"
                           FontFamily="{StaticResource DMSans}"
                           FontSize="12"
                           Foreground="{StaticResource STTextPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>

</Window>
