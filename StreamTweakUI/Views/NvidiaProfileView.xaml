<Page
    x:Class="StreamTweak.Views.NvidiaProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StreamTweak.ViewModels"
    Background="{StaticResource STBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- fixed page header -->
            <RowDefinition Height="*"/>      <!-- scrollable content -->
        </Grid.RowDefinitions>

        <!-- Fixed page title + GPU/driver subtitle (does not scroll — Game Library pattern) -->
        <StackPanel Grid.Row="0" Spacing="3" Margin="28,24,28,12">
            <TextBlock Text="NVIDIA Sentinel" Style="{StaticResource ST_PageTitle}"/>
            <TextBlock Text="{x:Bind ViewModel.GpuHeader, Mode=OneWay}"
                       Style="{StaticResource ST_PageSubtitle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="28,0,28,28">

            <!-- ── User profile card ─────────────────────────────────────────── -->
            <Border Style="{StaticResource ST_Card}">
                <StackPanel Spacing="12">

                    <TextBlock Text="USER PROFILE" Style="{StaticResource ST_SectionLabel}"/>

                    <TextBlock Style="{StaticResource ST_RowDescription}"
                               TextWrapping="Wrap"
                               Text="Capture a snapshot of your NVIDIA global driver profile. StreamTweak stores every setting you changed from the driver default and can re-apply it whenever NVIDIA App resets the profile."/>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save current as my profile"
                                Style="{StaticResource ST_ButtonGreen}"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                Click="SaveProfile_Click"/>
                        <Button Content="Restore my profile"
                                Style="{StaticResource ST_ButtonSecondary}"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                Click="RestoreProfile_Click"/>
                        <Button Content="Clear my profile"
                                Style="{StaticResource ST_ButtonDanger}"
                                IsEnabled="{x:Bind ViewModel.HasSnapshot, Mode=OneWay}"
                                Click="ClearProfile_Click"/>
                    </StackPanel>

                    <!-- Saved-state footer -->
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                      Width="16" Height="16"
                                      Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay,
                                                   Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{x:Bind ViewModel.ProfileSavedText, Mode=OneWay}"
                                   Style="{StaticResource ST_RowDescription}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.CapturedCountText, Mode=OneWay}"
                                   Style="{StaticResource ST_RowDescription}"
                                   VerticalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.HasSnapshot, Mode=OneWay,
                                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Status line — Informational severity, but the icon accent is tinted to
                         the same green as the Auto-restore ON toggle (#22c55e). -->
                    <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay,
                                          Converter={StaticResource BoolToVisibilityConverter}}"
                             Severity="Informational"
                             Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                             IsClosable="False">
                        <InfoBar.Resources>
                            <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#22c55e"/>
                        </InfoBar.Resources>
                    </InfoBar>

                </StackPanel>
            </Border>

            <!-- ── Auto-restore card ─────────────────────────────────────────── -->
            <Border Style="{StaticResource ST_Card}">
                <StackPanel Spacing="12">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                    VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="AUTO-RESTORE"
                                       Style="{StaticResource ST_SectionLabel}"
                                       VerticalAlignment="Center"/>
                            <Border CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                    Background="{x:Bind ViewModel.ArmedBadgeBgHex, Mode=OneWay,
                                                 Converter={StaticResource HexToSolidColorBrushConverter}}">
                                <TextBlock Text="{x:Bind ViewModel.ArmedBadgeText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{x:Bind ViewModel.ArmedBadgeFgHex, Mode=OneWay,
                                                        Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                            </Border>
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      Style="{StaticResource ST_Toggle}"
                                      IsOn="{x:Bind ViewModel.AutoRestoreEnabled, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Style="{StaticResource ST_RowDescription}"
                               TextWrapping="Wrap"
                               Text="When armed, StreamTweak watches the NVIDIA driver settings database and silently re-applies your saved profile whenever NVIDIA App resets it."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Last auto-restore:"
                                       Style="{StaticResource ST_RowDescription}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.LastRestoreText, Mode=OneWay}"
                                       Style="{StaticResource ST_MonoValueSmall}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Open log file"
                                Style="{StaticResource ST_ButtonSecondary}"
                                Click="OpenLog_Click"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ── Captured settings (collapsible, Glossary-style terminal panel) ── -->
            <Expander HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      IsExpanded="{x:Bind ViewModel.CapturedExpanded, Mode=TwoWay}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CAPTURED SETTINGS"
                                   Style="{StaticResource ST_SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.ReadableCountText, Mode=OneWay}"
                                   Style="{StaticResource ST_RowDescription}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                    </Grid>
                </Expander.Header>

                <!-- Terminal-style content panel (matches Glossary) -->
                <Border Background="#0A0908"
                        BorderBrush="{StaticResource STBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,4,0,0">
                    <StackPanel Padding="20,14,24,16" Spacing="0">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Cascadia Code, Cascadia Mono, Consolas, Courier New"/>
                            </Style>
                        </StackPanel.Resources>

                        <TextBlock Text="// GLOBAL DRIVER PROFILE"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource STSuccess}"
                                   Margin="0,0,0,3"/>
                        <Rectangle Height="0.5"
                                   Fill="{StaticResource STBorderActive}"
                                   Margin="0,0,0,10"/>

                        <!-- Empty / no-readable hint -->
                        <TextBlock Text="No human-readable settings captured. Click “Save current as my profile” to take a snapshot."
                                   FontSize="12"
                                   Foreground="{StaticResource STTextMuted}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.HasReadableSettings, Mode=OneWay,
                                                Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.CapturedSettings}"
                                      Visibility="{x:Bind ViewModel.HasReadableSettings, Mode=OneWay,
                                                   Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CapturedSettingVM">
                                    <!-- single line: name + hex id (both white, left) · value label (green, right) -->
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                    Spacing="12" VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <TextBlock Text="{x:Bind DisplayName}"
                                                       FontSize="12.5"
                                                       Foreground="{StaticResource STTextPrimary}"
                                                       TextWrapping="NoWrap"/>
                                            <TextBlock Text="{x:Bind HexId}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource STTextMuted}"
                                                       TextWrapping="NoWrap"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ValueLabel}"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource STSuccess}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>
            </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</Page>
