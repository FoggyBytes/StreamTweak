<UserControl
    x:Class="StreamTweak.Views.GlossaryRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="RootBorder" Margin="0,0,0,4" Padding="6,4" CornerRadius="6" Background="Transparent">
        <!-- 9.0: term and definition side by side when there is room, stacked in the
             narrow Glossary side panel (see GlossaryRow.OnSizeChanged). -->
        <Grid x:Name="RowGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TermColumn" Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="TermText"
                       FontSize="13" FontWeight="Bold"
                       FontFamily="Cascadia Code, Cascadia Mono, Consolas, Courier New"
                       Foreground="#4ade80"
                       TextWrapping="Wrap"/>

            <TextBlock Grid.Column="1"
                       x:Name="DefinitionText"
                       FontSize="13"
                       FontFamily="Cascadia Code, Cascadia Mono, Consolas, Courier New"
                       Foreground="#c0bcb8"
                       TextWrapping="Wrap"
                       Margin="12,0,0,0"/>
        </Grid>
    </Border>

</UserControl>
