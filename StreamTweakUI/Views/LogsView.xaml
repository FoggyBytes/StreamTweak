<Page
    x:Class="StreamTweak.Views.LogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:StreamTweak.Controls"
    xmlns:vm="using:StreamTweak.ViewModels"
    Background="{StaticResource STBackground}">

    <!--
        Three solid layers stacked in the root Grid.
        Layer 1 — Session list (always rendered)
        Layer 2 — Session detail (covers layer 1 when visible)
        Layer 3 — Fullscreen chart (covers layers 1+2 when visible)
    -->
    <Grid>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- LAYER 1 — Session list                                            -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- page header -->
                <RowDefinition Height="*"/>      <!-- card -->
            </Grid.RowDefinitions>

            <!-- Page header -->
            <Grid Grid.Row="0" Margin="28,24,28,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Session History"
                           Style="{StaticResource ST_PageTitle}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Clear history"
                        Style="{StaticResource ST_ButtonDanger}"
                        VerticalAlignment="Center"
                        Click="ClearHistory_Click"/>
            </Grid>

            <!-- Main card -->
            <Border Grid.Row="1"
                    Margin="28,0,28,28"
                    Style="{StaticResource ST_CardNoPad}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- column headers -->
                        <RowDefinition Height="*"/>      <!-- list or empty state -->
                    </Grid.RowDefinitions>

                    <!-- Column header bar -->
                    <Grid Grid.Row="0"
                          Padding="20,0"
                          MinHeight="36"
                          Background="{StaticResource STInput}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>    <!-- accent bar -->
                            <ColumnDefinition Width="16"/>   <!-- gap -->
                            <ColumnDefinition Width="2.5*"/> <!-- date/time -->
                            <ColumnDefinition Width="1*"/>   <!-- duration -->
                            <ColumnDefinition Width="1*"/>   <!-- rtt avg -->
                            <ColumnDefinition Width="1*"/>   <!-- drops % -->
                            <ColumnDefinition Width="1.5*"/> <!-- quality -->
                            <ColumnDefinition Width="2*"/>   <!-- games covers -->
                            <ColumnDefinition Width="68"/>   <!-- actions -->
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="Date / Time"
                                   Style="{StaticResource ST_SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Duration"
                                   Style="{StaticResource ST_SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="RTT avg"
                                   Style="{StaticResource ST_SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="Drops %"
                                   Style="{StaticResource ST_SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="Quality"
                                   Style="{StaticResource ST_SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="Games"
                                   Style="{StaticResource ST_SectionLabel}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Separator under column headers -->
                    <Border Grid.Row="0"
                            Style="{StaticResource ST_Separator}"
                            VerticalAlignment="Bottom"/>

                    <!-- Session list -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Sessions}"
                              SelectionMode="None"
                              Padding="0"
                              Visibility="{x:Bind ViewModel.HasSessions, Mode=OneWay,
                                           Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"
                                   BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="StreamTweak:SessionEntry"
                                          xmlns:StreamTweak="using:StreamTweak">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                    </Grid.RowDefinitions>

                                    <!-- Bottom separator -->
                                    <Border Grid.Row="1"
                                            Style="{StaticResource ST_Separator}"/>

                                    <!-- Row content -->
                                    <Grid Grid.Row="0" Padding="20,0" MinHeight="56">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="68"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left accent bar (grade color) -->
                                        <Rectangle Grid.Column="0"
                                                   Width="3"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Stretch"
                                                   RadiusX="1.5" RadiusY="1.5"
                                                   Margin="0,10"
                                                   Fill="{x:Bind GradeColorHex,
                                                          Converter={StaticResource HexToSolidColorBrushConverter}}"/>

                                        <!-- Date / Time -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind StartTimeDisplay}"
                                                   Style="{StaticResource ST_Body}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind DurationDisplay}"
                                                   Style="{StaticResource ST_MonoValueSmall}"
                                                   VerticalAlignment="Center"/>

                                        <!-- RTT avg -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{x:Bind RttAvgDisplay}"
                                                   Style="{StaticResource ST_MonoValueSmall}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Drops % -->
                                        <TextBlock Grid.Column="5"
                                                   Text="{x:Bind DropRateDisplay}"
                                                   Style="{StaticResource ST_MonoValueSmall}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Quality pill -->
                                        <Border Grid.Column="6"
                                                CornerRadius="10"
                                                BorderThickness="1"
                                                Padding="10,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                BorderBrush="{x:Bind GradeColorHex,
                                                              Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                Visibility="{x:Bind HasGrade,
                                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="7" Height="7"
                                                         VerticalAlignment="Center"
                                                         Fill="{x:Bind GradeColorHex,
                                                                Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                                <TextBlock Text="{x:Bind GradeShortLabel}"
                                                           Style="{StaticResource ST_BadgeText}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Games covers strip -->
                                        <ItemsControl Grid.Column="7"
                                                      ItemsSource="{x:Bind GamesDetected}"
                                                      VerticalAlignment="Center"
                                                      Visibility="{x:Bind HasGamesDetected,
                                                                   Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="3"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="33" Height="50"
                                                            CornerRadius="4"
                                                            Background="{StaticResource STBackground}"
                                                            ToolTipService.ToolTip="{Binding}">
                                                        <Image Source="{Binding Converter={StaticResource GameNameToCoverConverter}}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- No games fallback -->
                                        <TextBlock Grid.Column="7"
                                                   Text="No games detected"
                                                   Style="{StaticResource ST_RowDescription}"
                                                   FontStyle="Italic"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind HasNoGamesDetected,
                                                                Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="8"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="4">

                                            <Button Style="{StaticResource ST_ButtonGhost}"
                                                    Width="30" Height="30" Padding="0"
                                                    FontSize="14"
                                                    Content="&#xE9F9;"
                                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                    Click="DetailButton_Click"
                                                    Visibility="{x:Bind HasGrade,
                                                                 Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTipService.ToolTip="View session detail"/>

                                            <Button Style="{StaticResource ST_ButtonGhost}"
                                                    Width="30" Height="30" Padding="0"
                                                    FontSize="13"
                                                    Content="&#xE74D;"
                                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                    Click="DeleteSession_Click"
                                                    ToolTipService.ToolTip="Delete this session"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="{x:Bind ViewModel.HasSessions, Mode=OneWay,
                                             Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE9F9;"
                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  FontSize="36"
                                  Foreground="{StaticResource STTextDim}"/>
                        <TextBlock Text="No sessions recorded yet"
                                   Style="{StaticResource ST_RowDescription}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>


        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- LAYER 2 — Session detail                                          -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{x:Bind ViewModel.IsDetailVisible, Mode=OneWay,
                            Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#E6111010">

            <Border Margin="28,16,28,28"
                    Style="{StaticResource ST_CardNoPad}">

                <Grid Margin="20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- header -->
                        <RowDefinition Height="Auto"/>   <!-- separator -->
                        <RowDefinition Height="Auto"/>   <!-- stats panels -->
                        <RowDefinition Height="Auto"/>   <!-- separator -->
                        <RowDefinition Height="Auto"/>   <!-- "Client Charts" label -->
                        <RowDefinition Height="*"/>      <!-- charts 2×2 -->
                        <RowDefinition Height="Auto"/>   <!-- games section -->
                        <RowDefinition Height="Auto"/>   <!-- grade bar -->
                    </Grid.RowDefinitions>

                    <!-- ── Row 0: Header ──────────────────────────────────── -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Session Detail"
                                       Style="{StaticResource ST_PageTitle}"/>
                            <TextBlock Text="{x:Bind ViewModel.DetailHeaderSubtitle, Mode=OneWay}"
                                       Style="{StaticResource ST_PageSubtitle}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource ST_ButtonGhost}"
                                Content="&#xE711;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14" Width="32" Height="32" Padding="0"
                                VerticalAlignment="Top"
                                Click="CloseDetail_Click"
                                ToolTipService.ToolTip="Close (Esc)"/>
                    </Grid>

                    <!-- ── Separator ─────────────────────────────────────── -->
                    <Border Grid.Row="1"
                            Style="{StaticResource ST_Separator}"
                            Margin="0,0,0,14"/>

                    <!-- ── Row 2: Stats panels (CLIENT | HOST) ────────────── -->
                    <Grid Grid.Row="2" ColumnSpacing="12" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CLIENT box -->
                        <Border Grid.Column="0"
                                Background="{StaticResource STInput}"
                                BorderBrush="{StaticResource STBorder}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="16,14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="CLIENT  (StreamLight)"
                                           Style="{StaticResource ST_SectionLabel}"/>

                                <Grid ColumnSpacing="10" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/> <!-- Jitter -->
                                        <RowDefinition/> <!-- Drops -->
                                        <RowDefinition/> <!-- RTT -->
                                        <RowDefinition/> <!-- Decode -->
                                        <RowDefinition/> <!-- Bitrate -->
                                    </Grid.RowDefinitions>

                                    <!-- Jitter -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Jitter"
                                               Style="{StaticResource ST_RowDescription}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="avg" Style="{StaticResource ST_RowDescription}"/>
                                        <TextBlock Text="{x:Bind ViewModel.DetailJitterAvg, Mode=OneWay}"
                                                   Style="{StaticResource ST_MonoValueSmall}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="max" Style="{StaticResource ST_RowDescription}"/>
                                        <TextBlock Text="{x:Bind ViewModel.DetailJitterMax, Mode=OneWay}"
                                                   Style="{StaticResource ST_MonoValueSmall}"/>
                                    </StackPanel>

                                    <!-- Drops -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Drops"
                                               Style="{StaticResource ST_RowDescription}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{x:Bind ViewModel.DetailDropRate, Mode=OneWay}"
                                               Style="{StaticResource ST_MonoValueSmall}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                               Style="{StaticResource ST_RowDescription}"
                                               VerticalAlignment="Center">
                                        <Run Text="("/>
                                        <Run Text="{x:Bind ViewModel.DetailDrops, Mode=OneWay}"/>
                                        <Run Text=" frames)"/>
                                    </TextBlock>

                                    <!-- RTT -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="RTT"
                                               Style="{StaticResource ST_RowDescription}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="avg" Style="{StaticResource ST_RowDescription}"/>
                                        <TextBlock Text="{x:Bind ViewModel.DetailRttAvg, Mode=OneWay}"
                                                   Style="{StaticResource ST_MonoValueSmall}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="max" Style="{StaticResource ST_RowDescription}"/>
                                        <TextBlock Text="{x:Bind ViewModel.DetailRttMax, Mode=OneWay}"
                                                   Style="{StaticResource ST_MonoValueSmall}"/>
                                    </StackPanel>

                                    <!-- Decode -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Decode"
                                               Style="{StaticResource ST_RowDescription}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="avg" Style="{StaticResource ST_RowDescription}"/>
                                        <TextBlock Text="{x:Bind ViewModel.DetailDecodeAvg, Mode=OneWay}"
                                                   Style="{StaticResource ST_MonoValueSmall}"/>
                                    </StackPanel>

                                    <!-- Bitrate -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Bitrate"
                                               Style="{StaticResource ST_RowDescription}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="avg" Style="{StaticResource ST_RowDescription}"/>
                                        <TextBlock Text="{x:Bind ViewModel.DetailBitrateAvg, Mode=OneWay}"
                                                   Style="{StaticResource ST_MonoValueSmall}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- HOST box -->
                        <Border Grid.Column="1"
                                Background="{StaticResource STInput}"
                                BorderBrush="{StaticResource STBorder}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="16,14"
                                Visibility="{x:Bind ViewModel.HasHostStats, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="HOST  (StreamTweak)"
                                           Style="{StaticResource ST_SectionLabel}"/>

                                <Grid ColumnSpacing="10" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="GPU"
                                               Style="{StaticResource ST_RowDescription}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{x:Bind ViewModel.DetailHostGpu, Mode=OneWay}"
                                               Style="{StaticResource ST_MonoValueSmall}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Encoder"
                                               Style="{StaticResource ST_RowDescription}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{x:Bind ViewModel.DetailHostEncoder, Mode=OneWay}"
                                               Style="{StaticResource ST_MonoValueSmall}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="GPU Temp"
                                               Style="{StaticResource ST_RowDescription}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{x:Bind ViewModel.DetailHostTemp, Mode=OneWay}"
                                               Style="{StaticResource ST_MonoValueSmall}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="CPU"
                                               Style="{StaticResource ST_RowDescription}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Text="{x:Bind ViewModel.DetailHostCpu, Mode=OneWay}"
                                               Style="{StaticResource ST_MonoValueSmall}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Net TX avg"
                                               Style="{StaticResource ST_RowDescription}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1"
                                               Text="{x:Bind ViewModel.DetailHostNetTx, Mode=OneWay}"
                                               Style="{StaticResource ST_MonoValueSmall}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ── Separator ─────────────────────────────────────── -->
                    <Border Grid.Row="3"
                            Style="{StaticResource ST_Separator}"
                            Margin="0,0,0,10"/>

                    <!-- ── Row 4: Charts section header ──────────────────── -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10"
                                Margin="0,0,0,10"
                                Visibility="{x:Bind ViewModel.HasChartData, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="CLIENT CHARTS"
                                   Style="{StaticResource ST_SectionLabel}"/>
                        <TextBlock Text="(click to expand)"
                                   Style="{StaticResource ST_RowDescription}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- ── Row 5: Charts 2×2 ─────────────────────────────── -->
                    <Grid Grid.Row="5"
                          ColumnSpacing="12" RowSpacing="12"
                          Visibility="{x:Bind ViewModel.HasChartData, Mode=OneWay,
                                       Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0"
                              Tapped="RttChart_Tapped"
                              ToolTipService.ToolTip="Click to expand">
                            <ctl:SparklineControl
                                Title="RTT ms"
                                LineColor="#FFFFA726"
                                Data="{x:Bind ViewModel.RttSeries, Mode=OneWay}"
                                DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="1"
                              Tapped="DropsChart_Tapped"
                              ToolTipService.ToolTip="Click to expand">
                            <ctl:SparklineControl
                                Title="Frame Drops"
                                LineColor="#FFEF5350"
                                Data="{x:Bind ViewModel.DropsSeries, Mode=OneWay}"
                                DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="0"
                              Tapped="BitrateChart_Tapped"
                              ToolTipService.ToolTip="Click to expand">
                            <ctl:SparklineControl
                                Title="Bitrate Mbps"
                                LineColor="#FF26C6DA"
                                Data="{x:Bind ViewModel.BitrateSeries, Mode=OneWay}"
                                DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="1"
                              Tapped="DecodeChart_Tapped"
                              ToolTipService.ToolTip="Click to expand">
                            <ctl:SparklineControl
                                Title="Decode ms"
                                LineColor="#FFAB47BC"
                                Data="{x:Bind ViewModel.DecodeSeries, Mode=OneWay}"
                                DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                        </Grid>
                    </Grid>

                    <!-- ── Row 6: Games section ──────────────────────────── -->
                    <StackPanel Grid.Row="6"
                                Margin="0,10,0,0"
                                Spacing="10"
                                Visibility="{x:Bind ViewModel.HasDetailGamesSection, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}">

                        <TextBlock Text="GAMES" Style="{StaticResource ST_SectionLabel}"/>

                        <ScrollViewer HorizontalScrollMode="Auto"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      HorizontalAlignment="Left">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DetailGameCovers, Mode=OneWay}"
                                          HorizontalAlignment="Left"
                                          Visibility="{x:Bind ViewModel.HasDetailGameCovers, Mode=OneWay,
                                                       Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SessionGameCover">
                                        <Border Width="67" Height="100"
                                                CornerRadius="6"
                                                Background="{StaticResource STBackground}"
                                                ToolTipService.ToolTip="{x:Bind GameName}">
                                            <Grid>
                                                <Image Source="{x:Bind CoverImage, Mode=OneWay}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{x:Bind HasNoCover, Mode=OneWay,
                                                                    Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                <TextBlock Text="{x:Bind GameName}"
                                                           Style="{StaticResource ST_RowDescription}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           Margin="4"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Visibility="{x:Bind HasNoCover, Mode=OneWay,
                                                                        Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="No games detected during this session"
                                   Style="{StaticResource ST_RowDescription}"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.HasNoDetailGames, Mode=OneWay,
                                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- ── Row 7: Grade bar ───────────────────────────────── -->
                    <Border Grid.Row="7"
                            Margin="0,14,0,0"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,10"
                            BorderBrush="{x:Bind ViewModel.GradeColorHex, Mode=OneWay,
                                         Converter={StaticResource HexToSolidColorBrushConverter}}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="10">
                            <Ellipse Width="10" Height="10"
                                     VerticalAlignment="Center"
                                     Fill="{x:Bind ViewModel.GradeColorHex, Mode=OneWay,
                                            Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                            <TextBlock Style="{StaticResource ST_RowLabel}"
                                       VerticalAlignment="Center">
                                <Run Text="Streaming quality — "/>
                                <Run Text="{x:Bind ViewModel.GradeLabel, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>


        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- LAYER 3 — Fullscreen chart                                        -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{x:Bind ViewModel.IsChartFullscreen, Mode=OneWay,
                            Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#E6111010">

            <Border Margin="28,16,28,28"
                    Style="{StaticResource ST_CardNoPad}">

                <Grid Margin="20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.FullscreenChartTitle, Mode=OneWay}"
                                       Style="{StaticResource ST_PageTitle}"/>
                            <TextBlock Text="{x:Bind ViewModel.DetailHeaderSubtitle, Mode=OneWay}"
                                       Style="{StaticResource ST_PageSubtitle}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource ST_ButtonGhost}"
                                Content="&#xE711;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14" Width="32" Height="32" Padding="0"
                                VerticalAlignment="Top"
                                Click="CloseFullscreen_Click"
                                ToolTipService.ToolTip="Close (Esc)"/>
                    </Grid>

                    <Border Grid.Row="1"
                            Style="{StaticResource ST_Separator}"
                            Margin="0,0,0,14"/>

                    <ctl:SparklineControl
                        Grid.Row="2"
                        Title=""
                        Data="{x:Bind ViewModel.FullscreenChartData, Mode=OneWay}"
                        LineColor="{x:Bind ViewModel.FullscreenLineColor, Mode=OneWay}"
                        DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>

</Page>
