<Page
    x:Class="StreamTweak.Views.LogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:StreamTweak.Controls"
    xmlns:vm="using:StreamTweak.ViewModels"
    Background="Transparent">

    <!--
        Three solid layers stacked in the root Grid.
        Each higher layer has a solid (non-transparent) background so it
        completely replaces what is underneath — no transparency stacking.

        Layer 1 — Session list (always rendered)
        Layer 2 — Session detail (covers layer 1 when visible)
        Layer 3 — Fullscreen chart (covers layers 1+2 when visible)
    -->
    <Grid>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- LAYER 1 — Session list                                            -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- page header -->
                <RowDefinition Height="*"/>      <!-- card -->
            </Grid.RowDefinitions>

            <!-- Page header: title + clear button -->
            <Grid Grid.Row="0" Margin="20,16,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Streaming Session History"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Clear history"
                        VerticalAlignment="Center"
                        Click="ClearHistory_Click"/>
            </Grid>

            <!-- Main card -->
            <Border Grid.Row="1"
                    Margin="20,0,20,24"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- column headers -->
                        <RowDefinition Height="*"/>      <!-- list or empty state -->
                    </Grid.RowDefinitions>

                    <!-- Column header bar -->
                    <Grid Grid.Row="0"
                          Padding="20,0"
                          MinHeight="36"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>    <!-- accent bar -->
                            <ColumnDefinition Width="16"/>   <!-- gap -->
                            <ColumnDefinition Width="2.5*"/> <!-- date/time -->
                            <ColumnDefinition Width="1*"/>   <!-- duration -->
                            <ColumnDefinition Width="1*"/>   <!-- rtt avg -->
                            <ColumnDefinition Width="1*"/>   <!-- drops % -->
                            <ColumnDefinition Width="1.5*"/> <!-- quality -->
                            <ColumnDefinition Width="2*"/>   <!-- games covers -->
                            <ColumnDefinition Width="68"/>   <!-- actions -->
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="Date / Time"
                                   FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Duration"
                                   FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="RTT avg"
                                   FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="Drops %"
                                   FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="Quality"
                                   FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="Games"
                                   FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.5" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Separator under column headers -->
                    <Rectangle Grid.Row="0" Height="1"
                               VerticalAlignment="Bottom"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                               Opacity="0.35"/>

                    <!-- Session list -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Sessions}"
                              SelectionMode="None"
                              Padding="0"
                              Visibility="{x:Bind ViewModel.HasSessions, Mode=OneWay,
                                           Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"
                                   BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="StreamTweak:SessionEntry"
                                          xmlns:StreamTweak="using:StreamTweak">
                                <!-- Row wrapper: content + bottom separator -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                    </Grid.RowDefinitions>

                                    <!-- Bottom separator -->
                                    <Rectangle Grid.Row="1"
                                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                               Opacity="0.2"/>

                                    <!-- Row content -->
                                    <Grid Grid.Row="0" Padding="20,0" MinHeight="54">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>    <!-- accent bar -->
                                            <ColumnDefinition Width="16"/>   <!-- gap -->
                                            <ColumnDefinition Width="2.5*"/> <!-- date/time -->
                                            <ColumnDefinition Width="1*"/>   <!-- duration -->
                                            <ColumnDefinition Width="1*"/>   <!-- rtt avg -->
                                            <ColumnDefinition Width="1*"/>   <!-- drops % -->
                                            <ColumnDefinition Width="1.5*"/> <!-- quality -->
                                            <ColumnDefinition Width="2*"/>   <!-- games covers -->
                                            <ColumnDefinition Width="68"/>   <!-- actions -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Left accent bar (grade color) -->
                                        <Rectangle Grid.Column="0"
                                                   Width="3"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Stretch"
                                                   RadiusX="1.5" RadiusY="1.5"
                                                   Margin="0,10"
                                                   Fill="{x:Bind GradeColorHex,
                                                          Converter={StaticResource HexToSolidColorBrushConverter}}"/>

                                        <!-- Date / Time -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind StartTimeDisplay}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind DurationDisplay}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.6"/>

                                        <!-- RTT avg -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{x:Bind RttAvgDisplay}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.85"/>

                                        <!-- Drops % -->
                                        <TextBlock Grid.Column="5"
                                                   Text="{x:Bind DropRateDisplay}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.85"/>

                                        <!-- Quality pill (only when graded) -->
                                        <Border Grid.Column="6"
                                                CornerRadius="10"
                                                BorderThickness="1"
                                                Padding="10,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                BorderBrush="{x:Bind GradeColorHex,
                                                              Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                Visibility="{x:Bind HasGrade,
                                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="7" Height="7"
                                                         VerticalAlignment="Center"
                                                         Fill="{x:Bind GradeColorHex,
                                                                Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                                <TextBlock Text="{x:Bind GradeShortLabel}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Games covers: small cover strip in detection order -->
                                        <ItemsControl Grid.Column="7"
                                                      ItemsSource="{x:Bind GamesDetected}"
                                                      VerticalAlignment="Center"
                                                      Visibility="{x:Bind HasGamesDetected,
                                                                   Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="3"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <!-- DataType omitted: each item is a string (game name) -->
                                                <DataTemplate>
                                                    <Border Width="33" Height="50"
                                                            CornerRadius="3"
                                                            Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                            ToolTipService.ToolTip="{Binding}">
                                                        <Image Source="{Binding Converter={StaticResource GameNameToCoverConverter}}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- "No games" fallback when monitor ran but found nothing -->
                                        <TextBlock Grid.Column="7"
                                                   Text="No games detected"
                                                   FontSize="11"
                                                   FontStyle="Italic"
                                                   Opacity="0.35"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind HasNoGamesDetected,
                                                                Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- Actions: detail + delete -->
                                        <StackPanel Grid.Column="8"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="4">

                                            <!-- Detail button (same icon as Logs nav item) -->
                                            <Button Width="30" Height="30" Padding="0"
                                                    FontSize="14"
                                                    Content="&#xE9F9;"
                                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                    Click="DetailButton_Click"
                                                    Visibility="{x:Bind HasGrade,
                                                                 Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTipService.ToolTip="View session detail"/>

                                            <!-- Delete button -->
                                            <Button Width="30" Height="30" Padding="0"
                                                    FontSize="13"
                                                    Content="&#xE74D;"
                                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                    Click="DeleteSession_Click"
                                                    ToolTipService.ToolTip="Delete this session"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="{x:Bind ViewModel.HasSessions, Mode=OneWay,
                                             Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE9F9;"
                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  FontSize="36" Opacity="0.2"/>
                        <TextBlock Text="No sessions recorded yet"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.4"/>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>


        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- LAYER 2 — Session detail (solid, fully covers layer 1)            -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{x:Bind ViewModel.IsDetailVisible, Mode=OneWay,
                            Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

            <Border Margin="20,16,20,24"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">

                <Grid Margin="18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- header -->
                        <RowDefinition Height="Auto"/>   <!-- separator -->
                        <RowDefinition Height="Auto"/>   <!-- stats panels -->
                        <RowDefinition Height="Auto"/>   <!-- separator -->
                        <RowDefinition Height="Auto"/>   <!-- "Client Charts" label -->
                        <RowDefinition Height="*"/>      <!-- charts 2×2 -->
                        <RowDefinition Height="Auto"/>   <!-- games section -->
                        <RowDefinition Height="Auto"/>   <!-- grade bar -->
                    </Grid.RowDefinitions>

                    <!-- ── Row 0: Header ──────────────────────────────────── -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Session Detail"
                                       FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.DetailHeaderSubtitle, Mode=OneWay}"
                                       FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="&#xE711;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14" Width="32" Height="32" Padding="0"
                                VerticalAlignment="Top"
                                Click="CloseDetail_Click"
                                ToolTipService.ToolTip="Close (Esc)"/>
                    </Grid>

                    <!-- ── Separator ─────────────────────────────────────── -->
                    <Rectangle Grid.Row="1"
                               Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                               Opacity="0.4"
                               Margin="0,0,0,12"/>

                    <!-- ── Row 2: Stats panels (CLIENT | HOST) ────────────── -->
                    <Grid Grid.Row="2" ColumnSpacing="12" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CLIENT box -->
                        <Border Grid.Column="0"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="14,12">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Opacity="0.5"
                                           CharacterSpacing="50" Text="CLIENT  (StreamLight)"/>

                                <Grid ColumnSpacing="10" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/>   <!-- label -->
                                        <ColumnDefinition Width="*"/>    <!-- primary value -->
                                        <ColumnDefinition Width="Auto"/> <!-- secondary value -->
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/> <!-- Jitter -->
                                        <RowDefinition/> <!-- Drops -->
                                        <RowDefinition/> <!-- RTT -->
                                        <RowDefinition/> <!-- Decode -->
                                        <RowDefinition/> <!-- Bitrate -->
                                    </Grid.RowDefinitions>

                                    <!-- Jitter -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Jitter"
                                               FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="avg" FontSize="11" Opacity="0.55"/>
                                        <TextBlock Text="{x:Bind ViewModel.DetailJitterAvg, Mode=OneWay}"
                                                   FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="max" FontSize="11" Opacity="0.55"/>
                                        <TextBlock Text="{x:Bind ViewModel.DetailJitterMax, Mode=OneWay}"
                                                   FontSize="12" Opacity="0.75"/>
                                    </StackPanel>

                                    <!-- Drops -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Drops"
                                               FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{x:Bind ViewModel.DetailDropRate, Mode=OneWay}"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                               FontSize="11" Opacity="0.55" VerticalAlignment="Center">
                                        <Run Text="("/>
                                        <Run Text="{x:Bind ViewModel.DetailDrops, Mode=OneWay}"/>
                                        <Run Text=" frames)"/>
                                    </TextBlock>

                                    <!-- RTT -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="RTT"
                                               FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="avg" FontSize="11" Opacity="0.55"/>
                                        <TextBlock Text="{x:Bind ViewModel.DetailRttAvg, Mode=OneWay}"
                                                   FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="max" FontSize="11" Opacity="0.55"/>
                                        <TextBlock Text="{x:Bind ViewModel.DetailRttMax, Mode=OneWay}"
                                                   FontSize="12" Opacity="0.75"/>
                                    </StackPanel>

                                    <!-- Decode -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Decode"
                                               FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="avg" FontSize="11" Opacity="0.55"/>
                                        <TextBlock Text="{x:Bind ViewModel.DetailDecodeAvg, Mode=OneWay}"
                                                   FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <!-- Bitrate -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Bitrate"
                                               FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="avg" FontSize="11" Opacity="0.55"/>
                                        <TextBlock Text="{x:Bind ViewModel.DetailBitrateAvg, Mode=OneWay}"
                                                   FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- HOST box (hidden when no host data) -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="14,12"
                                Visibility="{x:Bind ViewModel.HasHostStats, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Opacity="0.5"
                                           CharacterSpacing="50" Text="HOST  (StreamTweak)"/>

                                <Grid ColumnSpacing="10" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>  <!-- label -->
                                        <ColumnDefinition Width="*"/>   <!-- value -->
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/> <!-- GPU -->
                                        <RowDefinition/> <!-- Encoder -->
                                        <RowDefinition/> <!-- GPU Temp -->
                                        <RowDefinition/> <!-- CPU -->
                                        <RowDefinition/> <!-- Net TX -->
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="GPU"
                                               FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{x:Bind ViewModel.DetailHostGpu, Mode=OneWay}"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Encoder"
                                               FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{x:Bind ViewModel.DetailHostEncoder, Mode=OneWay}"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="GPU Temp"
                                               FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{x:Bind ViewModel.DetailHostTemp, Mode=OneWay}"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="CPU"
                                               FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Text="{x:Bind ViewModel.DetailHostCpu, Mode=OneWay}"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Net TX avg"
                                               FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1"
                                               Text="{x:Bind ViewModel.DetailHostNetTx, Mode=OneWay}"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ── Separator ─────────────────────────────────────── -->
                    <Rectangle Grid.Row="3"
                               Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                               Opacity="0.4"
                               Margin="0,0,0,8"/>

                    <!-- ── Row 4: Charts section header ──────────────────── -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8"
                                Margin="0,0,0,8"
                                Visibility="{x:Bind ViewModel.HasChartData, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Client Charts"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="(click to expand)"
                                   FontSize="11" Opacity="0.45"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- ── Row 5: Charts 2×2 grid ─────────────────────────── -->
                    <Grid Grid.Row="5"
                          ColumnSpacing="12" RowSpacing="12"
                          Visibility="{x:Bind ViewModel.HasChartData, Mode=OneWay,
                                       Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- RTT (ms) — amber/orange -->
                        <Grid Grid.Row="0" Grid.Column="0"
                              Tapped="RttChart_Tapped"
                              ToolTipService.ToolTip="Click to expand">
                            <ctl:SparklineControl
                                Title="RTT ms"
                                LineColor="#FFFFA726"
                                Data="{x:Bind ViewModel.RttSeries, Mode=OneWay}"
                                DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                        </Grid>

                        <!-- Frame Drops — red -->
                        <Grid Grid.Row="0" Grid.Column="1"
                              Tapped="DropsChart_Tapped"
                              ToolTipService.ToolTip="Click to expand">
                            <ctl:SparklineControl
                                Title="Frame Drops"
                                LineColor="#FFEF5350"
                                Data="{x:Bind ViewModel.DropsSeries, Mode=OneWay}"
                                DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                        </Grid>

                        <!-- Bitrate (Mbps) — cyan -->
                        <Grid Grid.Row="1" Grid.Column="0"
                              Tapped="BitrateChart_Tapped"
                              ToolTipService.ToolTip="Click to expand">
                            <ctl:SparklineControl
                                Title="Bitrate Mbps"
                                LineColor="#FF26C6DA"
                                Data="{x:Bind ViewModel.BitrateSeries, Mode=OneWay}"
                                DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                        </Grid>

                        <!-- Decode (ms) — purple -->
                        <Grid Grid.Row="1" Grid.Column="1"
                              Tapped="DecodeChart_Tapped"
                              ToolTipService.ToolTip="Click to expand">
                            <ctl:SparklineControl
                                Title="Decode ms"
                                LineColor="#FFAB47BC"
                                Data="{x:Bind ViewModel.DecodeSeries, Mode=OneWay}"
                                DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                        </Grid>
                    </Grid>

                    <!-- ── Row 6: Games section ──────────────────────────── -->
                    <StackPanel Grid.Row="6"
                                Margin="0,8,0,0"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.HasDetailGamesSection, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}">

                        <!-- Label — same style as "Client Charts" -->
                        <TextBlock Text="Games"
                                   FontSize="13" FontWeight="SemiBold"/>

                        <!-- Covers strip — left-aligned, scrollable when many games -->
                        <ScrollViewer HorizontalScrollMode="Auto"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      HorizontalAlignment="Left">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DetailGameCovers, Mode=OneWay}"
                                          HorizontalAlignment="Left"
                                          Visibility="{x:Bind ViewModel.HasDetailGameCovers, Mode=OneWay,
                                                       Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SessionGameCover">
                                        <Border Width="67" Height="100"
                                                CornerRadius="5"
                                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                ToolTipService.ToolTip="{x:Bind GameName}">
                                            <Grid>
                                                <!-- Cover image (once loaded) -->
                                                <Image Source="{x:Bind CoverImage, Mode=OneWay}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{x:Bind HasNoCover, Mode=OneWay,
                                                                    Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                <!-- Name fallback while image loads -->
                                                <TextBlock Text="{x:Bind GameName}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           Margin="4"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Visibility="{x:Bind HasNoCover, Mode=OneWay,
                                                                        Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- No games detected fallback -->
                        <TextBlock Text="No games detected during this session"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   Opacity="0.4"
                                   HorizontalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.HasNoDetailGames, Mode=OneWay,
                                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- ── Row 7: Grade bar ───────────────────────────────── -->
                    <Border Grid.Row="7"
                            Margin="0,12,0,0"
                            BorderThickness="1" CornerRadius="6"
                            Padding="14,9"
                            BorderBrush="{x:Bind ViewModel.GradeColorHex, Mode=OneWay,
                                         Converter={StaticResource HexToSolidColorBrushConverter}}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <Ellipse Width="10" Height="10"
                                     VerticalAlignment="Center"
                                     Fill="{x:Bind ViewModel.GradeColorHex, Mode=OneWay,
                                            Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <Run Text="Streaming quality — "/>
                                <Run Text="{x:Bind ViewModel.GradeLabel, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>


        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- LAYER 3 — Fullscreen chart (solid, fully covers layers 1+2)       -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{x:Bind ViewModel.IsChartFullscreen, Mode=OneWay,
                            Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

            <Border Margin="20,16,20,24"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">

                <Grid Margin="18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- header -->
                        <RowDefinition Height="Auto"/>  <!-- separator -->
                        <RowDefinition Height="*"/>     <!-- chart (fills all remaining space) -->
                    </Grid.RowDefinitions>

                    <!-- Header: title + date/duration + close -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.FullscreenChartTitle, Mode=OneWay}"
                                       FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.DetailHeaderSubtitle, Mode=OneWay}"
                                       FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="&#xE711;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14" Width="32" Height="32" Padding="0"
                                VerticalAlignment="Top"
                                Click="CloseFullscreen_Click"
                                ToolTipService.ToolTip="Close (Esc)"/>
                    </Grid>

                    <Rectangle Grid.Row="1"
                               Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                               Opacity="0.4"
                               Margin="0,0,0,12"/>

                    <!-- Full-size chart — fills all remaining vertical space -->
                    <ctl:SparklineControl
                        Grid.Row="2"
                        Title=""
                        Data="{x:Bind ViewModel.FullscreenChartData, Mode=OneWay}"
                        LineColor="{x:Bind ViewModel.FullscreenLineColor, Mode=OneWay}"
                        DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>

</Page>
