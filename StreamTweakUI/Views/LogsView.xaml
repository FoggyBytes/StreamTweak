<Page
    x:Class="StreamTweak.Views.LogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:StreamTweak.Controls"
    xmlns:vm="using:StreamTweak.ViewModels"
    xmlns:core="using:StreamTweak"
    Background="{StaticResource STBackground}">

    <!-- ═══════════════════════════════════════════════════════════════════════
         9.0 Sessions. The list alone, at every width; a session opens over it with a back
         button, so its charts have the whole content column (the master–detail split of the
         first 9.0 cut squeezed them). Compare covers both, from two ticked rows or
         "Compare with…" in the detail. The detail's charts are one TimelineChart, every
         series on the same clock; it can go full screen on its own.
    ════════════════════════════════════════════════════════════════════════ -->

    <Page.Resources>
        <DataTemplate x:Key="CoverSmallTemplate" x:DataType="core:GameCoverItem">
            <Border Width="22" Height="33" CornerRadius="3" Background="{StaticResource ST9Inset}"
                    ToolTipService.ToolTip="{x:Bind Name}">
                <Image Source="{x:Bind CoverPath, Converter={StaticResource CoverPathToBitmapConverter}}" Stretch="UniformToFill"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CoverMediumTemplate" x:DataType="core:GameCoverItem">
            <Border Width="46" Height="69" CornerRadius="5" Background="{StaticResource ST9Inset}"
                    BorderBrush="{StaticResource ST9Stroke2}" BorderThickness="1"
                    ToolTipService.ToolTip="{x:Bind Name}">
                <Image Source="{x:Bind CoverPath, Converter={StaticResource CoverPathToBitmapConverter}}" Stretch="UniformToFill"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SessionComboTemplate" x:DataType="core:SessionEntry">
            <TextBlock TextTrimming="CharacterEllipsis">
                <Run Text="{x:Bind StartTimeDisplay}"/><Run Text="  ·  " Foreground="{StaticResource ST9Text3}"/><Run Text="{x:Bind DurationDisplay}"/><Run Text="  ·  " Foreground="{StaticResource ST9Text3}"/><Run Text="{x:Bind GradeShortLabel}"/>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="CompareRowTemplate" x:DataType="vm:CompareMetric">
            <Grid Padding="16,9" BorderBrush="{StaticResource ST9Stroke}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="112"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" Style="{StaticResource ST9_Body}" Foreground="{StaticResource ST9Text}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{x:Bind ValueA}" Style="{StaticResource ST9_Body}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{x:Bind ValueB}" Style="{StaticResource ST9_Body}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <Border Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4" Padding="7,2,7,3"
                        Background="{x:Bind DeltaBgHex, Converter={StaticResource HexToSolidColorBrushConverter}}">
                    <TextBlock Text="{x:Bind Delta}" Style="{StaticResource ST9_TagText}"
                               Foreground="{x:Bind DeltaFgHex, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Root" SizeChanged="Root_SizeChanged">

        <!-- ═════════════════════════════ LIST ═════════════════════════════ -->
        <Grid x:Name="ListLayer">
            <ListView x:Name="SessionList"
                      ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                      ItemContainerStyle="{StaticResource ST9_PlainListItem}"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="SessionList_ItemClick"
                      Padding="32,24,32,96">
                <!-- An item is the day heading plus the row: the container's own hover would light
                     up both. It is switched off here and the row draws its own (RowHover). -->
                <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent"/>
                </ListView.Resources>
                <ListView.Header>
                    <StackPanel Spacing="16" Margin="0,0,0,8">
                        <!-- Header -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Sessions" Style="{StaticResource ST9_PageTitle}"/>
                                <TextBlock Text="Every stream this host served, graded on what the client saw and on whether the host kept up."
                                           Style="{StaticResource ST9_PageSubtitle}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Bottom" MinWidth="140"
                                      ItemsSource="{x:Bind ViewModel.PeriodOptions}"
                                      SelectedIndex="{x:Bind ViewModel.PeriodIndex, Mode=TwoWay}"/>
                            <Button Grid.Column="2" Style="{StaticResource ST9_IconButton}" VerticalAlignment="Bottom"
                                    Content="&#xE712;" ToolTipService.ToolTip="More">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="Clear history…" Click="ClearHistory_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <!-- Summary strip -->
                        <Border Style="{StaticResource ST9_Card}" Padding="20,16"
                                Visibility="{x:Bind ViewModel.HasSessions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ctrl:ResponsiveGrid MinColumnWidth="130" MaxColumns="5" ColumnSpacing="20" RowSpacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Sessions" Style="{StaticResource ST9_Label}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SummarySessions, Mode=OneWay}" Style="{StaticResource ST9_ValueS}"/>
                                    <TextBlock Text="{x:Bind ViewModel.PeriodLabel, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Streamed" Style="{StaticResource ST9_Label}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind ViewModel.SummaryHours, Mode=OneWay}" Style="{StaticResource ST9_ValueS}"/>
                                        <TextBlock Text="h" Style="{StaticResource ST9_Unit}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Avg RTT" Style="{StaticResource ST9_Label}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind ViewModel.SummaryRtt, Mode=OneWay}" Style="{StaticResource ST9_ValueS}"/>
                                        <TextBlock Text="ms" Style="{StaticResource ST9_Unit}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Avg host latency" Style="{StaticResource ST9_Label}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind ViewModel.SummaryHostLat, Mode=OneWay}" Style="{StaticResource ST9_ValueS}"/>
                                        <TextBlock Text="ms" Style="{StaticResource ST9_Unit}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Grades" Style="{StaticResource ST9_Label}"/>
                                    <ctrl:GradeBar Excellent="{x:Bind ViewModel.CountExcellent, Mode=OneWay}"
                                                   Good="{x:Bind ViewModel.CountGood, Mode=OneWay}"
                                                   Poor="{x:Bind ViewModel.CountPoor, Mode=OneWay}"/>
                                    <TextBlock Style="{StaticResource ST9_Hint}">
                                        <Run Text="{x:Bind ViewModel.CountExcellent, Mode=OneWay}"/><Run Text=" · "/><Run Text="{x:Bind ViewModel.CountGood, Mode=OneWay}"/><Run Text=" · "/><Run Text="{x:Bind ViewModel.CountPoor, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </ctrl:ResponsiveGrid>
                        </Border>

                        <!-- Toolbar: search, grade chips (under the search box when the list is
                             narrow, e.g. beside the detail — see ApplyLayout) -->
                        <Grid ColumnSpacing="12" RowSpacing="10"
                              Visibility="{x:Bind ViewModel.HasSessions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="SearchBox" Style="{StaticResource ST9_SearchBox}" Width="240" PlaceholderText="Filter by game"
                                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel x:Name="GradeChips" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <ToggleButton Style="{StaticResource ST9_Chip}" Tag="-1" IsChecked="True" Click="GradeChip_Click"
                                              Content="{x:Bind ViewModel.ChipAllText, Mode=OneWay}"/>
                                <ToggleButton Style="{StaticResource ST9_Chip}" Tag="1" Click="GradeChip_Click"
                                              Content="{x:Bind ViewModel.ChipExcellentText, Mode=OneWay}"/>
                                <ToggleButton Style="{StaticResource ST9_Chip}" Tag="2" Click="GradeChip_Click"
                                              Content="{x:Bind ViewModel.ChipGoodText, Mode=OneWay}"/>
                                <ToggleButton Style="{StaticResource ST9_Chip}" Tag="3" Click="GradeChip_Click"
                                              Content="{x:Bind ViewModel.ChipPoorText, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Column headings -->
                        <Grid Padding="6,0,10,0" Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="128"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="2" Text="When" Style="{StaticResource ST9_Label}"/>
                            <TextBlock Grid.Column="3" Text="Games" Style="{StaticResource ST9_Label}"
                                       Visibility="{x:Bind ViewModel.RowLayout.GamesVisibility, Mode=OneWay}"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                        Visibility="{x:Bind ViewModel.RowLayout.MetricsVisibility, Mode=OneWay}">
                                <TextBlock Width="72" Text="RTT" Style="{StaticResource ST9_Label}" TextAlignment="Right"/>
                                <TextBlock Width="92" Text="Host latency" Style="{StaticResource ST9_Label}" TextAlignment="Right"/>
                                <TextBlock Width="72" Text="Drops" Style="{StaticResource ST9_Label}" TextAlignment="Right"/>
                            </StackPanel>
                            <TextBlock Grid.Column="5" Width="92" Text="Grade" Style="{StaticResource ST9_Label}" TextAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource ST9_Body}" Margin="4,12,0,0"
                                   Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    </StackPanel>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionRow">
                        <StackPanel>
                            <!-- Day heading (first row of each day) -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="6,18,6,8" Visibility="{x:Bind DayVisibility}">
                                <TextBlock Text="{x:Bind DayText}" Style="{StaticResource ST9_RowTitle}" Foreground="{StaticResource ST9Text2}"/>
                                <TextBlock Text="{x:Bind DaySubText}" Style="{StaticResource ST9_Hint}" VerticalAlignment="Bottom"/>
                            </StackPanel>

                            <!-- The row on the card black: on the bare Mica background the list read poorly. -->
                            <Border Background="{StaticResource ST9Card}" CornerRadius="8" Margin="0,0,0,4">
                                <Grid Padding="6,8,10,8" CornerRadius="8" MinHeight="54"
                                      Background="{x:Bind RowBackgroundHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                      PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited" PointerCanceled="Row_PointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="128"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Compare with…" Tag="{x:Bind Id}" Click="RowCompare_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AB;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Delete session" Tag="{x:Bind Id}" Click="RowDelete_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
    
                                    <!-- Hover of this row only (the item container's is off, see ListView.Resources) -->
                                    <Border x:Name="RowHover" Grid.ColumnSpan="7" Margin="-6,-8,-10,-8" CornerRadius="8"
                                            Background="{StaticResource ST9GreySoft}" Opacity="0" IsHitTestVisible="False"/>
                                    <CheckBox MinWidth="0" Padding="0" VerticalAlignment="Center"
                                              IsChecked="{x:Bind IsChecked, Mode=TwoWay}" Visibility="{x:Bind PickVisibility}"
                                              ToolTipService.ToolTip="Select to compare"/>
                                    <Rectangle Grid.Column="1" Width="4" Height="34" RadiusX="2" RadiusY="2" HorizontalAlignment="Left"
                                               Fill="{x:Bind StripeHex, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind WhenText}" Style="{StaticResource ST9_RowTitle}"/>
                                        <TextBlock Text="{x:Bind SubText}" Style="{StaticResource ST9_Hint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,12,0"
                                                Visibility="{x:Bind Layout.GamesVisibility, Mode=OneWay}">
                                        <ItemsControl ItemsSource="{x:Bind Covers}" ItemTemplate="{StaticResource CoverSmallTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <TextBlock Text="{x:Bind GamesText}" Style="{StaticResource ST9_Hint}" Foreground="{StaticResource ST9Text2}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{x:Bind Layout.MetricsVisibility, Mode=OneWay}">
                                        <TextBlock Width="72" TextAlignment="Right" Style="{StaticResource ST9_Body}" Foreground="{StaticResource ST9Text}">
                                            <Run Text="{x:Bind RttText}"/><Run Text=" ms" Foreground="{StaticResource ST9Text3}" FontSize="11.5"/>
                                        </TextBlock>
                                        <TextBlock Width="92" TextAlignment="Right" Style="{StaticResource ST9_Body}" Foreground="{StaticResource ST9Text}">
                                            <Run Text="{x:Bind HostLatText}"/><Run Text=" ms" Foreground="{StaticResource ST9Text3}" FontSize="11.5"/>
                                        </TextBlock>
                                        <TextBlock Width="72" TextAlignment="Right" Style="{StaticResource ST9_Body}" Foreground="{StaticResource ST9Text}">
                                            <Run Text="{x:Bind DropsText}"/><Run Text=" %" Foreground="{StaticResource ST9Text3}" FontSize="11.5"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="5" Width="92" VerticalAlignment="Center">
                                        <Border HorizontalAlignment="Right" CornerRadius="4" Padding="7,2,7,3" BorderThickness="1"
                                                Background="{x:Bind GradeBgHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                BorderBrush="{x:Bind GradeBorderHex, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                            <TextBlock Text="{x:Bind GradeLabel}" Style="{StaticResource ST9_TagText}"
                                                       Foreground="{x:Bind GradeFgHex, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                        </Border>
                                    </Border>
                                    <FontIcon Grid.Column="6" Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right"
                                              Foreground="{StaticResource ST9Text4}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Compare bar: appears once a row is ticked -->
            <Border x:Name="CompareBar" VerticalAlignment="Bottom" Margin="32,0,32,16" Padding="16,10" CornerRadius="10"
                    Background="{StaticResource ST9Pane}" BorderBrush="{StaticResource ST9CardStroke}" BorderThickness="1"
                    Visibility="{x:Bind ViewModel.IsCompareBarVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.CompareBarText, Mode=OneWay}" Style="{StaticResource ST9_Body}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Style="{StaticResource ST9_ButtonGhost}" Content="Clear" Click="ClearPicks_Click"/>
                    <Button Grid.Column="2" Style="{StaticResource ST9_ButtonPrimary}" Click="ComparePicked_Click"
                            IsEnabled="{x:Bind ViewModel.CanComparePicked, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8AB;" FontSize="14"/>
                            <TextBlock Text="Compare"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ═════════════════════════════ DETAIL ═════════════════════════════ -->
        <Border x:Name="DetailLayer" Grid.ColumnSpan="2" Visibility="Collapsed"
                Background="{StaticResource STBackground}">
            <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <StackPanel x:Name="DetailRoot" Padding="28,24,28,40" Spacing="16">

                    <!-- Header -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackButton" Style="{StaticResource ST9_IconButton}" VerticalAlignment="Top" Margin="0,2,0,0"
                                Content="&#xE72B;" ToolTipService.ToolTip="Back to sessions (Esc)" Click="CloseDetail_Click"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}" Style="{StaticResource ST9_PageTitle}" FontSize="23"/>
                            <TextBlock Text="{x:Bind ViewModel.DetailSubtitle, Mode=OneWay}" Style="{StaticResource ST9_PageSubtitle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top"
                                    Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Style="{StaticResource ST9_ButtonSubtle}" Click="CompareWith_Click"
                                    IsEnabled="{x:Bind ViewModel.HasStats, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8AB;" FontSize="14"/>
                                    <TextBlock x:Name="CompareWithText" Text="Compare with…"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ST9_IconButton}" Content="&#xE74D;" ToolTipService.ToolTip="Delete this session"
                                    Click="DeleteDetail_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Choose a session to see how it went." Style="{StaticResource ST9_Body}"
                               Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                    <StackPanel x:Name="DetailBody" Spacing="16" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ctrl:ResponsiveGrid x:Name="DetailGrid" Breakpoints="0,980,1600" Columns="1,2,3" ColumnSpacing="16" RowSpacing="16">

                            <!-- Verdict -->
                            <Border Style="{StaticResource ST9_Card}" ctrl:ResponsiveGrid.Span="1,2,1">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Verdict" Style="{StaticResource ST9_CardTitle}"/>
                                        <ctrl:InfoHint Grid.Column="1" Term="Quality Grade" Tip="How the grade is decided."/>
                                        <TextBlock Grid.Column="2" Text="the worst of four checks" Style="{StaticResource ST9_Hint}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid x:Name="VerdictGrid" ColumnSpacing="20" RowSpacing="14" SizeChanged="VerdictGrid_SizeChanged">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel x:Name="VerdictBig" MinWidth="140" MaxWidth="220" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.VerdictLabel, Mode=OneWay}" FontSize="30"
                                                       FontFamily="{StaticResource DMSansSemiBold}"
                                                       Foreground="{x:Bind ViewModel.VerdictFgHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                            <TextBlock Text="{x:Bind ViewModel.VerdictReason, Mode=OneWay}" Style="{StaticResource ST9_Small}"/>
                                            <ItemsControl Margin="0,10,0,0" ItemsSource="{x:Bind ViewModel.DetailCovers, Mode=OneWay}"
                                                          ItemTemplate="{StaticResource CoverMediumTemplate}"
                                                          Visibility="{x:Bind ViewModel.HasDetailCovers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                        <ItemsControl x:Name="VerdictCriteria" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Criteria}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CriterionRow">
                                                    <Grid Padding="0,7" ColumnSpacing="10" BorderBrush="{StaticResource ST9Stroke}" BorderThickness="0,0,0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="1">
                                                            <TextBlock Style="{StaticResource ST9_Body}" Foreground="{StaticResource ST9Text}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                                <Run Text="{x:Bind Name}" FontFamily="{StaticResource DMSansMedium}"/><Run Text="  ·  " Foreground="{StaticResource ST9Text3}"/><Run Text="{x:Bind ValueText}" Foreground="{StaticResource ST9Text2}"/>
                                                            </TextBlock>
                                                            <TextBlock Text="{x:Bind ThresholdText}" Style="{StaticResource ST9_Hint}"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="7,2,7,3" BorderThickness="1"
                                                                Background="{x:Bind GradeBgHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                                BorderBrush="{x:Bind GradeBorderHex, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                                            <TextBlock Text="{x:Bind GradeLabel}" Style="{StaticResource ST9_TagText}"
                                                                       Foreground="{x:Bind GradeFgHex, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    <TextBlock Text="{x:Bind ViewModel.VerdictNote, Mode=OneWay}" Style="{StaticResource ST9_Small}"
                                               Visibility="{x:Bind ViewModel.HasVerdictNote, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Client -->
                            <Border Style="{StaticResource ST9_Card}">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="Client" Style="{StaticResource ST9_CardTitle}"/>
                                        <TextBlock Text="what StreamLight saw" Style="{StaticResource ST9_Hint}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ctrl:ResponsiveGrid MinColumnWidth="120" MaxColumns="4" ColumnSpacing="16" RowSpacing="14">
                                        <StackPanel>
                                            <TextBlock Text="RTT" Style="{StaticResource ST9_Label}"/>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind ViewModel.DetailRtt, Mode=OneWay}" Style="{StaticResource ST9_ValueS}"/><TextBlock Text="ms" Style="{StaticResource ST9_Unit}"/></StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.DetailRttSub, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Jitter" Style="{StaticResource ST9_Label}"/>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind ViewModel.DetailJitter, Mode=OneWay}" Style="{StaticResource ST9_ValueS}"/><TextBlock Text="ms" Style="{StaticResource ST9_Unit}"/></StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.DetailJitterSub, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Drops" Style="{StaticResource ST9_Label}"/>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind ViewModel.DetailDrops, Mode=OneWay}" Style="{StaticResource ST9_ValueS}"/><TextBlock Text="%" Style="{StaticResource ST9_Unit}"/></StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.DetailDropsSub, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Bitrate" Style="{StaticResource ST9_Label}"/>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind ViewModel.DetailBitrate, Mode=OneWay}" Style="{StaticResource ST9_ValueS}"/><TextBlock Text="Mbps" Style="{StaticResource ST9_Unit}"/></StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.DetailBitrateSub, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Decode" Style="{StaticResource ST9_Label}"/>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind ViewModel.DetailDecode, Mode=OneWay}" Style="{StaticResource ST9_ValueS}"/><TextBlock Text="ms" Style="{StaticResource ST9_Unit}"/></StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.DetailDecodeSub, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                        </StackPanel>
                                    </ctrl:ResponsiveGrid>
                                </StackPanel>
                            </Border>

                            <!-- Host -->
                            <Border Style="{StaticResource ST9_Card}">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="Host" Style="{StaticResource ST9_CardTitle}"/>
                                        <TextBlock Text="what this PC did" Style="{StaticResource ST9_Hint}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ctrl:ResponsiveGrid MinColumnWidth="120" MaxColumns="4" ColumnSpacing="16" RowSpacing="14">
                                        <StackPanel>
                                            <TextBlock Text="Codec" Style="{StaticResource ST9_Label}"/>
                                            <TextBlock Text="{x:Bind ViewModel.DetailCodec, Mode=OneWay}" Style="{StaticResource ST9_ValueS}" TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind ViewModel.DetailCodec, Mode=OneWay}"/>
                                            <TextBlock Text="{x:Bind ViewModel.DetailCodecSub, Mode=OneWay}" Style="{StaticResource ST9_Hint}"
                                                       ToolTipService.ToolTip="{x:Bind ViewModel.DetailCodecSub, Mode=OneWay}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Frame latency" Style="{StaticResource ST9_Label}"/>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind ViewModel.DetailHostLat, Mode=OneWay}" Style="{StaticResource ST9_ValueS}"/><TextBlock Text="ms" Style="{StaticResource ST9_Unit}"/></StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.DetailHostLatSub, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Late frames" Style="{StaticResource ST9_Label}"/>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind ViewModel.DetailLate, Mode=OneWay}" Style="{StaticResource ST9_ValueS}"/><TextBlock Text="%" Style="{StaticResource ST9_Unit}"/></StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.DetailLateSub, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="GPU" Style="{StaticResource ST9_Label}"/>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind ViewModel.DetailGpu, Mode=OneWay}" Style="{StaticResource ST9_ValueS}"/><TextBlock Text="%" Style="{StaticResource ST9_Unit}"/></StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.DetailGpuSub, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Encoder" Style="{StaticResource ST9_Label}"/>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind ViewModel.DetailEncoder, Mode=OneWay}" Style="{StaticResource ST9_ValueS}"/><TextBlock Text="{x:Bind ViewModel.DetailEncoderUnit, Mode=OneWay}" Style="{StaticResource ST9_Unit}"/></StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.DetailEncoderSub, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="GPU temp" Style="{StaticResource ST9_Label}"/>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind ViewModel.DetailTemp, Mode=OneWay}" Style="{StaticResource ST9_ValueS}"/><TextBlock Text="°C" Style="{StaticResource ST9_Unit}"/></StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.DetailTempSub, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="CPU" Style="{StaticResource ST9_Label}"/>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind ViewModel.DetailCpu, Mode=OneWay}" Style="{StaticResource ST9_ValueS}"/><TextBlock Text="%" Style="{StaticResource ST9_Unit}"/></StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.DetailCpuSub, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Net TX" Style="{StaticResource ST9_Label}"/>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Bind ViewModel.DetailNetTx, Mode=OneWay}" Style="{StaticResource ST9_ValueS}"/><TextBlock Text="Mbps" Style="{StaticResource ST9_Unit}"/></StackPanel>
                                            <TextBlock Text="average" Style="{StaticResource ST9_Hint}"/>
                                        </StackPanel>
                                    </ctrl:ResponsiveGrid>
                                </StackPanel>
                            </Border>
                        </ctrl:ResponsiveGrid>

                        <!-- Timeline -->
                        <Border x:Name="TimelineCard" Style="{StaticResource ST9_Card}">
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Timeline" Style="{StaticResource ST9_CardTitle}"/>
                                            <ctrl:InfoHint Term="Timeline" Tip="How to read the session timeline."/>
                                        </StackPanel>
                                        <TextBlock x:Name="TimelineHint" Style="{StaticResource ST9_Hint}" TextWrapping="Wrap"
                                                   Text="One clock for every chart · hover to read every value at once · drag across the charts or the strip below to zoom · click a game to zoom to it"/>
                                    </StackPanel>
                                    <Button x:Name="ResetZoomButton" Grid.Column="1" Style="{StaticResource ST9_ButtonGhost}" VerticalAlignment="Top"
                                            Visibility="Collapsed" Click="ResetZoom_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE71F;" FontSize="14"/>
                                            <TextBlock Text="Whole session"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                        <ToggleButton x:Name="TracksChip" Style="{StaticResource ST9_Chip}" Content="All tracks" IsChecked="True" Click="TimelineMode_Click"/>
                                        <ToggleButton x:Name="FocusChip" Style="{StaticResource ST9_Chip}" Content="Focus" Click="TimelineMode_Click"/>
                                        <Button x:Name="FullScreenButton" Style="{StaticResource ST9_IconButton}" Content="&#xE740;" Margin="4,0,0,0"
                                                AutomationProperties.Name="Full screen" ToolTipService.ToolTip="Full screen (Esc to leave)"
                                                Click="TimelineFullScreen_Click"/>
                                    </StackPanel>
                                </Grid>
                                <ctrl:TimelineChart x:Name="Timeline" Session="{x:Bind ViewModel.SelectedSession, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══════════════════════ TIMELINE, FULL SCREEN ══════════════════════
             The Timeline card is moved in here (LogsView.SetTimelineFull) and the window goes
             full screen; its lanes grow to fill the height. -->
        <ScrollViewer x:Name="TimelineFullLayer" Grid.ColumnSpan="2" Visibility="Collapsed"
                      Background="{StaticResource STBackground}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                      SizeChanged="TimelineFullLayer_SizeChanged">
            <Border x:Name="TimelineFullHost" Padding="24"/>
        </ScrollViewer>

        <!-- ═════════════════════════════ COMPARE ═════════════════════════════ -->
        <Grid x:Name="CompareLayer" Grid.ColumnSpan="2" Background="{StaticResource STBackground}"
              Visibility="{x:Bind ViewModel.IsCompareVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <StackPanel x:Name="CompareRoot" Padding="32,24,32,40" Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource ST9_IconButton}" VerticalAlignment="Top" Margin="0,2,0,0"
                                Content="&#xE72B;" ToolTipService.ToolTip="Back to sessions (Esc)" Click="CloseCompare_Click"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Style="{StaticResource ST9_PageTitle}" FontSize="23">
                                <Run Text="Sessions" Foreground="{StaticResource ST9Text3}"/><Run Text="  ›  " Foreground="{StaticResource ST9Text4}"/><Run Text="Compare"/>
                            </TextBlock>
                            <TextBlock Text="Session 1 read against session 2. Green means session 1 did better, red that it did worse; load figures are context and stay grey."
                                       Style="{StaticResource ST9_PageSubtitle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="At least two sessions with telemetry are needed to compare." Style="{StaticResource ST9_Body}"
                               Visibility="{x:Bind ViewModel.HasTwoCandidates, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                    <ctrl:ResponsiveGrid Breakpoints="0,1000" Columns="1,2" ColumnSpacing="16" RowSpacing="16"
                                         Visibility="{x:Bind ViewModel.HasTwoCandidates, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Session 1 -->
                        <Border Style="{StaticResource ST9_Card}" Padding="16,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CompareCoversA, Mode=OneWay}" ItemTemplate="{StaticResource CoverMediumTemplate}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Session 1" Style="{StaticResource ST9_Label}"/>
                                    <ComboBox HorizontalAlignment="Stretch" ItemTemplate="{StaticResource SessionComboTemplate}"
                                              ItemsSource="{x:Bind ViewModel.CompareCandidatesA, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.CompareA, Mode=TwoWay}"
                                              SelectionChanged="CompareSelection_Changed"/>
                                    <TextBlock Text="{x:Bind ViewModel.CompareSubA, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Top" CornerRadius="4" Padding="7,2,7,3"
                                        Background="{x:Bind ViewModel.CompareGradeABg, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                    <TextBlock Text="{x:Bind ViewModel.CompareGradeA, Mode=OneWay}" Style="{StaticResource ST9_TagText}"
                                               Foreground="{x:Bind ViewModel.CompareGradeAFg, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Session 2 -->
                        <Border Style="{StaticResource ST9_Card}" Padding="16,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CompareCoversB, Mode=OneWay}" ItemTemplate="{StaticResource CoverMediumTemplate}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Session 2" Style="{StaticResource ST9_Label}"/>
                                    <ComboBox HorizontalAlignment="Stretch" ItemTemplate="{StaticResource SessionComboTemplate}"
                                              ItemsSource="{x:Bind ViewModel.CompareCandidatesB, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.CompareB, Mode=TwoWay}"
                                              SelectionChanged="CompareSelection_Changed"/>
                                    <TextBlock Text="{x:Bind ViewModel.CompareSubB, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Top" CornerRadius="4" Padding="7,2,7,3"
                                        Background="{x:Bind ViewModel.CompareGradeBBg, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                    <TextBlock Text="{x:Bind ViewModel.CompareGradeB, Mode=OneWay}" Style="{StaticResource ST9_TagText}"
                                               Foreground="{x:Bind ViewModel.CompareGradeBFg, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Client table -->
                        <Border Style="{StaticResource ST9_Card}" Padding="0,14,0,4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,16,10">
                                    <TextBlock Text="Client" Style="{StaticResource ST9_CardTitle}"/>
                                    <TextBlock Text="StreamLight" Style="{StaticResource ST9_Hint}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Padding="16,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="112"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Metric" Style="{StaticResource ST9_Label}"/>
                                    <TextBlock Grid.Column="1" Text="Session 1" Style="{StaticResource ST9_Label}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="Session 2" Style="{StaticResource ST9_Label}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="Δ 1 vs 2" Style="{StaticResource ST9_Label}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CompareClientMetrics}" ItemTemplate="{StaticResource CompareRowTemplate}"/>
                            </StackPanel>
                        </Border>
                        <!-- Host table -->
                        <Border Style="{StaticResource ST9_Card}" Padding="0,14,0,4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,16,10">
                                    <TextBlock Text="Host" Style="{StaticResource ST9_CardTitle}"/>
                                    <TextBlock Text="StreamTweak" Style="{StaticResource ST9_Hint}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Padding="16,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="112"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Metric" Style="{StaticResource ST9_Label}"/>
                                    <TextBlock Grid.Column="1" Text="Session 1" Style="{StaticResource ST9_Label}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="Session 2" Style="{StaticResource ST9_Label}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="Δ 1 vs 2" Style="{StaticResource ST9_Label}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CompareHostMetrics}" ItemTemplate="{StaticResource CompareRowTemplate}"/>
                            </StackPanel>
                        </Border>
                    </ctrl:ResponsiveGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
