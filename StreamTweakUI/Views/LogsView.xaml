<Page
    x:Class="StreamTweak.Views.LogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:StreamTweak.Controls"
    xmlns:vm="using:StreamTweak.ViewModels"
    Background="{StaticResource STBackground}">

    <!--
        Three solid layers stacked in the root Grid.
        Layer 1 — Session list (always rendered)
        Layer 2 — Session detail (covers layer 1 when visible)
        Layer 3 — Fullscreen chart (covers layers 1+2 when visible)
    -->
    <Grid SizeChanged="Root_SizeChanged">

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- LAYER 1 — Session list                                            -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- page header -->
                <RowDefinition Height="*"/>      <!-- card -->
            </Grid.RowDefinitions>

            <!-- Page header -->
            <Grid Grid.Row="0" Margin="28,24,28,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Session History"
                           Style="{StaticResource ST_PageTitle}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="Compare"
                            Style="{StaticResource ST_ButtonSecondary}"
                            Click="Compare_Click"/>
                    <Button Content="Clear history"
                            Style="{StaticResource ST_ButtonDanger}"
                            Click="ClearHistory_Click"/>
                </StackPanel>
            </Grid>

            <!-- Main card -->
            <Border Grid.Row="1"
                    Margin="28,16,28,28"
                    Style="{StaticResource ST_CardNoPad}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- column headers -->
                        <RowDefinition Height="*"/>      <!-- list or empty state -->
                    </Grid.RowDefinitions>

                    <!-- Column header bar -->
                    <Grid Grid.Row="0"
                          Padding="20,0"
                          MinHeight="36"
                          Background="{StaticResource STInput}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>    <!-- accent bar -->
                            <ColumnDefinition Width="16"/>   <!-- gap -->
                            <ColumnDefinition Width="2.5*"/> <!-- date/time -->
                            <ColumnDefinition Width="1*"/>   <!-- duration -->
                            <ColumnDefinition Width="1*"/>   <!-- rtt avg -->
                            <ColumnDefinition Width="1*"/>   <!-- drops % -->
                            <ColumnDefinition Width="1.5*"/> <!-- quality -->
                            <ColumnDefinition Width="2*"/>   <!-- games covers -->
                            <ColumnDefinition Width="68"/>   <!-- actions -->
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="Date / Time"
                                   Style="{StaticResource ST_SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Duration"
                                   Style="{StaticResource ST_SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="RTT avg"
                                   Style="{StaticResource ST_SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="Drops %"
                                   Style="{StaticResource ST_SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="Quality"
                                   Style="{StaticResource ST_SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="Games"
                                   Style="{StaticResource ST_SectionLabel}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Separator under column headers -->
                    <Border Grid.Row="0"
                            Style="{StaticResource ST_Separator}"
                            VerticalAlignment="Bottom"/>

                    <!-- Session list -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Sessions}"
                              SelectionMode="None"
                              Padding="0"
                              Visibility="{x:Bind ViewModel.HasSessions, Mode=OneWay,
                                           Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"
                                   BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="StreamTweak:SessionEntry"
                                          xmlns:StreamTweak="using:StreamTweak">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                    </Grid.RowDefinitions>

                                    <!-- Bottom separator -->
                                    <Border Grid.Row="1"
                                            Style="{StaticResource ST_Separator}"/>

                                    <!-- Row content -->
                                    <Grid Grid.Row="0" Padding="20,0" MinHeight="56">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="68"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left accent bar (grade color) -->
                                        <Rectangle Grid.Column="0"
                                                   Width="3"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Stretch"
                                                   RadiusX="1.5" RadiusY="1.5"
                                                   Margin="0,10"
                                                   Fill="{x:Bind GradeColorHex,
                                                          Converter={StaticResource HexToSolidColorBrushConverter}}"/>

                                        <!-- Date / Time -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind StartTimeDisplay}"
                                                   Style="{StaticResource ST_Body}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind DurationDisplay}"
                                                   Style="{StaticResource ST_MonoValueSmall}"
                                                   VerticalAlignment="Center"/>

                                        <!-- RTT avg -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{x:Bind RttAvgDisplay}"
                                                   Style="{StaticResource ST_MonoValueSmall}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Drops % -->
                                        <TextBlock Grid.Column="5"
                                                   Text="{x:Bind DropRateDisplay}"
                                                   Style="{StaticResource ST_MonoValueSmall}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Quality pill — stesso stile tile della Home -->
                                        <Border Grid.Column="6"
                                                CornerRadius="4"
                                                BorderThickness="1"
                                                Padding="8,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{x:Bind GradeBgHex,
                                                             Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                BorderBrush="{x:Bind GradeBorderHex,
                                                              Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                Visibility="{x:Bind HasGrade,
                                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind GradeShortLabel}"
                                                       Style="{StaticResource ST_BadgeText}"
                                                       FontSize="12"
                                                       Foreground="{x:Bind GradeColorHex,
                                                                    Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Games covers strip -->
                                        <ItemsControl Grid.Column="7"
                                                      ItemsSource="{x:Bind GameCoversForDisplay}"
                                                      VerticalAlignment="Center"
                                                      Visibility="{x:Bind HasGamesDetected,
                                                                   Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="3"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="StreamTweak:GameCoverItem">
                                                    <Border Width="33" Height="50"
                                                            CornerRadius="4"
                                                            Background="{StaticResource STBackground}"
                                                            ToolTipService.ToolTip="{x:Bind Name}">
                                                        <!-- UniformToFill + centred: the tile is 2:3 but store art is not
                                                             always (Epic covers in particular), and merely fitting it left
                                                             visible empty bands above and below. Filling crops the overflow
                                                             instead — the Border's CornerRadius clips it. Same as Library. -->
                                                        <Image Source="{x:Bind CoverPath, Converter={StaticResource CoverPathToBitmapConverter}}"
                                                               Stretch="UniformToFill"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- No games fallback -->
                                        <TextBlock Grid.Column="7"
                                                   Text="No games detected"
                                                   Style="{StaticResource ST_RowDescription}"
                                                   FontStyle="Italic"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind HasNoGamesDetected,
                                                                Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="8"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="4">

                                            <Button Style="{StaticResource ST_ButtonGhost}"
                                                    Width="30" Height="30" Padding="0"
                                                    FontSize="14"
                                                    Content="&#xE9F9;"
                                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                    Click="DetailButton_Click"
                                                    Visibility="{x:Bind HasGrade,
                                                                 Converter={StaticResource BoolToVisibilityConverter}}"
                                                    AutomationProperties.Name="View session detail"
                                                    ToolTipService.ToolTip="View session detail"/>

                                            <Button Style="{StaticResource ST_ButtonGhost}"
                                                    Width="30" Height="30" Padding="0"
                                                    FontSize="13"
                                                    Content="&#xE74D;"
                                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                    Click="DeleteSession_Click"
                                                    AutomationProperties.Name="Delete this session"
                                                    ToolTipService.ToolTip="Delete this session"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="{x:Bind ViewModel.HasSessions, Mode=OneWay,
                                             Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE9F9;"
                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  FontSize="36"
                                  Foreground="{StaticResource STTextDim}"/>
                        <TextBlock Text="No sessions recorded yet"
                                   Style="{StaticResource ST_RowDescription}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>


        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- LAYER 2 — Session detail                                          -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{x:Bind ViewModel.IsDetailVisible, Mode=OneWay,
                            Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#E6111010">

            <Border Margin="28,16,28,28"
                    Style="{StaticResource ST_CardNoPad}">

                <Grid Margin="20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- header (fixed) -->
                        <RowDefinition Height="*"/>      <!-- scrollable body -->
                        <RowDefinition Height="Auto"/>   <!-- grade bar (fixed) -->
                    </Grid.RowDefinitions>

                    <!-- ── Row 0: Header (title · session covers · close) ──── -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Session Detail"
                                       Style="{StaticResource ST_PageTitle}"/>
                            <TextBlock Text="{x:Bind ViewModel.DetailHeaderSubtitle, Mode=OneWay}"
                                       Style="{StaticResource ST_PageSubtitle}"/>
                        </StackPanel>

                        <!-- Covers of the games launched in this session, inline by the title -->
                        <ScrollViewer Grid.Column="1"
                                      Margin="20,0,12,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      HorizontalScrollMode="Auto"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      Visibility="{x:Bind ViewModel.HasDetailGameCovers, Mode=OneWay,
                                                   Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DetailGameCovers, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SessionGameCover">
                                        <Border Width="34" Height="50" CornerRadius="4"
                                                Background="{StaticResource STBackground}"
                                                ToolTipService.ToolTip="{x:Bind GameName}">
                                            <Grid>
                                                <Image Source="{x:Bind CoverImage, Mode=OneWay}" Stretch="UniformToFill"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{x:Bind HasNoCover, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                <TextBlock Text="{x:Bind GameName}"
                                                           FontSize="7" TextWrapping="Wrap" TextAlignment="Center"
                                                           Foreground="{StaticResource STTextDim}"
                                                           Margin="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Visibility="{x:Bind HasNoCover, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Column="2"
                                Style="{StaticResource ST_ButtonGhost}"
                                Content="&#xE711;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14" Width="32" Height="32" Padding="0"
                                VerticalAlignment="Top"
                                Click="CloseDetail_Click"
                                ToolTipService.ToolTip="Close (Esc)"/>
                    </Grid>

                    <!-- ── Row 1: Scrollable body (stats + charts + games) ── -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollMode="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled"
                                  Padding="0,0,12,0">
                    <StackPanel>

                    <!-- ── Separator ─────────────────────────────────────── -->
                    <Border Style="{StaticResource ST_Separator}"
                            Margin="0,0,0,14"/>

                    <!-- ── Stats panels (CLIENT | HOST) ───────────────────── -->
                    <Grid ColumnSpacing="12" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CLIENT box -->
                        <Border Grid.Column="0"
                                Background="#FA111010"
                                BorderBrush="{StaticResource STBorder}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="16,14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="CLIENT  (StreamLight)"
                                           Style="{StaticResource ST_SectionLabel}"/>

                                <!-- Two metric columns: label · primary value · dim secondary -->
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="RTT" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DetailRttAvg, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DetailRttMax, Mode=OneWay}" Style="{StaticResource ST_MonoValueDim}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Drops" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DetailDropRate, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DetailDrops, Mode=OneWay}" Style="{StaticResource ST_MonoValueDim}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Bitrate" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DetailBitrateAvg, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Jitter" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DetailJitterAvg, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DetailJitterMax, Mode=OneWay}" Style="{StaticResource ST_MonoValueDim}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Decode" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DetailDecodeAvg, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- HOST box -->
                        <Border Grid.Column="1"
                                Background="#FA111010"
                                BorderBrush="{StaticResource STBorder}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="16,14"
                                Visibility="{x:Bind ViewModel.HasHostStats, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="HOST  (StreamTweak)"
                                           Style="{StaticResource ST_SectionLabel}"/>

                                <!-- Two metric columns: label · primary value · dim secondary -->
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="GPU" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DetailHostGpu, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DetailHostGpuSec, Mode=OneWay}" Style="{StaticResource ST_MonoValueDim}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="GPU Temp" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DetailHostTemp, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DetailHostTempSec, Mode=OneWay}" Style="{StaticResource ST_MonoValueDim}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Net TX" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DetailHostNetTx, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Encoder" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DetailHostEncoder, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DetailHostEncoderSec, Mode=OneWay}" Style="{StaticResource ST_MonoValueDim}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="CPU" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DetailHostCpu, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DetailHostCpuSec, Mode=OneWay}" Style="{StaticResource ST_MonoValueDim}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Frame latency" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DetailHostLatency, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DetailHostLatencySec, Mode=OneWay}" Style="{StaticResource ST_MonoValueDim}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ── Separator ─────────────────────────────────────── -->
                    <Border Style="{StaticResource ST_Separator}"
                            Margin="0,0,0,10"/>

                    <!-- ── Charts section header ──────────────────────────── -->
                    <StackPanel Orientation="Horizontal" Spacing="10"
                                Margin="0,0,0,10"
                                Visibility="{x:Bind ViewModel.HasChartData, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="CLIENT CHARTS"
                                   Style="{StaticResource ST_SectionLabel}"/>
                        <TextBlock Text="(click to expand)"
                                   Style="{StaticResource ST_RowDescription}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- ── Charts (single scrollable column) ──────────────── -->
                    <Border Background="#FA111010"
                            CornerRadius="8"
                            Padding="12"
                            Visibility="{x:Bind ViewModel.HasChartData, Mode=OneWay,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Single column, full-width. Each chart's height tracks the
                             window size (185 → 225 → 280 px) via ViewModel.DetailChartHeight,
                             set from the page SizeChanged handler. The whole body scrolls. -->
                        <StackPanel Spacing="12">
                            <Grid Height="{x:Bind ViewModel.DetailChartHeight, Mode=OneWay}"
                                  Tapped="RttChart_Tapped"
                                  ToolTipService.ToolTip="Click to expand">
                                <ctl:SparklineControl
                                    Title="RTT ms"
                                    LineColor="#FFFFA726"
                                    EnvelopeMode="True"
                                    Data="{x:Bind ViewModel.RttSeries, Mode=OneWay}"
                                    DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                            </Grid>

                            <Grid Height="{x:Bind ViewModel.DetailChartHeight, Mode=OneWay}"
                                  Tapped="DropsChart_Tapped"
                                  ToolTipService.ToolTip="Click to expand">
                                <ctl:SparklineControl
                                    Title="Frame Drops"
                                    LineColor="#FFEF5350"
                                    Data="{x:Bind ViewModel.DropsSeries, Mode=OneWay}"
                                    DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                            </Grid>

                            <Grid Height="{x:Bind ViewModel.DetailChartHeight, Mode=OneWay}"
                                  Tapped="BitrateChart_Tapped"
                                  ToolTipService.ToolTip="Click to expand">
                                <ctl:SparklineControl
                                    Title="Bitrate Mbps"
                                    LineColor="#FF26C6DA"
                                    Data="{x:Bind ViewModel.BitrateSeries, Mode=OneWay}"
                                    DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                            </Grid>

                            <Grid Height="{x:Bind ViewModel.DetailChartHeight, Mode=OneWay}"
                                  Tapped="DecodeChart_Tapped"
                                  ToolTipService.ToolTip="Click to expand">
                                <ctl:SparklineControl
                                    Title="Decode ms"
                                    LineColor="#FFAB47BC"
                                    Data="{x:Bind ViewModel.DecodeSeries, Mode=OneWay}"
                                    DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                            </Grid>

                            <!-- Host frame-processing latency (capture+encode) — the most
                                 direct "host kept up?" signal, with a min/max band so a
                                 single-frame spike stays visible. -->
                            <Grid Height="{x:Bind ViewModel.DetailChartHeight, Mode=OneWay}"
                                  Tapped="HostLatencyChart_Tapped"
                                  ToolTipService.ToolTip="Click to expand">
                                <ctl:SparklineControl
                                    Title="Host frame latency ms"
                                    LineColor="#FF66BB6A"
                                    EnvelopeMode="True"
                                    Data="{x:Bind ViewModel.HostLatencySeries, Mode=OneWay}"
                                    DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                            </Grid>

                            <!-- Host compute %: GPU / Encoder / CPU overlaid on a shared
                                 0–100% scale with a legend. -->
                            <Grid Height="{x:Bind ViewModel.DetailChartHeight, Mode=OneWay}"
                                  Tapped="HostComputeChart_Tapped"
                                  ToolTipService.ToolTip="Click to expand"
                                  Visibility="{x:Bind ViewModel.HasHostComputeChart, Mode=OneWay,
                                               Converter={StaticResource BoolToVisibilityConverter}}">
                                <ctl:SparklineControl
                                    Title="Host compute %"
                                    LinesData="{x:Bind ViewModel.HostComputeLines, Mode=OneWay}"
                                    DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    </StackPanel>
                    </ScrollViewer>

                    <!-- ── Row 2: Grade bar (fixed footer) ────────────────── -->
                    <Border Grid.Row="2"
                            Margin="0,14,0,0"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,10"
                            BorderBrush="{x:Bind ViewModel.GradeColorHex, Mode=OneWay,
                                         Converter={StaticResource HexToSolidColorBrushConverter}}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="10">
                            <Ellipse Width="10" Height="10"
                                     VerticalAlignment="Center"
                                     Fill="{x:Bind ViewModel.GradeColorHex, Mode=OneWay,
                                            Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                            <TextBlock Style="{StaticResource ST_RowLabel}"
                                       VerticalAlignment="Center">
                                <Run Text="Streaming quality — "/>
                                <Run Text="{x:Bind ViewModel.GradeLabel, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>


        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- LAYER 3 — Fullscreen chart                                        -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{x:Bind ViewModel.IsChartFullscreen, Mode=OneWay,
                            Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#E6111010">

            <Border Margin="28,16,28,28"
                    Style="{StaticResource ST_CardNoPad}">

                <Grid Margin="20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.FullscreenChartTitle, Mode=OneWay}"
                                       Style="{StaticResource ST_PageTitle}"/>
                            <TextBlock Text="{x:Bind ViewModel.DetailHeaderSubtitle, Mode=OneWay}"
                                       Style="{StaticResource ST_PageSubtitle}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource ST_ButtonGhost}"
                                Content="&#xE711;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14" Width="32" Height="32" Padding="0"
                                VerticalAlignment="Top"
                                Click="CloseFullscreen_Click"
                                ToolTipService.ToolTip="Close (Esc)"/>
                    </Grid>

                    <Border Grid.Row="1"
                            Style="{StaticResource ST_Separator}"
                            Margin="0,0,0,14"/>

                    <ctl:SparklineControl
                        Grid.Row="2"
                        Title=""
                        Data="{x:Bind ViewModel.FullscreenChartData, Mode=OneWay}"
                        LinesData="{x:Bind ViewModel.FullscreenChartLines, Mode=OneWay}"
                        LineColor="{x:Bind ViewModel.FullscreenLineColor, Mode=OneWay}"
                        DurationLabel="{x:Bind ViewModel.DetailDuration, Mode=OneWay}"/>
                </Grid>
            </Border>
        </Grid>


        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- LAYER 4 — Compare sessions                                        -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{x:Bind ViewModel.IsCompareVisible, Mode=OneWay,
                            Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#E6111010">

            <Border Margin="28,16,28,28"
                    Style="{StaticResource ST_CardNoPad}">

                <Grid Margin="20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- header -->
                        <RowDefinition Height="Auto"/>   <!-- session pickers -->
                        <RowDefinition Height="Auto"/>   <!-- separator -->
                        <RowDefinition Height="*"/>      <!-- scrollable body -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Compare Sessions" Style="{StaticResource ST_PageTitle}"/>
                            <TextBlock Text="Pick two recorded sessions to compare side by side."
                                       Style="{StaticResource ST_PageSubtitle}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource ST_ButtonGhost}"
                                Content="&#xE711;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14" Width="32" Height="32" Padding="0"
                                VerticalAlignment="Top"
                                Click="CloseCompare_Click"
                                ToolTipService.ToolTip="Close (Esc)"/>
                    </Grid>

                    <!-- Session pickers (two dropdowns on one row) -->
                    <Grid Grid.Row="1" Margin="0,0,0,14" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                         Fill="{x:Bind ViewModel.CompareColorAHex, Mode=OneWay,
                                                Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                <TextBlock Text="Session 1" Style="{StaticResource ST_SectionLabel}"/>
                            </StackPanel>
                            <!-- Covers of the games launched in Session 1 -->
                            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollMode="Disabled" HorizontalAlignment="Left"
                                          Visibility="{x:Bind ViewModel.HasCompareCoversA, Mode=OneWay,
                                                       Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CompareCoversA, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="34" Height="50" CornerRadius="4"
                                                    Background="{StaticResource STBackground}"
                                                    ToolTipService.ToolTip="{Binding GameName}">
                                                <Grid>
                                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasNoCover, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding GameName}" FontSize="7" TextWrapping="Wrap" TextAlignment="Center"
                                                               Foreground="{StaticResource STTextDim}" Margin="2"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                                               Visibility="{Binding HasNoCover, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.CompareCandidatesA, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.CompareA, Mode=TwoWay}"
                                      SelectionChanged="CompareSelection_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding StartTimeDisplay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding TelemetryDurationDisplay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                         Fill="{x:Bind ViewModel.CompareColorBHex, Mode=OneWay,
                                                Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                <TextBlock Text="Session 2" Style="{StaticResource ST_SectionLabel}"/>
                            </StackPanel>
                            <!-- Covers of the games launched in Session 2 -->
                            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollMode="Disabled" HorizontalAlignment="Left"
                                          Visibility="{x:Bind ViewModel.HasCompareCoversB, Mode=OneWay,
                                                       Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CompareCoversB, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="34" Height="50" CornerRadius="4"
                                                    Background="{StaticResource STBackground}"
                                                    ToolTipService.ToolTip="{Binding GameName}">
                                                <Grid>
                                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasNoCover, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding GameName}" FontSize="7" TextWrapping="Wrap" TextAlignment="Center"
                                                               Foreground="{StaticResource STTextDim}" Margin="2"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                                               Visibility="{Binding HasNoCover, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.CompareCandidatesB, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.CompareB, Mode=TwoWay}"
                                      SelectionChanged="CompareSelection_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding StartTimeDisplay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding TelemetryDurationDisplay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Separator -->
                    <Border Grid.Row="2" Style="{StaticResource ST_Separator}" Margin="0,0,0,14"/>

                    <!-- Scrollable body -->
                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollMode="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled"
                                  Padding="0,0,12,0">
                        <StackPanel>

                            <!-- Empty / not-enough-data hint -->
                            <TextBlock Text="Select two sessions with recorded telemetry to compare."
                                       Style="{StaticResource ST_RowDescription}"
                                       HorizontalAlignment="Center"
                                       Margin="0,30,0,0"
                                       Visibility="{x:Bind ViewModel.HasCompareData, Mode=OneWay,
                                                    Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                            <StackPanel Visibility="{x:Bind ViewModel.HasCompareData, Mode=OneWay,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">

                                <!-- Stats panels (CLIENT | HOST) -->
                                <Grid ColumnSpacing="12" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#FA111010"
                                            BorderBrush="{StaticResource STBorder}"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="16,14">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="CLIENT  (StreamLight)"
                                                       Style="{StaticResource ST_SectionLabel}"/>
                                            <!-- column key -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="74"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="Session 1" FontSize="10"
                                                           Foreground="{x:Bind ViewModel.CompareColorAHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                                <TextBlock Grid.Column="2" Text="Session 2" FontSize="10"
                                                           Foreground="{x:Bind ViewModel.CompareColorBHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                                <TextBlock Grid.Column="3" Text="&#x0394;" FontSize="10"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource STTextDim}"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.CompareClientMetrics, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="92"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="74"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                       Style="{StaticResource ST_RowDescription}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ValueA}"
                                                                       Style="{StaticResource ST_MonoValueSmall}"
                                                                       Foreground="#FF26C6DA" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding ValueB}"
                                                                       Style="{StaticResource ST_MonoValueSmall}"
                                                                       Foreground="#FFFFA726" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Delta}"
                                                                       Style="{StaticResource ST_MonoValueSmall}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{Binding DeltaColorHex, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Background="#FA111010"
                                            BorderBrush="{StaticResource STBorder}"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="16,14">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="HOST  (StreamTweak)"
                                                       Style="{StaticResource ST_SectionLabel}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="74"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="Session 1" FontSize="10"
                                                           Foreground="{x:Bind ViewModel.CompareColorAHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                                <TextBlock Grid.Column="2" Text="Session 2" FontSize="10"
                                                           Foreground="{x:Bind ViewModel.CompareColorBHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                                <TextBlock Grid.Column="3" Text="&#x0394;" FontSize="10"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource STTextDim}"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.CompareHostMetrics, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="92"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="74"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                       Style="{StaticResource ST_RowDescription}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ValueA}"
                                                                       Style="{StaticResource ST_MonoValueSmall}"
                                                                       Foreground="#FF26C6DA" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding ValueB}"
                                                                       Style="{StaticResource ST_MonoValueSmall}"
                                                                       Foreground="#FFFFA726" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Delta}"
                                                                       Style="{StaticResource ST_MonoValueSmall}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       Foreground="{Binding DeltaColorHex, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Charts header -->
                                <TextBlock Text="COMPARISON CHARTS"
                                           Style="{StaticResource ST_SectionLabel}"
                                           Margin="0,0,0,10"/>

                                <!-- Charts (single column, both sessions per chart + legend) -->
                                <Border Background="#FA111010" CornerRadius="8" Padding="12">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.CompareCharts, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="12"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ctl:SparklineControl
                                                    Height="{Binding Height}"
                                                    Title="{Binding Title}"
                                                    LinesData="{Binding Lines}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    </Grid>

</Page>
