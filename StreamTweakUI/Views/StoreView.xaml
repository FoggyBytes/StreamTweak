<Page
    x:Class="StreamTweak.Views.StoreView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource STBackground}"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Icon-only ghost button for the toolbar: square, no border, transparent bg -->
        <Style x:Key="ST_ToolbarIconButton" TargetType="Button">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Foreground"      Value="{StaticResource STTextSecondary}"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── TOOLBAR ──────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource STCard}"
                BorderBrush="{StaticResource STBorder}"
                BorderThickness="0,0,0,1"
                Padding="10,5">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back / Forward / Home -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center">

                    <Button x:Name="BackButton"
                            Style="{StaticResource ST_ToolbarIconButton}"
                            IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                            Click="BackButton_Click"
                            ToolTipService.ToolTip="Back">
                        <FontIcon Glyph="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>

                    <Button x:Name="ForwardButton"
                            Style="{StaticResource ST_ToolbarIconButton}"
                            IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}"
                            Click="ForwardButton_Click"
                            ToolTipService.ToolTip="Forward">
                        <FontIcon Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>

                    <!-- Home button: uses the official Instant Gaming logo as icon -->
                    <Button x:Name="HomeButton"
                            Height="32"
                            Padding="8,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="6"
                            Click="HomeButton_Click"
                            ToolTipService.ToolTip="Instant Gaming home">
                        <Image Height="14" Stretch="Uniform">
                            <Image.Source>
                                <SvgImageSource UriSource="ms-appx:///Resources/instant-gaming-logo.svg"
                                                RasterizePixelHeight="28"/>
                            </Image.Source>
                        </Image>
                    </Button>

                </StackPanel>

                <!-- Open in browser -->
                <Button Grid.Column="2"
                        Style="{StaticResource ST_ToolbarIconButton}"
                        Click="OpenInBrowserButton_Click"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Open in browser">
                    <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </Button>

            </Grid>
        </Border>

        <!-- ── ERROR BANNER ─────────────────────────────────────────────────
             Shown when WebView2 fails to initialize (runtime missing, conflict,
             permission error). Hidden by default; made visible in code-behind
             on exception so the user can see the real error message. -->
        <InfoBar Grid.Row="1"
                 x:Name="WebView2ErrorBar"
                 Title="Store unavailable"
                 Severity="Error"
                 IsClosable="True"
                 IsOpen="False"
                 BorderThickness="0,0,0,1"
                 CornerRadius="0"/>

        <!-- ── INFO BANNER ──────────────────────────────────────────────────
             One-time notice explaining that Facebook / Google / Apple sign-in
             options are hidden because those providers block embedded browsers.
             User dismissal is persisted in config.json (StoreOAuthNoticeDismissed)
             via StoreViewModel.DismissOAuthNotice(), so the banner never reappears
             once closed. -->
        <InfoBar Grid.Row="2"
                 Title="Facebook / Google / Apple sign-in not available"
                 Message="These providers block sign-in from embedded browsers for security reasons. If your Instant Gaming account uses one of them, click the open-in-browser icon (top right) to open the site in your system browser and sign in there."
                 Severity="Informational"
                 IsClosable="True"
                 IsOpen="{x:Bind ViewModel.IsOAuthNoticeVisible, Mode=OneWay}"
                 CloseButtonClick="OAuthNotice_CloseButtonClick"
                 Margin="0,0,0,0"
                 BorderThickness="0,0,0,1"
                 CornerRadius="0"/>

        <!-- ── WEBVIEW2 ──────────────────────────────────────────────────── -->
        <WebView2 Grid.Row="3" x:Name="StoreWebView"/>

    </Grid>
</Page>
