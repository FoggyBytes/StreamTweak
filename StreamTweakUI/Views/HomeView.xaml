<Page
    x:Class="StreamTweak.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StreamTweak.ViewModels"
    xmlns:ctrl="using:StreamTweak.Controls"
    Background="{StaticResource STBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Padding="28,20,28,20">

            <!-- ═══════════════════════════════════════════════════════════════
                 SESSION CARD — mostra stato live o ultima sessione
            ════════════════════════════════════════════════════════════════ -->
            <Border x:Name="SessionCard"
                    Background="{StaticResource STCard}"
                    BorderBrush="{StaticResource STBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="0">

                    <!-- ── Header row ────────────────────────────────────────── -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Label + host inline -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Streaming Session"
                                       FontFamily="{StaticResource DMSansSemiBold}"
                                       FontSize="11"
                                       Foreground="{StaticResource STTextDim}"
                                       CharacterSpacing="80"
                                       VerticalAlignment="Center"/>

                            <!-- Host separator + name (hidden when no host) -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.HasStreamHost, Mode=OneWay,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="·"
                                           FontSize="12"
                                           Foreground="{StaticResource STBorderSubtle}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Host"
                                           FontFamily="{StaticResource DMSans}"
                                           FontSize="12"
                                           Foreground="{StaticResource STTextDim}"
                                           VerticalAlignment="Center"/>
                                <Image Source="{x:Bind ViewModel.StreamHostIcon, Mode=OneWay}"
                                       Width="14" Height="14"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.HasStreamHostIcon, Mode=OneWay,
                                                    Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <FontIcon Glyph="&#xE774;" FontSize="13" Opacity="0.7"
                                          VerticalAlignment="Center"
                                          Visibility="{x:Bind ViewModel.HasStreamHostIcon, Mode=OneWay,
                                                       Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <TextBlock Text="{x:Bind ViewModel.StreamHostName, Mode=OneWay}"
                                           FontFamily="{StaticResource DMSans}"
                                           FontSize="12"
                                           Foreground="{StaticResource STTextSecondary}"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Status dot + label (right side) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Spacing="7" VerticalAlignment="Center">
                            <!-- Pulse ring + dot (active only) -->
                            <Grid Width="14" Height="14"
                                  Visibility="{x:Bind ViewModel.IsSessionActive, Mode=OneWay,
                                               Converter={StaticResource BoolToVisibilityConverter}}">
                                <Ellipse x:Name="PulseRing"
                                         Width="14" Height="14"
                                         Fill="#5922c55e"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Ellipse.Resources>
                                        <Storyboard x:Name="PulseStoryboard"
                                                    RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="SessionDot"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="1.0" To="0.5"
                                                             Duration="0:0:0.9"/>
                                            <DoubleAnimation Storyboard.TargetName="PulseRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.5" To="0"
                                                             Duration="0:0:0.9"/>
                                        </Storyboard>
                                    </Ellipse.Resources>
                                </Ellipse>
                                <Ellipse x:Name="SessionDot"
                                         Width="7" Height="7"
                                         Fill="#22c55e"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Inactive dot -->
                            <Ellipse Width="7" Height="7" Fill="#444444"
                                     VerticalAlignment="Center"
                                     Visibility="{x:Bind ViewModel.IsSessionActive, Mode=OneWay,
                                                  Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                            <TextBlock x:Name="SessionStatusText"
                                       Text="Inactive"
                                       FontFamily="{StaticResource DMSans}"
                                       FontSize="12"
                                       Foreground="{StaticResource STTextDim}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- ── Separator ──────────────────────────────────────────── -->
                    <Border Style="{StaticResource ST_Separator}" Margin="0,0,0,14"/>

                    <!-- ── EMPTY STATE: nessuna sessione registrata ──────────── -->
                    <StackPanel Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="6"
                                Padding="0,8">
                        <FontIcon Glyph="&#xE9F9;" FontSize="22"
                                  Foreground="{StaticResource STTextGhost}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Real-time session data and your last completed stream will appear here."
                                   FontFamily="{StaticResource DMSans}"
                                   FontSize="12"
                                   Foreground="{StaticResource STTextDim}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"/>
                    </StackPanel>

                    <!-- ── INACTIVE: ultima sessione ─────────────────────────── -->
                    <Grid Visibility="{x:Bind ViewModel.ShowLastSession, Mode=OneWay,
                                       Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Col 0: date + duration + stats + grade badge -->
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Last Session"
                                       FontFamily="{StaticResource DMSansSemiBold}"
                                       FontSize="11"
                                       Foreground="{StaticResource STTextDim}"
                                       CharacterSpacing="60"/>
                            <TextBlock Text="{x:Bind ViewModel.LastSessionDate, Mode=OneWay}"
                                       Style="{StaticResource ST_MonoMedium}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Duration"
                                           Style="{StaticResource ST_BodySmall}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.LastSessionDuration, Mode=OneWay}"
                                           Style="{StaticResource ST_MonoValueSmall}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.LastSessionStats, Mode=OneWay}"
                                       Style="{StaticResource ST_BodySmall}"
                                       Margin="0,4,0,0"
                                       Visibility="{x:Bind ViewModel.HasLastSessionStats, Mode=OneWay,
                                                    Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <!-- Grade badge sotto le stats -->
                            <Border CornerRadius="4" BorderThickness="1" Padding="8,2"
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Left"
                                    Background="{x:Bind ViewModel.LastSessionGradeBgHex, Mode=OneWay,
                                                 Converter={StaticResource HexToSolidColorBrushConverter}}"
                                    BorderBrush="{x:Bind ViewModel.LastSessionGradeBorderHex, Mode=OneWay,
                                                  Converter={StaticResource HexToSolidColorBrushConverter}}"
                                    Visibility="{x:Bind ViewModel.LastSessionHasGrade, Mode=OneWay,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind ViewModel.LastSessionGrade, Mode=OneWay}"
                                           Style="{StaticResource ST_BadgeText}"
                                           Foreground="{x:Bind ViewModel.LastSessionGradeColorHex, Mode=OneWay,
                                                        Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                            </Border>
                        </StackPanel>

                        <!-- Col 1: label + cover art centrati -->
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">

                            <TextBlock Text="No games detected"
                                       Style="{StaticResource ST_BodySmall}"
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.HasNoGamesDetected, Mode=OneWay,
                                                    Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock Text="Games played"
                                       FontFamily="{StaticResource DMSansSemiBold}"
                                       FontSize="11"
                                       Foreground="{StaticResource STTextDim}"
                                       CharacterSpacing="60"
                                       HorizontalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.HasLastSessionCovers, Mode=OneWay,
                                                    Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Visibility="{x:Bind ViewModel.HasLastSessionCovers, Mode=OneWay,
                                                       Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.LastSessionCovers, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SessionGameCover">
                                            <Border Width="67" Height="100" CornerRadius="5"
                                                    Background="{StaticResource STInput}"
                                                    BorderBrush="{StaticResource STBorder}"
                                                    BorderThickness="1"
                                                    ToolTipService.ToolTip="{x:Bind GameName}">
                                                <Grid>
                                                    <Image Source="{x:Bind CoverImage, Mode=OneWay}"
                                                           Stretch="UniformToFill"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                    <TextBlock Text="{x:Bind GameName}"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               FontSize="7"
                                                               Opacity="0.4"
                                                               Margin="3"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Visibility="{x:Bind HasNoCover, Mode=OneWay,
                                                                            Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>

                    <!-- ── ACTIVE: live session panel ─────────────────────────── -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsSessionActive, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}"
                                Spacing="12">

                        <!-- Timer + sparklines row -->
                        <Grid ColumnSpacing="16" MinHeight="150">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Col 0: duration + drops + start time -->
                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Spacing="3"
                                        MinWidth="110">
                                <TextBlock Text="DURATION"
                                           FontFamily="{StaticResource DMSansSemiBold}"
                                           FontSize="10"
                                           Foreground="{StaticResource STTextDim}"
                                           CharacterSpacing="80"/>
                                <TextBlock Text="{x:Bind ViewModel.LiveDuration, Mode=OneWay}"
                                           FontFamily="{StaticResource DMSansSemiBold}"
                                           FontSize="26"
                                           Foreground="{StaticResource STTextPrimary}"/>
                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                                    <TextBlock Text="DROPS"
                                               FontFamily="{StaticResource DMSansSemiBold}"
                                               FontSize="10"
                                               Foreground="{StaticResource STTextDim}"
                                               CharacterSpacing="80"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.LiveDropPct, Mode=OneWay}"
                                               FontFamily="{StaticResource DMSansSemiBold}"
                                               FontSize="13"
                                               Foreground="{StaticResource STSuccess}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.LiveStartedAt, Mode=OneWay}"
                                           FontFamily="{StaticResource DMSans}"
                                           FontSize="11"
                                           Foreground="{StaticResource STTextDim}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Col 1: RTT -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Spacing="1" Margin="0,0,0,6">
                                    <TextBlock Text="RTT"
                                               FontFamily="{StaticResource DMSansSemiBold}"
                                               FontSize="10"
                                               Foreground="{StaticResource STTextDim}"
                                               CharacterSpacing="80"/>
                                    <TextBlock Text="{x:Bind ViewModel.LiveRttValue, Mode=OneWay}"
                                               FontFamily="{StaticResource DMSansSemiBold}"
                                               FontSize="20"
                                               Foreground="{x:Bind ViewModel.LiveRttColorHex, Mode=OneWay,
                                                            Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                </StackPanel>
                                <ctrl:SparklineControl Grid.Row="1"
                                    Title=""
                                    DurationLabel="30 s"
                                    WindowSize="30"
                                    ShowZeroLabel="False"
                                    Data="{x:Bind ViewModel.LiveRttSeries, Mode=OneWay}"
                                    LineColor="{x:Bind ViewModel.LiveRttLineColor, Mode=OneWay}"/>
                            </Grid>

                            <!-- Col 2: Bitrate -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Spacing="1" Margin="0,0,0,6">
                                    <TextBlock Text="BITRATE"
                                               FontFamily="{StaticResource DMSansSemiBold}"
                                               FontSize="10"
                                               Foreground="{StaticResource STTextDim}"
                                               CharacterSpacing="80"/>
                                    <TextBlock Text="{x:Bind ViewModel.LiveBitrateValue, Mode=OneWay}"
                                               FontFamily="{StaticResource DMSansSemiBold}"
                                               FontSize="20"
                                               Foreground="#FF00B4D8"/>
                                </StackPanel>
                                <ctrl:SparklineControl Grid.Row="1"
                                    Title=""
                                    DurationLabel="30 s"
                                    WindowSize="30"
                                    ShowZeroLabel="False"
                                    Data="{x:Bind ViewModel.LiveBitrateSeries, Mode=OneWay}"
                                    LineColor="#FF00B4D8"/>
                            </Grid>

                        </Grid>

                        <!-- Bottom bar: status + action -->
                        <Border Background="#0F22c55e"
                                BorderBrush="#2622c55e"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE701;" FontSize="13"
                                              Foreground="{StaticResource STSuccess}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Streaming session in progress"
                                               FontFamily="{StaticResource DMSans}"
                                               FontSize="12"
                                               Foreground="{StaticResource STSuccess}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Return to client"
                                        Click="StopStreamButton_Click"
                                        Style="{StaticResource ST_ButtonGhost}"
                                        FontSize="11"
                                        Padding="8,3"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 QUICK STATS — 3×3 grid di tile cliccabili
            ════════════════════════════════════════════════════════════════ -->
            <Grid ColumnSpacing="10" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- NIC Speed → Network -->
                <Button Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource ST_TileButton}"
                        Click="NicSpeedTile_Click">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE701;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="11" Foreground="White"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="NIC SPEED" Style="{StaticResource ST_SectionLabel}"/>
                        </StackPanel>
                        <Border CornerRadius="4" Padding="8,2"
                                Background="#1Af59e0b"
                                BorderBrush="#40f59e0b"
                                BorderThickness="1"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ViewModel.NicSpeedText, Mode=OneWay}"
                                       Style="{StaticResource ST_BadgeText}"
                                       Foreground="{StaticResource STWarning}"/>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.NicAdapterName, Mode=OneWay}"
                                   Style="{StaticResource ST_BodySmall}"/>
                    </StackPanel>
                </Button>

                <!-- Auto Streaming → Network -->
                <Button Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource ST_TileButton}"
                        Click="AutoStreamingTile_Click">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE701;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="11" Foreground="White"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="AUTO STREAMING MODE" Style="{StaticResource ST_SectionLabel}"/>
                        </StackPanel>
                        <Border CornerRadius="4" Padding="8,2"
                                Background="{x:Bind ViewModel.AutoStreamingBgHex, Mode=OneWay,
                                             Converter={StaticResource HexToSolidColorBrushConverter}}"
                                BorderBrush="{x:Bind ViewModel.AutoStreamingBorderHex, Mode=OneWay,
                                             Converter={StaticResource HexToSolidColorBrushConverter}}"
                                BorderThickness="1"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ViewModel.AutoStreamingText, Mode=OneWay}"
                                       Style="{StaticResource ST_BadgeText}"
                                       Foreground="{x:Bind ViewModel.AutoStreamingColorHex, Mode=OneWay,
                                                    Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                        </Border>
                        <TextBlock Opacity="0" Style="{StaticResource ST_BodySmall}" Text=" "/>
                    </StackPanel>
                </Button>

                <!-- HDR → Display -->
                <Button Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource ST_TileButton}"
                        Click="HdrTile_Click">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="11" Foreground="White"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="HDR" Style="{StaticResource ST_SectionLabel}"/>
                        </StackPanel>
                        <Border CornerRadius="4" Padding="8,2"
                                Background="{x:Bind ViewModel.HdrBgHex, Mode=OneWay,
                                             Converter={StaticResource HexToSolidColorBrushConverter}}"
                                BorderBrush="{x:Bind ViewModel.HdrBorderHex, Mode=OneWay,
                                             Converter={StaticResource HexToSolidColorBrushConverter}}"
                                BorderThickness="1"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ViewModel.HdrText, Mode=OneWay}"
                                       Style="{StaticResource ST_BadgeText}"
                                       Foreground="{x:Bind ViewModel.HdrColorHex, Mode=OneWay,
                                                    Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.HdrDisplayName, Mode=OneWay}"
                                   Style="{StaticResource ST_BodySmall}"/>
                    </StackPanel>
                </Button>

                <!-- Spatial Audio → Audio -->
                <Button Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource ST_TileButton}"
                        Click="SpatialAudioTile_Click">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE767;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="11" Foreground="White"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="AUTO SPATIAL AUDIO" Style="{StaticResource ST_SectionLabel}"/>
                        </StackPanel>
                        <Border CornerRadius="4" Padding="8,2"
                                Background="{x:Bind ViewModel.SpatialAudioBgHex, Mode=OneWay,
                                             Converter={StaticResource HexToSolidColorBrushConverter}}"
                                BorderBrush="{x:Bind ViewModel.SpatialAudioBorderHex, Mode=OneWay,
                                             Converter={StaticResource HexToSolidColorBrushConverter}}"
                                BorderThickness="1"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ViewModel.SpatialAudioText, Mode=OneWay}"
                                       Style="{StaticResource ST_BadgeText}"
                                       Foreground="{x:Bind ViewModel.SpatialAudioColorHex, Mode=OneWay,
                                                    Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.SpatialAudioDeviceName, Mode=OneWay}"
                                   Style="{StaticResource ST_BodySmall}"/>
                    </StackPanel>
                </Button>

                <!-- NVIDIA Sentinel → NvidiaProfile (centro, riga 1) -->
                <Button Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource ST_TileButton}"
                        Click="NvidiaSentinelTile_Click">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Image Width="13" Height="13" VerticalAlignment="Center">
                                <Image.Source>
                                    <SvgImageSource UriSource="ms-appx:///Resources/nvidia-eye.svg"/>
                                </Image.Source>
                            </Image>
                            <TextBlock Text="NVIDIA SENTINEL" Style="{StaticResource ST_SectionLabel}"/>
                        </StackPanel>
                        <Border CornerRadius="4" Padding="8,2"
                                Background="{x:Bind ViewModel.NvSentinelAutoRestoreBgHex, Mode=OneWay,
                                             Converter={StaticResource HexToSolidColorBrushConverter}}"
                                BorderBrush="{x:Bind ViewModel.NvSentinelAutoRestoreBorderHex, Mode=OneWay,
                                             Converter={StaticResource HexToSolidColorBrushConverter}}"
                                BorderThickness="1"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ViewModel.NvSentinelBadgeText, Mode=OneWay}"
                                       Style="{StaticResource ST_BadgeText}"
                                       Foreground="{x:Bind ViewModel.NvSentinelAutoRestoreColorHex, Mode=OneWay,
                                                    Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Last auto-restore"
                                       Style="{StaticResource ST_BodySmall}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.NvSentinelLastRestoreValue, Mode=OneWay}"
                                       Style="{StaticResource ST_MonoValueSmall}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Game Library → GameLibrary (centro, riga 2) -->
                <Button Grid.Row="2" Grid.Column="1"
                        Style="{StaticResource ST_TileButton}"
                        Click="GameLibraryTile_Click">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE7FC;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="11" Foreground="White"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="GAME LIBRARY" Style="{StaticResource ST_SectionLabel}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.GameLibraryText, Mode=OneWay}"
                                   Style="{StaticResource ST_MonoMedium}"
                                   Foreground="#f59e0b"/>
                        <TextBlock Text="{x:Bind ViewModel.GameLibrarySyncText, Mode=OneWay}"
                                   Style="{StaticResource ST_BodySmall}"
                                   Visibility="{x:Bind ViewModel.HasGameLibrarySyncText, Mode=OneWay,
                                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Button>

                <!-- Auto HDR → Display -->
                <Button Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource ST_TileButton}"
                        Click="AutoHdrTile_Click">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="11" Foreground="White"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="AUTO HDR" Style="{StaticResource ST_SectionLabel}"/>
                        </StackPanel>
                        <Border CornerRadius="4" Padding="8,2"
                                Background="{x:Bind ViewModel.AutoHdrBgHex, Mode=OneWay,
                                             Converter={StaticResource HexToSolidColorBrushConverter}}"
                                BorderBrush="{x:Bind ViewModel.AutoHdrBorderHex, Mode=OneWay,
                                             Converter={StaticResource HexToSolidColorBrushConverter}}"
                                BorderThickness="1"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ViewModel.AutoHdrText, Mode=OneWay}"
                                       Style="{StaticResource ST_BadgeText}"
                                       Foreground="{x:Bind ViewModel.AutoHdrColorHex, Mode=OneWay,
                                                    Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                        </Border>
                        <TextBlock Opacity="0" Style="{StaticResource ST_BodySmall}" Text=" "/>
                    </StackPanel>
                </Button>

                <!-- APPS → Apps -->
                <Button Grid.Row="2" Grid.Column="0"
                        Style="{StaticResource ST_TileButton}"
                        Click="AppsTile_Click">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE71D;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="11" Foreground="White"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="MANAGED APPS" Style="{StaticResource ST_SectionLabel}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.ManagedAppsText, Mode=OneWay}"
                                   Style="{StaticResource ST_MonoMedium}"
                                   Foreground="#f59e0b"/>
                        <TextBlock Opacity="0" Style="{StaticResource ST_BodySmall}" Text=" "/>
                    </StackPanel>
                </Button>

                <!-- LOGS → Logs -->
                <Button Grid.Row="2" Grid.Column="2"
                        Style="{StaticResource ST_TileButton}"
                        Click="LogsTile_Click">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE9F9;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="11" Foreground="White"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="LOGS" Style="{StaticResource ST_SectionLabel}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.LogsSessionCount, Mode=OneWay}"
                                   Style="{StaticResource ST_MonoMedium}"
                                   Foreground="{x:Bind ViewModel.LogsSessionCountColorHex, Mode=OneWay,
                                                Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="All session duration"
                                       Style="{StaticResource ST_BodySmall}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.LogsTotalDuration, Mode=OneWay}"
                                       Style="{StaticResource ST_MonoValueSmall}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

            </Grid>


        </StackPanel>
    </ScrollViewer>

</Page>
