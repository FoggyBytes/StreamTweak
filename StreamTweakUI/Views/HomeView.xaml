<Page
    x:Class="StreamTweak.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StreamTweak.ViewModels"
    xmlns:ctrl="using:StreamTweak.Controls"
    Background="{StaticResource STBackground}">

    <!-- ═══════════════════════════════════════════════════════════════════════
         8.0 Dashboard — ONE layout for both states.
         Only the top-left "state box" swaps: idle it shows live host vitals,
         streaming it shows the active session. The other three cards (Last
         session, Performance, Host setup + Clients) are identical either way.
    ════════════════════════════════════════════════════════════════════════ -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="28,20,28,20">

            <!-- ══════════ ROW 1 — state box | last session ══════════ -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.18*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ───────── STATE BOX (the only state-dependent card) ───────── -->
                <Border Grid.Column="0" Style="{StaticResource ST_Card}">
                    <!-- MinHeight is what sets this row's height (it exceeds both cards'
                         natural content), so it doubles as the knob that keeps the idle and
                         live states from resizing the layout when a session starts/stops.
                         Kept just above the idle content so the row stays compact at small
                         window sizes; the live panel is slightly taller and sizes itself. -->
                    <Grid MinHeight="156">

                        <!-- ═══ IDLE — live host vitals ═══
                             Replaces the old readiness score: objective, measured
                             facts instead of grading optional automations. -->
                        <StackPanel Spacing="14" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.IsSessionActive, Mode=OneWay,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">

                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource STSuccess}" VerticalAlignment="Center"/>
                                <!-- "· updating every second" used to follow. The green dot and the
                                     word LIVE already say it, and the numbers moving say it better
                                     than either. -->
                                <TextBlock Text="HOST · LIVE" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{x:Bind ViewModel.HostHealthLabel, Mode=OneWay}"
                                           FontFamily="{StaticResource DMSansSemiBold}" FontSize="21"
                                           Foreground="{x:Bind ViewModel.HostHealthColorHex, Mode=OneWay,
                                                        Converter={StaticResource HexToSolidColorBrushConverter}}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.HostHealthSub, Mode=OneWay}"
                                           Style="{StaticResource ST_BodySmall}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </StackPanel>

                            <!-- 5 vitals -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- GPU temp -->
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind ViewModel.HostGpuTempText, Mode=OneWay}"
                                                   FontFamily="{StaticResource DMSansSemiBold}" FontSize="21"
                                                   Foreground="{StaticResource STTextPrimary}"/>
                                        <TextBlock Text="°C" FontSize="11" Foreground="{StaticResource STTextDim}"
                                                   VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <TextBlock Text="GPU TEMP" Style="{StaticResource ST_SectionLabel}"/>
                                    <ProgressBar Maximum="100" Height="4" Margin="0,5,0,0"
                                                 Value="{x:Bind ViewModel.HostGpuTempBar, Mode=OneWay}"
                                                 Background="#14FFFFFF"
                                                 Foreground="{x:Bind ViewModel.HostGpuTempColorHex, Mode=OneWay,
                                                              Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                </StackPanel>

                                <!-- GPU load -->
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind ViewModel.HostGpuLoadText, Mode=OneWay}"
                                                   FontFamily="{StaticResource DMSansSemiBold}" FontSize="21"
                                                   Foreground="{StaticResource STTextPrimary}"/>
                                        <TextBlock Text="%" FontSize="11" Foreground="{StaticResource STTextDim}"
                                                   VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <TextBlock Text="GPU LOAD" Style="{StaticResource ST_SectionLabel}"/>
                                    <ProgressBar Maximum="100" Height="4" Margin="0,5,0,0"
                                                 Value="{x:Bind ViewModel.HostGpuLoadBar, Mode=OneWay}"
                                                 Background="#14FFFFFF"
                                                 Foreground="{x:Bind ViewModel.HostGpuLoadColorHex, Mode=OneWay,
                                                              Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                </StackPanel>

                                <!-- VRAM -->
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind ViewModel.HostVramText, Mode=OneWay}"
                                                   FontFamily="{StaticResource DMSansSemiBold}" FontSize="21"
                                                   Foreground="{StaticResource STTextPrimary}"/>
                                        <TextBlock Text="GB" FontSize="11" Foreground="{StaticResource STTextDim}"
                                                   VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <TextBlock Text="VRAM" Style="{StaticResource ST_SectionLabel}"/>
                                    <ProgressBar Maximum="100" Height="4" Margin="0,5,0,0"
                                                 Value="{x:Bind ViewModel.HostVramBar, Mode=OneWay}"
                                                 Background="#14FFFFFF" Foreground="{StaticResource STSuccess}"/>
                                </StackPanel>

                                <!-- CPU -->
                                <StackPanel Grid.Column="3" Spacing="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind ViewModel.HostCpuText, Mode=OneWay}"
                                                   FontFamily="{StaticResource DMSansSemiBold}" FontSize="21"
                                                   Foreground="{StaticResource STTextPrimary}"/>
                                        <TextBlock Text="%" FontSize="11" Foreground="{StaticResource STTextDim}"
                                                   VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <TextBlock Text="CPU" Style="{StaticResource ST_SectionLabel}"/>
                                    <ProgressBar Maximum="100" Height="4" Margin="0,5,0,0"
                                                 Value="{x:Bind ViewModel.HostCpuBar, Mode=OneWay}"
                                                 Background="#14FFFFFF"
                                                 Foreground="{x:Bind ViewModel.HostCpuColorHex, Mode=OneWay,
                                                              Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                </StackPanel>

                                <!-- Net TX -->
                                <StackPanel Grid.Column="4" Spacing="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind ViewModel.HostNetText, Mode=OneWay}"
                                                   FontFamily="{StaticResource DMSansSemiBold}" FontSize="21"
                                                   Foreground="{StaticResource STTextPrimary}"/>
                                        <TextBlock Text="Mbps" FontSize="11" Foreground="{StaticResource STTextDim}"
                                                   VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <TextBlock Text="NET TX" Style="{StaticResource ST_SectionLabel}"/>
                                    <ProgressBar Maximum="100" Height="4" Margin="0,5,0,0"
                                                 Value="{x:Bind ViewModel.HostNetBar, Mode=OneWay}"
                                                 Background="#14FFFFFF" Foreground="{StaticResource STSuccess}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- ═══ LIVE — active session ═══ -->
                        <StackPanel Spacing="14" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.IsSessionActive, Mode=OneWay,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">

                            <!-- Header carries the "return to client" action on the right: the old
                                 green footer bar said "streaming in progress" a fourth time (the
                                 pulsing dot, the SESSION · LIVE label and the big green "Streaming"
                                 headline already say it) and claimed "host optimisations active",
                                 which the HOST SETUP card next to it states far more precisely.
                                 Dropping it also makes the live panel the same height as the idle
                                 one, so the row no longer grows when a session starts. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse x:Name="PulseRing" Width="10" Height="10" Fill="#594ade80">
                                        <Ellipse.Resources>
                                            <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="SessionDot"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="1.0" To="0.5" Duration="0:0:0.9"/>
                                                <DoubleAnimation Storyboard.TargetName="PulseRing"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0.5" To="0" Duration="0:0:0.9"/>
                                            </Storyboard>
                                        </Ellipse.Resources>
                                    </Ellipse>
                                    <Ellipse x:Name="SessionDot" Width="6" Height="6" Fill="#4ade80"/>
                                </Grid>
                                <TextBlock Text="SESSION · LIVE" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                                <TextBlock Text="·" Foreground="{StaticResource STBorderSubtle}" VerticalAlignment="Center"/>
                                <Image Source="{x:Bind ViewModel.StreamHostIcon, Mode=OneWay}" Width="14" Height="14" VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.HasStreamHostIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{x:Bind ViewModel.StreamHostName, Mode=OneWay}" Style="{StaticResource ST_BodySmall}" VerticalAlignment="Center"
                                           Visibility="{x:Bind ViewModel.HasStreamHost, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="Return to client" Click="StopStreamButton_Click"
                                        Style="{StaticResource ST8_ButtonAmber}" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Ends the streaming session and hands control back to the client"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Streaming"
                                           FontFamily="{StaticResource DMSansSemiBold}" FontSize="21"
                                           Foreground="{StaticResource STSuccess}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.LiveDuration, Mode=OneWay}"
                                           FontFamily="{StaticResource DMSansMedium}" FontSize="15"
                                           Foreground="{StaticResource STTextPrimary}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </StackPanel>

                            <!-- 5 session metrics — same grid as the idle vitals -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind ViewModel.LiveRttNumber, Mode=OneWay}"
                                                   FontFamily="{StaticResource DMSansSemiBold}" FontSize="21"
                                                   Foreground="{x:Bind ViewModel.LiveRttColorHex, Mode=OneWay,
                                                                Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                        <TextBlock Text="ms" FontSize="11" Foreground="{StaticResource STTextDim}"
                                                   VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <TextBlock Text="RTT" Style="{StaticResource ST_SectionLabel}"/>
                                    <TextBlock Text="{x:Bind ViewModel.LiveRttSub, Mode=OneWay}" Style="{StaticResource ST_BodySmall}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind ViewModel.LiveHostLatNumber, Mode=OneWay}"
                                                   FontFamily="{StaticResource DMSansSemiBold}" FontSize="21"
                                                   Foreground="{StaticResource STTextPrimary}"/>
                                        <TextBlock Text="ms" FontSize="11" Foreground="{StaticResource STTextDim}"
                                                   VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <TextBlock Text="HOST LATENCY" Style="{StaticResource ST_SectionLabel}"/>
                                    <TextBlock Text="capture + encode" Style="{StaticResource ST_BodySmall}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind ViewModel.LiveBitrateNumber, Mode=OneWay}"
                                                   FontFamily="{StaticResource DMSansSemiBold}" FontSize="21"
                                                   Foreground="#FF00B4D8"/>
                                        <TextBlock Text="Mbps" FontSize="11" Foreground="{StaticResource STTextDim}"
                                                   VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <TextBlock Text="BITRATE" Style="{StaticResource ST_SectionLabel}"/>
                                    <TextBlock Text="{x:Bind ViewModel.LiveBitrateSub, Mode=OneWay}" Style="{StaticResource ST_BodySmall}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Spacing="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind ViewModel.LiveDropsNumber, Mode=OneWay}"
                                                   FontFamily="{StaticResource DMSansSemiBold}" FontSize="21"
                                                   Foreground="{StaticResource STTextPrimary}"/>
                                        <TextBlock Text="%" FontSize="11" Foreground="{StaticResource STTextDim}"
                                                   VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <TextBlock Text="DROPS" Style="{StaticResource ST_SectionLabel}"/>
                                    <TextBlock Text="{x:Bind ViewModel.LiveDropsSub, Mode=OneWay}" Style="{StaticResource ST_BodySmall}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Spacing="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind ViewModel.LiveFpsNumber, Mode=OneWay}"
                                                   FontFamily="{StaticResource DMSansSemiBold}" FontSize="21"
                                                   Foreground="{StaticResource STTextPrimary}"/>
                                        <TextBlock Text="fps" FontSize="11" Foreground="{StaticResource STTextDim}"
                                                   VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <TextBlock Text="FRAME RATE" Style="{StaticResource ST_SectionLabel}"/>
                                    <TextBlock Text="client decode" Style="{StaticResource ST_BodySmall}"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ───────── LAST SESSION (identical in both states) ───────── -->
                <Border Grid.Column="1" Style="{StaticResource ST_Card}">
                    <Grid MinHeight="156">
                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE9F9;" FontSize="22" Foreground="{StaticResource STTextGhost}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Your last completed stream will appear here."
                                       Style="{StaticResource ST_BodySmall}" TextAlignment="Center" MaxWidth="240"/>
                        </StackPanel>

                        <StackPanel Spacing="12" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.ShowLastSession, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- Right-aligned with everything else on this side. The covers own the
                                 left of the card now, so a caption anchored to the left edge sat on
                                 top of the artwork it does not title — "Games played" does that. -->
                            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
                                <TextBlock Text="LAST SESSION" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                                <TextBlock Text="·" Foreground="{StaticResource STBorderSubtle}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.LastSessionAgo, Mode=OneWay}" Style="{StaticResource ST_BodySmall}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid>
                                <!-- Covers first, figures after, the figures flush right. The strip
                                     used to sit on the right with the numbers on the left, which put
                                     the card's widest gap in its own middle; reading now runs from the
                                     artwork into the numbers. Matches StreamLight's host card, which
                                     shows the same session. -->
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                                <!-- Left margin is a guaranteed gutter after the cover strip: the
                                     figures' column is star-sized against an Auto cover column, so with
                                     three covers it collapses to almost exactly its content width and
                                     the RTT figure would end up flush against the last cover. -->
                                <StackPanel Grid.Column="1" Spacing="12" Margin="18,0,0,0" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                        <Border CornerRadius="6" BorderThickness="1" Padding="10,4" VerticalAlignment="Center"
                                                Background="{x:Bind ViewModel.LastSessionGradeBgHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                BorderBrush="{x:Bind ViewModel.LastSessionGradeBorderHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                Visibility="{x:Bind ViewModel.LastSessionHasGrade, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind ViewModel.LastSessionGrade, Mode=OneWay}"
                                                       FontFamily="{StaticResource DMSansSemiBold}" FontSize="13"
                                                       Foreground="{x:Bind ViewModel.LastSessionGradeColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                        </Border>
                                        <Border CornerRadius="6" Padding="10,4" VerticalAlignment="Center"
                                                Background="{StaticResource STBadgeGrayBg}" BorderBrush="{StaticResource STBadgeGrayBdr}" BorderThickness="1">
                                            <TextBlock Text="{x:Bind ViewModel.LastSessionDuration, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Bind ViewModel.LastSessionRttValue, Mode=OneWay}" FontFamily="{StaticResource DMSansSemiBold}" FontSize="26" Foreground="{StaticResource STTextPrimary}"/>
                                                <TextBlock Text="ms" FontSize="12" Foreground="{StaticResource STTextDim}" VerticalAlignment="Bottom" Margin="1,0,0,4"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.LastSessionRttSub, Mode=OneWay}" Style="{StaticResource ST_BodySmall}"/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Bind ViewModel.LastSessionHostLatency, Mode=OneWay}" FontFamily="{StaticResource DMSansSemiBold}" FontSize="26" Foreground="{StaticResource STTextPrimary}"/>
                                                <TextBlock Text="ms" FontSize="12" Foreground="{StaticResource STTextDim}" VerticalAlignment="Bottom" Margin="1,0,0,4"/>
                                            </StackPanel>
                                            <TextBlock Text="Host latency" Style="{StaticResource ST_BodySmall}"/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Bind ViewModel.LastSessionDropsValue, Mode=OneWay}" FontFamily="{StaticResource DMSansSemiBold}" FontSize="26" Foreground="{StaticResource STTextPrimary}"/>
                                                <TextBlock Text="%" FontSize="12" Foreground="{StaticResource STTextDim}" VerticalAlignment="Bottom" Margin="1,0,0,4"/>
                                            </StackPanel>
                                            <TextBlock Text="Drops" Style="{StaticResource ST_BodySmall}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- No caption. The strip sits under a card already titled LAST SESSION,
                                     next to figures that are plainly about the same session — the label
                                     was naming something the position already said, and it was also the
                                     widest thing in this column, so a single cover ended up centred on
                                     the text rather than in the space.
                                     MinWidth is three covers plus their gaps (3*60 + 2*6) and the strip
                                     inside is centred: one, two or three all sit in the middle of the
                                     same reserved area, instead of the block changing width with the
                                     session. It can still grow past it — a "+2" widens the group and the
                                     Auto column follows. -->
                                <StackPanel Grid.Column="0" MinWidth="192" VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.HasLastSessionCovers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.LastSessionCovers, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SessionGameCover">
                                                <Border Width="60" Height="90" CornerRadius="5" Background="{StaticResource STInput}" BorderBrush="{StaticResource STBorder}" BorderThickness="1" ToolTipService.ToolTip="{x:Bind GameName}">
                                                    <Grid>
                                                        <!-- UniformToFill + centred: the tile is 2:3 but store art is not
                                                             always (Epic covers in particular), and merely fitting it left
                                                             visible empty bands above and below. Filling crops the overflow
                                                             instead — the Border's CornerRadius clips it. Same as Library. -->
                                                        <Image Source="{x:Bind CoverImage, Mode=OneWay}" Stretch="UniformToFill"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{x:Bind GameName}" TextWrapping="Wrap" TextAlignment="Center" FontSize="8" Opacity="0.4" Margin="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                   Visibility="{x:Bind HasNoCover, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- "+2" when the session detected more games than the three
                                         shown. Deliberately quiet and outside the tiles: it is a
                                         footnote saying where to look, not a fourth game. The full
                                         list is in Sessions. -->
                                    <TextBlock Text="{x:Bind ViewModel.LastSessionCoversOverflow, Mode=OneWay}"
                                               Style="{StaticResource ST_BodySmall}" VerticalAlignment="Center"
                                               Visibility="{x:Bind ViewModel.HasLastSessionCoversOverflow, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════ ROW 2 — performance | host setup + clients ══════════ -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.18*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ───────── PERFORMANCE (this week) ───────── -->
                <Border Grid.Column="0" Style="{StaticResource ST_Card}">
                    <StackPanel Spacing="12">
                        <!-- Header: label + period summary (left), period picker (right) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="PERFORMANCE" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                                <TextBlock Text="·" Foreground="{StaticResource STBorderSubtle}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.PerfPeriodLabel, Mode=OneWay}" Style="{StaticResource ST_BodySmall}" VerticalAlignment="Center"/>
                                <TextBlock Text="·" Foreground="{StaticResource STBorderSubtle}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.ThisWeekSummary, Mode=OneWay}" Style="{StaticResource ST_BodySmall}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ComboBox Grid.Column="1" MinWidth="132" VerticalAlignment="Center"
                                      AutomationProperties.Name="Performance period"
                                      ToolTipService.ToolTip="Period summarised by this card"
                                      SelectedIndex="{x:Bind ViewModel.PerfPeriodIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Last 7 days"/>
                                <ComboBoxItem Content="Last 30 days"/>
                                <ComboBoxItem Content="Last 90 days"/>
                                <ComboBoxItem Content="Last 180 days"/>
                                <ComboBoxItem Content="Last 365 days"/>
                                <ComboBoxItem Content="All time"/>
                            </ComboBox>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{x:Bind ViewModel.ThisWeekAvgLetter, Mode=OneWay}"
                                       FontFamily="{StaticResource DMSansSemiBold}" FontSize="30"
                                       Foreground="{StaticResource STTextPrimary}"/>
                            <TextBlock Text="{x:Bind ViewModel.ThisWeekBreakdown, Mode=OneWay}"
                                       Style="{StaticResource ST_BodySmall}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                        </StackPanel>

                        <!-- Trend chart: RTT (+ host frame latency when recorded) per session -->
                        <ctrl:SparklineControl Height="150" Title=""
                                               DurationLabel="{x:Bind ViewModel.PerfPeriodAxisLabel, Mode=OneWay}"
                                               LinesData="{x:Bind ViewModel.WeekPerfLines, Mode=OneWay}"
                                               Visibility="{x:Bind ViewModel.HasWeekPerf, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Text="At least two graded sessions are needed to draw a trend."
                                   Style="{StaticResource ST_BodySmall}"
                                   Visibility="{x:Bind ViewModel.HasWeekPerf, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <StackPanel Orientation="Horizontal" Spacing="22">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Avg RTT" Style="{StaticResource ST_BodySmall}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.ThisWeekRtt, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Avg drops" Style="{StaticResource ST_BodySmall}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.WeekPerfDrops, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Streamed" Style="{StaticResource ST_BodySmall}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.WeekPerfStreamed, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ───────── HOST SETUP + PAIRED CLIENTS ───────── -->
                <Border Grid.Column="1" Style="{StaticResource ST_Card}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="HOST SETUP" Style="{StaticResource ST_SectionLabel}" Margin="0,0,0,6"/>

                        <!-- Link speed + its auto-switch state on one row: the second badge is
                             a qualifier of the first, not a separate setting, so pairing them
                             reads better and buys back a row for the cards below. Same pattern
                             for HDR / Auto HDR and NVIDIA Sentinel below. -->
                        <Grid Padding="0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Link speed" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border CornerRadius="4" BorderThickness="1" Padding="8,3"
                                        Background="#1A4ade80" BorderBrush="#404ade80">
                                    <TextBlock Text="{x:Bind ViewModel.NicSpeedText, Mode=OneWay}" Style="{StaticResource ST_BadgeText}" Foreground="{StaticResource STSuccess}"/>
                                </Border>
                                <Border CornerRadius="4" BorderThickness="1" Padding="8,3"
                                        ToolTipService.ToolTip="Whether approved clients may ask this host to match its link speed before connecting"
                                        Background="{x:Bind ViewModel.ClientControlBgHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                        BorderBrush="{x:Bind ViewModel.ClientControlBorderHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Client control" Style="{StaticResource ST_BadgeText}" Opacity="0.7"
                                                   Foreground="{x:Bind ViewModel.ClientControlColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                        <TextBlock Text="{x:Bind ViewModel.ClientControlText, Mode=OneWay}" Style="{StaticResource ST_BadgeText}"
                                                   Foreground="{x:Bind ViewModel.ClientControlColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- HDR + Auto HDR -->
                        <Grid Padding="0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="HDR" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border CornerRadius="4" BorderThickness="1" Padding="8,3"
                                        Background="{x:Bind ViewModel.HdrBgHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                        BorderBrush="{x:Bind ViewModel.HdrBorderHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                    <TextBlock Text="{x:Bind ViewModel.HdrText, Mode=OneWay}" Style="{StaticResource ST_BadgeText}"
                                               Foreground="{x:Bind ViewModel.HdrColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                </Border>
                                <Border CornerRadius="4" BorderThickness="1" Padding="8,3"
                                        ToolTipService.ToolTip="Windows Auto HDR — expands supported SDR games to HDR"
                                        Background="{x:Bind ViewModel.AutoHdrBgHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                        BorderBrush="{x:Bind ViewModel.AutoHdrBorderHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Auto" Style="{StaticResource ST_BadgeText}" Opacity="0.7"
                                                   Foreground="{x:Bind ViewModel.AutoHdrColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                        <TextBlock Text="{x:Bind ViewModel.AutoHdrText, Mode=OneWay}" Style="{StaticResource ST_BadgeText}"
                                                   Foreground="{x:Bind ViewModel.AutoHdrColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Spatial audio -->
                        <Grid Padding="0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Spatial audio" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" CornerRadius="4" BorderThickness="1" Padding="8,3" VerticalAlignment="Center"
                                    Background="{x:Bind ViewModel.SpatialAudioBgHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                    BorderBrush="{x:Bind ViewModel.SpatialAudioBorderHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                <TextBlock Text="{x:Bind ViewModel.SpatialAudioText, Mode=OneWay}" Style="{StaticResource ST_BadgeText}"
                                           Foreground="{x:Bind ViewModel.SpatialAudioColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                            </Border>
                        </Grid>

                        <!-- NVIDIA Sentinel (hidden on non-NVIDIA hosts) -->
                        <Grid Padding="0,7"
                              Visibility="{x:Bind ViewModel.IsNvSentinelAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="NVIDIA Sentinel" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <!-- Snapshot size is a neutral fact, so it stays grey; the colour
                                     belongs to the auto-restore badge, which is the actual state. -->
                                <Border CornerRadius="4" BorderThickness="1" Padding="8,3"
                                        ToolTipService.ToolTip="Driver settings captured in your saved profile"
                                        Background="{StaticResource STBadgeGrayBg}" BorderBrush="{StaticResource STBadgeGrayBdr}">
                                    <TextBlock Text="{x:Bind ViewModel.NvSentinelBadgeText, Mode=OneWay}" Style="{StaticResource ST_BadgeText}"
                                               Foreground="{StaticResource STTextMuted}"/>
                                </Border>
                                <Border CornerRadius="4" BorderThickness="1" Padding="8,3"
                                        ToolTipService.ToolTip="Re-applies your saved profile automatically if NVIDIA App resets it"
                                        Background="{x:Bind ViewModel.NvSentinelAutoRestoreBgHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                        BorderBrush="{x:Bind ViewModel.NvSentinelAutoRestoreBorderHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Auto" Style="{StaticResource ST_BadgeText}" Opacity="0.7"
                                                   Foreground="{x:Bind ViewModel.NvSentinelAutoRestoreColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                        <TextBlock Text="{x:Bind ViewModel.NvSentinelAutoRestoreText, Mode=OneWay}" Style="{StaticResource ST_BadgeText}"
                                                   Foreground="{x:Bind ViewModel.NvSentinelAutoRestoreColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Managed apps -->
                        <Grid Padding="0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Managed apps" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" CornerRadius="4" BorderThickness="1" Padding="8,3" VerticalAlignment="Center"
                                    Background="{StaticResource STBadgeGrayBg}" BorderBrush="{StaticResource STBadgeGrayBdr}">
                                <TextBlock Text="{x:Bind ViewModel.ManagedAppsText, Mode=OneWay}" Style="{StaticResource ST_BadgeText}" Foreground="{StaticResource STTextMuted}"/>
                            </Border>
                        </Grid>

                        <!-- Paired clients -->
                        <Border BorderBrush="{StaticResource STBorderSubtle}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="PAIRED CLIENTS" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                                    <TextBlock Text="·" Foreground="{StaticResource STBorderSubtle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.PairedClientsSummary, Mode=OneWay}" Style="{StaticResource ST_BodySmall}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.PairedClients, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.HasPairedClients, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HomeClientRow">
                                            <Grid Padding="0,5">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource ST_RowLabel}"/>
                                                    <TextBlock Text="{x:Bind LastSeenText}" Style="{StaticResource ST_RowDescription}"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="4" BorderThickness="1" Padding="8,3" VerticalAlignment="Center"
                                                        Background="{x:Bind StatusBgHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                        BorderBrush="{x:Bind StatusBorderHex, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                                    <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource ST_BadgeText}"
                                                               Foreground="{x:Bind StatusColorHex, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="No approved clients yet. Approve a StreamLight client from the Clients page."
                                           Style="{StaticResource ST_BodySmall}" TextWrapping="Wrap"
                                           Visibility="{x:Bind ViewModel.HasPairedClients, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</Page>
