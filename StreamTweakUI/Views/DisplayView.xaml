<Page
    x:Class="StreamTweak.Views.DisplayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StreamTweak.ViewModels"
    Background="{StaticResource STBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="28,24,28,28">

            <!-- Page title + optional error InfoBar grouped in a Grid so the InfoBar's
                 collapsed-state doesn't break the outer StackPanel.Spacing rhythm.
                 (WinUI3 StackPanel applies Spacing to collapsed children as well, which
                 would otherwise add a ghost 16px gap above the first card.) -->
            <Grid Margin="0,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="3">
                    <TextBlock Text="Display" Style="{StaticResource ST_PageTitle}"/>
                    <TextBlock Text="HDR output and Auto HDR settings."
                               Style="{StaticResource ST_PageSubtitle}"/>
                </StackPanel>

                <!-- Dynamic error bar (keep as InfoBar — it's a conditional alert).
                     Visibility is bound explicitly so the control is removed from the
                     layout (and its Margin doesn't reserve a phantom 16px) when there
                     is no error. IsOpen alone only collapses the InfoBar's inner
                     content, not the control itself — see issue analysis. -->
                <InfoBar Grid.Row="1"
                         Margin="0,16,0,0"
                         Visibility="{x:Bind ViewModel.HasError, Mode=OneWay,
                                      Converter={StaticResource BoolToVisibilityConverter}}"
                         IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Severity="Error"
                         Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                         IsClosable="False"/>
            </Grid>

            <!-- ── Per-Display HDR Output ─────────────────────────────────────── -->
            <Border Style="{StaticResource ST_Card}">
                <StackPanel Spacing="12">

                    <Grid>
                        <TextBlock Text="PER-DISPLAY HDR OUTPUT"
                                   Style="{StaticResource ST_SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource ST_ButtonGhost}"
                                Width="32" Height="32"
                                Padding="0"
                                Click="RefreshButton_Click"
                                AutomationProperties.AutomationId="RefreshDisplaysButton"
                                AutomationProperties.Name="Refresh display list"
                                ToolTipService.ToolTip="Refresh display list">
                            <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                        </Button>
                    </Grid>

                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="24" Height="24"
                                  HorizontalAlignment="Left"
                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay,
                                               Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Monitor cards -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Monitors}"
                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay,
                                               Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MonitorEntry">
                                <Border Background="{StaticResource STInput}"
                                        BorderBrush="{StaticResource STBorder}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="14,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind FriendlyName}"
                                                           Style="{StaticResource ST_RowLabel}"
                                                           VerticalAlignment="Center"/>
                                                <!-- Virtual display badge -->
                                                <Border CornerRadius="4" Padding="6,2"
                                                        Background="{StaticResource STBadgeGrayBg}"
                                                        BorderBrush="{StaticResource STBadgeGrayBdr}"
                                                        BorderThickness="1"
                                                        Visibility="{x:Bind IsVirtual,
                                                                     Converter={StaticResource BoolToVisibilityConverter}}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="Virtual"
                                                               Style="{StaticResource ST_BadgeText}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource STTextMuted}"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{x:Bind ResolutionText}"
                                                       Style="{StaticResource ST_RowDescription}"/>

                                            <TextBlock Text="{x:Bind HdrStateText, Mode=OneWay}"
                                                       Style="{StaticResource ST_RowDescription}"
                                                       Foreground="{x:Bind HdrStateColorHex, Mode=OneWay,
                                                                    Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                        </StackPanel>

                                        <ToggleSwitch Grid.Column="1"
                                                      Style="{StaticResource ST_Toggle}"
                                                      AutomationProperties.Name="{x:Bind FriendlyName}"
                                                      IsOn="{x:Bind HdrEnabled, Mode=OneWay}"
                                                      IsEnabled="{x:Bind HdrSupported}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Right"
                                                      Toggled="HdrToggle_Toggled"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <!-- ── Auto HDR ──────────────────────────────────────────────────── -->
            <Border Style="{StaticResource ST_Card}">
                <StackPanel Spacing="12">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3" Margin="0,0,16,0">
                            <TextBlock Text="AUTO HDR" Style="{StaticResource ST_SectionLabel}"/>
                            <TextBlock Text="Enables Windows Auto HDR for supported SDR games."
                                       Style="{StaticResource ST_RowDescription}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      Style="{StaticResource ST_Toggle}"
                                      AutomationProperties.AutomationId="AutoHdrToggle"
                                      AutomationProperties.Name="Auto HDR"
                                      IsOn="{x:Bind ViewModel.AutoHdrEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Dynamic warning (keep as InfoBar — conditional) -->
                    <InfoBar IsOpen="{x:Bind ViewModel.ShowAutoHdrWarning, Mode=OneWay}"
                             Severity="Warning"
                             Title="No HDR display active"
                             Message="Auto HDR requires at least one display with HDR enabled."
                             IsClosable="False"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</Page>
