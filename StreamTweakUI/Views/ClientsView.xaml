<Page
    x:Class="StreamTweak.Views.ClientsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StreamTweak.ViewModels"
    xmlns:ctrl="using:StreamTweak.Controls"
    Background="{StaticResource STBackground}">

    <!-- 9.0: one card per StreamLight device, stacked, in the shared content column (Controls/PageLayout);
         devices waiting for approval come first and show the PIN to check against. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel x:Name="PageRoot" Padding="32,24,32,40" Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock Text="Clients" Style="{StaticResource ST9_PageTitle}"/>
                <TextBlock Text="StreamLight devices allowed to read this host's metrics and drive it: link speed, launch, power."
                           Style="{StaticResource ST9_PageSubtitle}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Clipboard shared with StreamLight (8.7.0, §79): one switch for every approved device.
                 Section labels as on the Host pages: small capitals above each card. -->
            <StackPanel Spacing="8">
                <TextBlock Text="CLIPBOARD" Style="{StaticResource ST_SectionLabel}"/>
                <Border Style="{StaticResource ST9_Card}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ST9_IconBubble}" Background="{StaticResource ST9BlueSoft}">
                            <FontIcon Glyph="&#xE77F;" FontSize="15" Foreground="{StaticResource ST9Blue}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="Share clipboard with StreamLight" Style="{StaticResource ST9_RowTitle}" VerticalAlignment="Center"/>
                                <ctrl:InfoHint Term="Shared clipboard" Tip="Text copied on this PC can be pasted on the device, and the other way round, while it streams. Encrypted with a key that lasts one stream. Passwords are cleared within 60 seconds. The device must turn it on too; StreamLight 6.3.0 or later."/>
                            </StackPanel>
                            <TextBlock Text="Approved devices, while streaming · StreamLight 6.3.0 or later" Style="{StaticResource ST9_Hint}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" Style="{StaticResource ST_Toggle}" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                                      AutomationProperties.Name="Share clipboard with StreamLight"
                                      IsOn="{x:Bind ViewModel.ShareClipboard, Mode=TwoWay}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="DEVICES" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                    <ctrl:InfoHint Term="Client approval" Tip="Only approved StreamLight devices can use the advanced integration (host metrics, link-speed switch, power-off, …); streaming itself is never affected. New devices request access on first connection — approve them once here. Requires StreamLight 3.2.0 or later."/>
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind ViewModel.BridgeClients, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctrl:ResponsiveGrid MinColumnWidth="340" MaxColumns="1" ColumnSpacing="16" RowSpacing="16"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BridgeClientItem">
                            <Border Style="{StaticResource ST9_Card}">
                                <StackPanel Spacing="14">
                                    <!-- Icon, name, status and the actions on one line: on a row of
                                         their own the buttons left an empty band in every card. -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- The icon says what the device is: click it to pick one of five kinds. -->
                                        <Button Style="{StaticResource ST9_ButtonGhost}" Padding="0" MinHeight="0" MinWidth="0" CornerRadius="9"
                                                VerticalAlignment="Center" Tag="{x:Bind UniqueId}" Click="DeviceKind_Click"
                                                AutomationProperties.Name="Device type"
                                                ToolTipService.ToolTip="{x:Bind KindTip}">
                                            <Border Style="{StaticResource ST9_IconBubble}"
                                                    Background="{x:Bind IconBgHex, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16"
                                                          Foreground="{x:Bind IconFgHex, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                            </Border>
                                        </Button>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource ST9_RowTitle}"/>
                                            <TextBlock Text="{x:Bind SubText}" Style="{StaticResource ST9_Hint}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="4" Padding="7,2,7,3" BorderThickness="1"
                                                Background="{x:Bind StatusBgHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                BorderBrush="{x:Bind StatusBorderHex, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                            <TextBlock Text="{x:Bind StatusLabel}" Style="{StaticResource ST9_TagText}"
                                                       Foreground="{x:Bind StatusColorHex, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                        </Border>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ST9_ButtonPrimary}" Content="Approve" Tag="{x:Bind UniqueId}" Click="ApproveClient_Click"
                                                    Visibility="{x:Bind CanApprove, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Style="{StaticResource ST9_ButtonDanger}" Content="Revoke" Tag="{x:Bind UniqueId}" Click="RevokeClient_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource ST9_Inset}" Padding="14,10"
                                            Visibility="{x:Bind HasPin, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Approve only if the device shows this PIN" Style="{StaticResource ST9_Small}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind PinText}" Style="{StaticResource ST9_Mono}" FontSize="20"
                                                       Foreground="{StaticResource ST9Text}" CharacterSpacing="200" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource ST9_Card}"
                        Visibility="{x:Bind ViewModel.HasNoBridgeClients, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="No devices yet. Open this host in StreamLight 3.2.0 or later: it asks for access here the first time it connects."
                               Style="{StaticResource ST9_Body}"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
