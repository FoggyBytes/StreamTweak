<Page
    x:Class="StreamTweak.Views.SetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StreamTweak.ViewModels"
    xmlns:ctrl="using:StreamTweak.Controls"
    Background="{StaticResource STBackground}">

    <!-- 10.0 Setup: what you set once on this host — Clients, Network, Apps, Spatial audio,
         NVIDIA Sentinel — one sidebar item each, under the Setup header (Marcello, 22/10: items, not tabs).
         One page shows the panel its item names (ShowTab); Status's rows open the one they speak
         of. The column grows with the window up to the shared content width (Controls/PageLayout). -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
          <StackPanel x:Name="PanelsHost" Padding="32,24,32,40" Spacing="16">
            <TextBlock x:Name="PageTitle" Text="Clients" Style="{StaticResource ST9_PageTitle}" Margin="0,0,0,-12"/>

          <Grid>

            <!-- ═══ NETWORK — as in 9.2.5 (back on 22/10: Marcello) ═════════════ -->
            <StackPanel x:Name="PanelNet" Style="{StaticResource ST8_PanelRoot}" Visibility="Collapsed">
                <TextBlock Text="The wired link this host streams on, and who may change it." Style="{StaticResource ST9_PageSubtitle}" TextWrapping="Wrap"/>

                <ctrl:ResponsiveGrid MinColumnWidth="560" MaxColumns="1" ColumnSpacing="20" RowSpacing="22">
                <!-- ADAPTER -->
                <StackPanel Spacing="8">
                    <TextBlock Text="ADAPTER" Style="{StaticResource ST_SectionLabel}"/>
                    <ProgressRing IsActive="{x:Bind Net.IsLoading, Mode=OneWay}" Width="22" Height="22" HorizontalAlignment="Left"
                                  Visibility="{x:Bind Net.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Border Style="{StaticResource ST8_GroupCard}">
                        <StackPanel>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Network adapter" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                        <ctrl:InfoHint Term="NIC" Tip="The physical NIC StreamTweak controls. Detected via CIM/WMI."/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" MinWidth="240" MaxWidth="300" ItemsSource="{x:Bind Net.Adapters}"
                                              SelectedItem="{x:Bind Net.SelectedAdapter, Mode=TwoWay}"
                                              IsEnabled="{x:Bind Net.HasAdapters, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Current link speed" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                        <ctrl:InfoHint Term="Link Speed" Tip="The adapter's current negotiated link speed, updated live."/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                                            Background="#214ade80" BorderBrush="#594ade80" BorderThickness="1">
                                        <TextBlock Text="{x:Bind Net.CurrentSpeedText, Mode=OneWay}" FontFamily="{StaticResource DMSansSemiBold}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource STSuccess}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- The adapter's LAN address, the one clients reach this PC on -->
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="IP address" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="1" Text="Copied!" Style="{StaticResource ST_RowDescription}" Foreground="{StaticResource STSuccess}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Visibility="{x:Bind Net.LanIpCopiedVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Net.LanIp, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"
                                               IsTextSelectionEnabled="True"
                                               Visibility="{x:Bind Net.HasLanIp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Grid.Column="2" Text="No address" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"
                                               Visibility="{x:Bind Net.HasLanIp, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <Button Grid.Column="3" Style="{StaticResource ST_ButtonGhost}" Width="28" Height="28" Padding="0" Margin="8,0,0,0"
                                            VerticalAlignment="Center" Click="CopyLanIp_Click"
                                            Visibility="{x:Bind Net.HasLanIp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="Copy to clipboard" AutomationProperties.Name="Copy IP address">
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" Glyph="&#xE8C8;"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="Speeds this adapter supports" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                            <ctrl:InfoHint Term="Link-speed switch" Tip="Reported to clients so they can ask for a speed that matches their own wired connection."/>
                                        </StackPanel>
                                        <TextBlock Text="Reported to clients so they can ask for one that matches their own connection."
                                                   Style="{StaticResource ST_RowDescription}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Net.SupportedSpeedsText, Mode=OneWay}"
                                               Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ST_InfoBox}"
                            Visibility="{x:Bind Net.HasAdapters, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{StaticResource STWarning}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                            <StackPanel Spacing="2">
                                <TextBlock Text="No wired adapter found" Style="{StaticResource ST_RowLabel}"/>
                                <TextBlock Style="{StaticResource ST_RowDescription}" TextWrapping="Wrap"
                                           Text="StreamTweak manages Ethernet only: Wi-Fi has no fixed link speed to match, and the buffering this solves happens where a faster wired link meets a slower one. Connect this PC by cable to use the feature."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- CLIENT CONTROL -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="CLIENT CONTROL" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                        <ctrl:InfoHint Term="Link-speed switch" Tip="Matching the host link speed to the client kills bufferbloat and its latency spikes. The client asks before it connects, so the brief reconnect happens before the stream starts instead of interrupting it."/>
                    </StackPanel>
                    <Border Style="{StaticResource ST8_GroupCard}">
                        <StackPanel>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="How it works" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border Style="{StaticResource ST8_FlowChip}">
                                            <TextBlock Text="client asks" Style="{StaticResource ST8_FlowChipText}"/>
                                        </Border>
                                        <FontIcon Glyph="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource STTextDim}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource ST8_FlowChip}" Background="#214ade80" BorderBrush="#594ade80">
                                            <TextBlock Text="switch" Style="{StaticResource ST8_FlowChipText}" Foreground="{StaticResource STSuccess}"/>
                                        </Border>
                                        <FontIcon Glyph="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource STTextDim}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource ST8_FlowChip}">
                                            <TextBlock Text="stream starts" Style="{StaticResource ST8_FlowChipText}"/>
                                        </Border>
                                        <FontIcon Glyph="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource STTextDim}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource ST8_FlowChip}">
                                            <TextBlock Text="restore" Style="{StaticResource ST8_FlowChipText}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="Let clients change the link speed" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                            <ctrl:InfoHint Term="Link-speed switch" Tip="Permission, not configuration: the adapter is this PC's hardware. Turn it off while you need full speed for something else. Clients older than StreamLight 4.6.0 can't ask at all — they stream normally and leave the link alone."/>
                                        </StackPanel>
                                        <!-- One line: the version requirement is the part that
                                             can't be guessed, the rest lives in the hint. -->
                                        <TextBlock Style="{StaticResource ST_RowDescription}" TextWrapping="Wrap"
                                                   Text="StreamLight 4.6.0 or later asks for the speed that matches its own wired connection."/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource ST_Toggle}" VerticalAlignment="Center"
                                                  IsOn="{x:Bind Net.AllowClientControl, Mode=TwoWay}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="Status" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                            <ctrl:InfoHint Term="Link-speed switch" Tip="Who changed the link speed, from what, and when it goes back."/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Net.StatusDetailText, Mode=OneWay}" Style="{StaticResource ST_RowDescription}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" BorderThickness="1"
                                            Background="{x:Bind Net.StatusPillBgHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                            BorderBrush="{x:Bind Net.StatusPillBorderHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                        <TextBlock Text="{x:Bind Net.StatusPillText, Mode=OneWay}" FontFamily="{StaticResource DMSansSemiBold}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{x:Bind Net.StatusPillFgHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="Restore now" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                            <ctrl:InfoHint Term="Link-speed switch" Tip="Puts back the adapter's original setting — so an adapter left on Auto Negotiation stays on it."/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Net.RestoreDetailText, Mode=OneWay}" Style="{StaticResource ST_RowDescription}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Restore now" Style="{StaticResource ST_ButtonGreen}" Click="RestoreNow_Click"
                                            IsEnabled="{x:Bind Net.CanRestore, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TAILSCALE -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="TAILSCALE" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                        <ctrl:InfoHint Term="Tailscale" Tip="Your Tailscale VPN address, for connecting from outside your LAN. Install Tailscale to populate it."/>
                    </StackPanel>
                    <Border Style="{StaticResource ST8_GroupCard}">
                        <Border Style="{StaticResource ST8_Row}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{x:Bind Net.TailscaleIcon, Mode=OneWay}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Visibility="{x:Bind Net.HasTailscaleIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Net.TailscaleIp, Mode=OneWay}" Style="{StaticResource ST_MonoValue}"
                                           Foreground="{StaticResource STSuccess}" VerticalAlignment="Center"
                                           Visibility="{x:Bind Net.TailscaleDetected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Grid.Column="1" Text="Not detected" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"
                                           Visibility="{x:Bind Net.TailscaleDetected, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <Button Grid.Column="2" Style="{StaticResource ST_ButtonGhost}" Width="28" Height="28" Padding="0" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Click="CopyTailscaleIp_Click"
                                        Visibility="{x:Bind Net.TailscaleDetected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTipService.ToolTip="Copy to clipboard" AutomationProperties.Name="Copy Tailscale IP">
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" Glyph="&#xE8C8;"/>
                                </Button>
                                <TextBlock Grid.Column="3" Text="Copied!" Style="{StaticResource ST_RowDescription}" Foreground="{StaticResource STSuccess}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Visibility="{x:Bind Net.TailscaleCopiedVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </Border>
                </StackPanel>
                </ctrl:ResponsiveGrid>
            </StackPanel>

            <!-- ═══ CLIENTS — the StreamLight devices and what each may do ═══════════ -->
            <StackPanel x:Name="PanelClients" Style="{StaticResource ST8_PanelRoot}" Visibility="Collapsed">
                <TextBlock Text="StreamLight devices allowed to read this host and drive it: link speed, launch, power. Host management lets one change apps, spatial audio and Sentinel, and sync the library, too."
                           Style="{StaticResource ST9_PageSubtitle}" TextWrapping="Wrap"/>
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="DEVICES" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                        <ctrl:InfoHint Term="Client approval" Tip="Only approved StreamLight devices can use the advanced integration (host metrics, link-speed switch, power-off, …); streaming itself is never affected. New devices request access on first connection — approve them once here. Requires StreamLight 3.2.0 or later."/>
                    </StackPanel>

                    <!-- 10.0.0: shown once, after the upgrade gave Host management to the devices that
                         were already approved (plan 8.0 / 10.0, "Clients"). -->
                    <InfoBar IsOpen="{x:Bind Clients.HasHostManagementNotice, Mode=OneWay}" IsClosable="True"
                             Severity="Informational" Title="Host management"
                             Message="{x:Bind Clients.HostManagementNoticeText, Mode=OneWay}"
                             CloseButtonClick="HostManagementNotice_Close"/>

                    <ItemsControl ItemsSource="{x:Bind Clients.BridgeClients, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctrl:ResponsiveGrid MinColumnWidth="340" MaxColumns="1" ColumnSpacing="16" RowSpacing="16"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BridgeClientItem">
                                <Border Style="{StaticResource ST9_Card}">
                                    <StackPanel Spacing="14">
                                        <!-- Icon, name, status and the actions on one line: on a row of
                                             their own the buttons left an empty band in every card. -->
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- The icon says what the device is: click it to pick one of five kinds. -->
                                            <Button Style="{StaticResource ST9_ButtonGhost}" Padding="0" MinHeight="0" MinWidth="0" CornerRadius="9"
                                                    VerticalAlignment="Center" Tag="{x:Bind UniqueId}" Click="DeviceKind_Click"
                                                    AutomationProperties.Name="Device type"
                                                    ToolTipService.ToolTip="{x:Bind KindTip}">
                                                <Border Style="{StaticResource ST9_IconBubble}"
                                                        Background="{x:Bind IconBgHex, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16"
                                                              Foreground="{x:Bind IconFgHex, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                                </Border>
                                            </Button>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource ST9_RowTitle}"/>
                                                <TextBlock Text="{x:Bind SubText}" Style="{StaticResource ST9_Hint}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="4" Padding="7,2,7,3" BorderThickness="1"
                                                    Background="{x:Bind StatusBgHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                    BorderBrush="{x:Bind StatusBorderHex, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                                <TextBlock Text="{x:Bind StatusLabel}" Style="{StaticResource ST9_TagText}"
                                                           Foreground="{x:Bind StatusColorHex, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                            </Border>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Style="{StaticResource ST9_ButtonPrimary}" Content="Approve" Tag="{x:Bind UniqueId}" Click="ApproveClient_Click"
                                                        Visibility="{x:Bind CanApprove, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Style="{StaticResource ST9_ButtonDanger}" Content="Revoke" Tag="{x:Bind UniqueId}" Click="RevokeClient_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 10.0.0: may this device change the host's settings from StreamLight 8.0? -->
                                        <Grid ColumnSpacing="12"
                                              Visibility="{x:Bind IsApproved, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <TextBlock Text="Host management" Style="{StaticResource ST9_RowTitle}" VerticalAlignment="Center"/>
                                                    <ctrl:InfoHint Term="Host management" Tip="Lets this device change this host's settings from StreamLight 8.0 — managed apps, spatial audio and NVIDIA Sentinel — and run the Library's Sync and restart. Without it the device still sees them, read-only. Power, Windows Update and the link speed do not depend on it."/>
                                                </StackPanel>
                                                <TextBlock Text="Change apps, spatial audio and Sentinel, and sync the library, from StreamLight" Style="{StaticResource ST9_Hint}"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" Style="{StaticResource ST_Toggle}" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                                                          AutomationProperties.Name="Host management"
                                                          Tag="{x:Bind UniqueId}" IsOn="{x:Bind HostManagement}"
                                                          Toggled="HostManagement_Toggled"/>
                                        </Grid>

                                        <Border Style="{StaticResource ST9_Inset}" Padding="14,10"
                                                Visibility="{x:Bind HasPin, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Approve only if the device shows this PIN" Style="{StaticResource ST9_Small}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind PinText}" Style="{StaticResource ST9_Mono}" FontSize="20"
                                                           Foreground="{StaticResource ST9Text}" CharacterSpacing="200" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource ST9_Card}"
                            Visibility="{x:Bind Clients.HasNoBridgeClients, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="No devices yet. Open this host in StreamLight 3.2.0 or later: it asks for access here the first time it connects."
                                   Style="{StaticResource ST9_Body}"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ═══ SPATIAL AUDIO ═══════════════════════════════════════════════ -->
            <StackPanel x:Name="PanelAudio" Style="{StaticResource ST8_PanelRoot}" Visibility="Collapsed">
                <TextBlock Text="The audio format a stream gets, switched on when it starts and off when it ends." Style="{StaticResource ST9_PageSubtitle}" TextWrapping="Wrap"/>

                <ctrl:ResponsiveGrid MinColumnWidth="560" MaxColumns="1" ColumnSpacing="20" RowSpacing="22">
                <!-- AUDIO OUTPUT -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="AUDIO OUTPUT" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                        <ctrl:InfoHint Term="Spatial Audio" Tip="The headphone or speaker device that receives the spatial audio signal."/>
                    </StackPanel>
                    <ProgressRing IsActive="{x:Bind Aud.IsLoading, Mode=OneWay}" Width="22" Height="22" HorizontalAlignment="Left"
                                  Visibility="{x:Bind Aud.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Border Style="{StaticResource ST8_GroupCard}"
                            Visibility="{x:Bind Aud.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Border Style="{StaticResource ST8_Row}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Output device" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <ComboBox Grid.Column="1" MinWidth="280" MaxWidth="380" ItemsSource="{x:Bind Aud.Devices}"
                                          SelectedItem="{x:Bind Aud.SelectedDevice, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </Border>
                </StackPanel>

                <!-- SPATIAL AUDIO -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="SPATIAL AUDIO" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                        <ctrl:InfoHint Term="Spatial Audio" Tip="Dolby Atmos or Windows Sonic virtual surround for headphones. When Auto-activate is on, the chosen format is enabled at stream start."/>
                    </StackPanel>
                    <Border Style="{StaticResource ST8_GroupCard}">
                        <StackPanel>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <FontIcon Glyph="&#xE915;" FontSize="10"
                                                  Foreground="{x:Bind Aud.DolbyStatusColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Dolby Atmos for Headphones" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="DolbyToggle" Style="{StaticResource ST_Toggle}"
                                                  IsEnabled="{x:Bind Aud.IsDolbyAvailable, Mode=OneWay}" Toggled="DolbyToggle_Toggled" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <FontIcon Glyph="&#xE915;" FontSize="10"
                                                  Foreground="{x:Bind Aud.SonicStatusColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Windows Sonic for Headphones" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="SonicToggle" Style="{StaticResource ST_Toggle}"
                                                  IsEnabled="{x:Bind Aud.IsSonicAvailable, Mode=OneWay}" Toggled="SonicToggle_Toggled" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Auto-activate on stream" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                        <ctrl:InfoHint Term="Spatial Audio" Tip="Automatically activates the format below when a streaming session starts."/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource ST_Toggle}"
                                                  IsOn="{x:Bind Aud.SpatialAudioEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}" BorderThickness="0">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Format to activate" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <ComboBox Grid.Column="1" MinWidth="260" MaxWidth="320" SelectedIndex="{x:Bind Aud.AutoFormatIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="Dolby Atmos for Headphones"/>
                                            <ComboBoxItem Content="Windows Sonic for Headphones"/>
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                Visibility="{x:Bind Aud.HasLiveStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <FontIcon Glyph="&#xE915;" FontSize="10"
                                                  Foreground="{x:Bind Aud.LiveStatusColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind Aud.LiveStatusText, Mode=OneWay}" Style="{StaticResource ST_RowDescription}"
                                                   Foreground="{x:Bind Aud.LiveStatusColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                   TextWrapping="Wrap" MaxWidth="600" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ctrl:ResponsiveGrid>
            </StackPanel>

            <!-- ═══ NVIDIA SENTINEL — card-per-group + hover hints ════════════ -->
            <StackPanel x:Name="PanelNv" Style="{StaticResource ST8_PanelRoot}" Visibility="Collapsed">
                <TextBlock Text="{x:Bind Nv.GpuHeader, Mode=OneWay}" Style="{StaticResource ST9_PageSubtitle}" TextWrapping="Wrap"/>

                <ctrl:ResponsiveGrid MinColumnWidth="560" MaxColumns="1" ColumnSpacing="20" RowSpacing="22">
                <!-- USER PROFILE -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="USER PROFILE" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                        <ctrl:InfoHint Term="NVIDIA Sentinel" Tip="Capture a snapshot of your NVIDIA global driver profile. StreamTweak stores every setting you changed from the driver default and can re-apply it whenever NVIDIA App resets the profile."/>
                    </StackPanel>
                    <Border Style="{StaticResource ST8_GroupCard}">
                        <Border Style="{StaticResource ST8_Row}" BorderThickness="0">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Save current as my profile" Style="{StaticResource ST_ButtonGreen}"
                                            IsEnabled="{x:Bind Nv.IsNotBusy, Mode=OneWay}" Click="SaveProfile_Click"/>
                                    <Button Content="Restore my profile" Style="{StaticResource ST_ButtonSecondary}"
                                            IsEnabled="{x:Bind Nv.IsNotBusy, Mode=OneWay}" Click="RestoreProfile_Click"/>
                                    <Button Content="Clear my profile" Style="{StaticResource ST_ButtonDanger}"
                                            IsEnabled="{x:Bind Nv.HasSnapshot, Mode=OneWay}" Click="ClearProfile_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                    <ProgressRing IsActive="{x:Bind Nv.IsBusy, Mode=OneWay}" Width="16" Height="16"
                                                  Visibility="{x:Bind Nv.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{x:Bind Nv.ProfileSavedText, Mode=OneWay}" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind Nv.CapturedCountText, Mode=OneWay}" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"
                                               Visibility="{x:Bind Nv.HasSnapshot, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                                <InfoBar IsOpen="{x:Bind Nv.HasStatusMessage, Mode=OneWay}"
                                         Visibility="{x:Bind Nv.HasStatusMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                         Severity="Informational" Message="{x:Bind Nv.StatusMessage, Mode=OneWay}" IsClosable="False">
                                    <InfoBar.Resources><SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#4ade80"/></InfoBar.Resources>
                                </InfoBar>
                            </StackPanel>
                        </Border>
                    </Border>
                </StackPanel>

                <!-- AUTO-RESTORE -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="AUTO-RESTORE" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                        <ctrl:InfoHint Term="Auto-restore" Tip="When armed, StreamTweak watches the NVIDIA driver settings database and silently re-applies your saved profile whenever NVIDIA App resets it."/>
                    </StackPanel>
                    <Border Style="{StaticResource ST8_GroupCard}">
                        <StackPanel>
                            <!-- Armed but unable to re-apply: the one state where auto-restore
                                 looks on and is doing nothing, so it has to say so. -->
                            <InfoBar IsOpen="{x:Bind Nv.IsStuck, Mode=OneWay}"
                                     Visibility="{x:Bind Nv.IsStuck, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Severity="Warning" Title="Auto-restore is not working"
                                     Message="{x:Bind Nv.StuckMessage, Mode=OneWay}"
                                     IsClosable="False" Margin="0,12,0,2"/>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Auto-restore my profile" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource ST_Toggle}"
                                                  IsOn="{x:Bind Nv.AutoRestoreEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Last auto-restore:" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind Nv.LastRestoreText, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Open log file" Style="{StaticResource ST_ButtonSecondary}" Click="OpenLog_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ctrl:ResponsiveGrid>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="{x:Bind Nv.CapturedExpanded, Mode=TwoWay}">
                    <!-- The header in the card black and border (WinUI's default is a lighter
                         grey card); the content already draws its own panel below. -->
                    <Expander.Resources>
                        <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="STCard"/>
                        <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="STBorder"/>
                        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent"/>
                    </Expander.Resources>
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CAPTURED SETTINGS" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Nv.ReadableCountText, Mode=OneWay}" Style="{StaticResource ST_RowDescription}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                        </Grid>
                    </Expander.Header>
                    <Border Background="#0A0908" BorderBrush="{StaticResource STBorder}" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0">
                        <StackPanel Padding="20,14,24,16" Spacing="0">
                            <StackPanel.Resources>
                                <!-- 8.0 font unification: was a Cascadia/Consolas terminal look.
                                     Safe to switch — the name/value alignment here comes from the
                                     Grid columns below, not from fixed character width. -->
                                <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DMSans}"/></Style>
                            </StackPanel.Resources>
                            <TextBlock Text="// GLOBAL DRIVER PROFILE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource STSuccess}" Margin="0,0,0,3"/>
                            <Rectangle Height="0.5" Fill="{StaticResource STBorderActive}" Margin="0,0,0,10"/>
                            <TextBlock Text="No human-readable settings captured. Click &#x201C;Save current as my profile&#x201D; to take a snapshot."
                                       FontSize="12" Foreground="{StaticResource STTextMuted}" TextWrapping="Wrap"
                                       Visibility="{x:Bind Nv.HasReadableSettings, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <ItemsControl ItemsSource="{x:Bind Nv.CapturedSettings}"
                                          Visibility="{x:Bind Nv.HasReadableSettings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CapturedSettingVM">
                                        <Grid Margin="0,3,0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{x:Bind DisplayName}" FontSize="12.5" Foreground="{StaticResource STTextPrimary}" TextWrapping="NoWrap"/>
                                                <TextBlock Text="{x:Bind HexId}" FontSize="12" Foreground="{StaticResource STTextMuted}" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ValueLabel}" FontSize="12.5" Foreground="{StaticResource STSuccess}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>

            <!-- ═══ APPS — Library-style single container ════════════════════════ -->
            <StackPanel x:Name="PanelApps" Style="{StaticResource ST8_PanelRoot}" Visibility="Collapsed">
                <TextBlock Text="Apps closed when a stream starts and relaunched when it ends, so they cannot steal frames or bandwidth." Style="{StaticResource ST9_PageSubtitle}" TextWrapping="Wrap"/>

                <InfoBar Visibility="{x:Bind AppsVm.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                         IsOpen="{x:Bind AppsVm.HasStatus, Mode=OneWay}"
                         Severity="{x:Bind AppsVm.StatusIsError, Mode=OneWay, Converter={StaticResource BoolToInfoBarSeverityConverter}}"
                         Message="{x:Bind AppsVm.StatusText, Mode=OneWay}" IsClosable="True" Closed="StatusInfoBar_Closed">
                    <InfoBar.Resources><SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#4ade80"/></InfoBar.Resources>
                </InfoBar>

                <!-- One container card holds the toolbar + the app list (Library style) -->
                <Border Style="{StaticResource ST_CardNoPad}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,16,20,12">
                            <!-- The menu is built when it opens: the programs running at that moment (AddMenu_Opening). -->
                            <Button Content="Add app" Style="{StaticResource ST_ButtonSecondary}">
                                <Button.Flyout>
                                    <MenuFlyout x:Name="AddMenu" Placement="BottomEdgeAlignedLeft" Opening="AddMenu_Opening"/>
                                </Button.Flyout>
                            </Button>
                            <Button Content="Remove" Style="{StaticResource ST_ButtonSecondary}" IsEnabled="{x:Bind AppsVm.HasSelection, Mode=OneWay}" Click="RemoveButton_Click"/>
                            <Button Content="End now" Style="{StaticResource ST_ButtonSecondary}" IsEnabled="{x:Bind AppsVm.HasSelection, Mode=OneWay}" Click="KillButton_Click"
                                    ToolTipService.ToolTip="Immediately terminate the selected app"/>
                            <Button Content="Restart" Style="{StaticResource ST_ButtonSecondary}" IsEnabled="{x:Bind AppsVm.HasSelection, Mode=OneWay}" Click="RestartButton_Click"
                                    ToolTipService.ToolTip="Kill then relaunch the selected app"/>
                        </StackPanel>

                        <Border Style="{StaticResource ST_Separator}"/>

                        <ListView x:Name="AppListView" ItemsSource="{x:Bind AppsVm.Apps}" SelectedItem="{x:Bind AppsVm.SelectedApp, Mode=TwoWay}"
                                  SelectionMode="Single" MaxHeight="620" Padding="20,12,20,16"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppEntry">
                                    <Border Background="{StaticResource STInput}" BorderBrush="{StaticResource STBorder}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10,16,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{x:Bind Icon, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource ST_RowLabel}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind Path}" Style="{StaticResource ST_RowDescription}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ST_Toggle}" AutomationProperties.Name="{x:Bind Name}"
                                                          IsOn="{x:Bind AutoManage, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                          ToolTipService.ToolTip="Auto-manage on session start/end"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>

          </Grid>
          </StackPanel>
        </ScrollViewer>
    </Grid>

</Page>
