<Page
    x:Class="StreamTweak.Views.AudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Padding="20,16,20,24">

            <!-- ── Audio Output Device card ──────────────────────────────── -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel Spacing="10">

                    <TextBlock Text="Audio Output Device"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>

                    <TextBlock Text="Select the headphone or speaker device that receives the spatial audio signal."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7" TextWrapping="Wrap"/>

                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="24" Height="24"
                                  HorizontalAlignment="Left"
                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay,
                                               Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <ComboBox ItemsSource="{x:Bind ViewModel.Devices}"
                              SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay,
                                           Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                </StackPanel>
            </Border>

            <!-- ── Spatial Audio Format card ─────────────────────────────────── -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel Spacing="12">

                    <TextBlock Text="Spatial Audio Format"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>

                    <!-- Dolby Atmos toggle row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE915;" FontSize="10"
                                      Foreground="{x:Bind ViewModel.DolbyStatusColorHex, Mode=OneWay,
                                                   Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                            <TextBlock Text="Dolby Atmos for Headphones"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="DolbyToggle"
                                      IsEnabled="{x:Bind ViewModel.IsDolbyAvailable, Mode=OneWay}"
                                      Toggled="DolbyToggle_Toggled"
                                      OffContent="{x:Null}" OnContent="{x:Null}"
                                      MinWidth="0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- Windows Sonic toggle row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE915;" FontSize="10"
                                      Foreground="{x:Bind ViewModel.SonicStatusColorHex, Mode=OneWay,
                                                   Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                            <TextBlock Text="Windows Sonic for Headphones"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="SonicToggle"
                                      IsEnabled="{x:Bind ViewModel.IsSonicAvailable, Mode=OneWay}"
                                      Toggled="SonicToggle_Toggled"
                                      OffContent="{x:Null}" OnContent="{x:Null}"
                                      MinWidth="0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ── Auto Spatial Audio card ───────────────────────────────── -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel Spacing="12">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2"
                                    Margin="0,0,8,0">
                            <TextBlock Text="Auto Spatial Audio"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Automatically activates the selected spatial audio format when a streaming session starts."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.7" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.SpatialAudioEnabled, Mode=TwoWay}"
                                      OffContent="{x:Null}" OnContent="{x:Null}"
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- Format to auto-activate when streaming starts -->
                    <ComboBox SelectedIndex="{x:Bind ViewModel.AutoFormatIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Dolby Atmos for Headphones"/>
                        <ComboBoxItem Content="Windows Sonic for Headphones"/>
                    </ComboBox>

                    <!-- Auto-monitor status (Ready / Active session detected / ✓ enabled / errors) -->
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                Visibility="{x:Bind ViewModel.HasLiveStatus, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE915;" FontSize="10"
                                  Foreground="{x:Bind ViewModel.LiveStatusColorHex, Mode=OneWay,
                                               Converter={StaticResource HexToSolidColorBrushConverter}}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.LiveStatusText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{x:Bind ViewModel.LiveStatusColorHex, Mode=OneWay,
                                                Converter={StaticResource HexToSolidColorBrushConverter}}"
                                   TextWrapping="Wrap" MaxWidth="600"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</Page>
