<Page
    x:Class="StreamTweak.Views.AudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource STBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="28,24,28,28">

            <!-- Page title -->
            <StackPanel Spacing="3" Margin="0,0,0,4">
                <TextBlock Text="Audio" Style="{StaticResource ST_PageTitle}"/>
                <TextBlock Text="Spatial audio device and format selection."
                           Style="{StaticResource ST_PageSubtitle}"/>
            </StackPanel>

            <!-- ── Audio Output Device ───────────────────────────────────────── -->
            <Border Style="{StaticResource ST_Card}">
                <StackPanel Spacing="12">

                    <TextBlock Text="AUDIO OUTPUT DEVICE" Style="{StaticResource ST_SectionLabel}"/>

                    <TextBlock Text="Select the headphone or speaker device that receives the spatial audio signal."
                               Style="{StaticResource ST_RowDescription}"/>

                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="24" Height="24"
                                  HorizontalAlignment="Left"
                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay,
                                               Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <ComboBox ItemsSource="{x:Bind ViewModel.Devices}"
                              SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.AutomationId="AudioOutputDeviceComboBox"
                              AutomationProperties.Name="Audio output device"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay,
                                           Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                </StackPanel>
            </Border>

            <!-- ── Spatial Audio Format ──────────────────────────────────────── -->
            <Border Style="{StaticResource ST_Card}">
                <StackPanel Spacing="0">

                    <TextBlock Text="SPATIAL AUDIO FORMAT"
                               Style="{StaticResource ST_SectionLabel}"
                               Margin="0,0,0,14"/>

                    <!-- Dolby Atmos row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE915;" FontSize="10"
                                      Foreground="{x:Bind ViewModel.DolbyStatusColorHex, Mode=OneWay,
                                                   Converter={StaticResource HexToSolidColorBrushConverter}}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Dolby Atmos for Headphones"
                                       Style="{StaticResource ST_RowLabel}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      x:Name="DolbyToggle"
                                      Style="{StaticResource ST_Toggle}"
                                      AutomationProperties.AutomationId="DolbyAtmosToggle"
                                      AutomationProperties.Name="Dolby Atmos for Headphones"
                                      IsEnabled="{x:Bind ViewModel.IsDolbyAvailable, Mode=OneWay}"
                                      Toggled="DolbyToggle_Toggled"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <Border Style="{StaticResource ST_Separator}" Margin="0,0,0,12"/>

                    <!-- Windows Sonic row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE915;" FontSize="10"
                                      Foreground="{x:Bind ViewModel.SonicStatusColorHex, Mode=OneWay,
                                                   Converter={StaticResource HexToSolidColorBrushConverter}}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Windows Sonic for Headphones"
                                       Style="{StaticResource ST_RowLabel}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      x:Name="SonicToggle"
                                      Style="{StaticResource ST_Toggle}"
                                      AutomationProperties.AutomationId="WindowsSonicToggle"
                                      AutomationProperties.Name="Windows Sonic for Headphones"
                                      IsEnabled="{x:Bind ViewModel.IsSonicAvailable, Mode=OneWay}"
                                      Toggled="SonicToggle_Toggled"
                                      VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ── Auto Spatial Audio ────────────────────────────────────────── -->
            <Border Style="{StaticResource ST_Card}">
                <StackPanel Spacing="14">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3" Margin="0,0,16,0">
                            <TextBlock Text="AUTO SPATIAL AUDIO" Style="{StaticResource ST_SectionLabel}"/>
                            <TextBlock Text="Automatically activates the selected spatial audio format when a streaming session starts."
                                       Style="{StaticResource ST_RowDescription}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      Style="{StaticResource ST_Toggle}"
                                      AutomationProperties.AutomationId="AutoSpatialAudioToggle"
                                      AutomationProperties.Name="Auto spatial audio"
                                      IsOn="{x:Bind ViewModel.SpatialAudioEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <ComboBox SelectedIndex="{x:Bind ViewModel.AutoFormatIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.AutomationId="AutoSpatialFormatComboBox"
                              AutomationProperties.Name="Auto spatial audio format">
                        <ComboBoxItem Content="Dolby Atmos for Headphones"/>
                        <ComboBoxItem Content="Windows Sonic for Headphones"/>
                    </ComboBox>

                    <!-- Live status indicator -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.HasLiveStatus, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE915;" FontSize="10"
                                  Foreground="{x:Bind ViewModel.LiveStatusColorHex, Mode=OneWay,
                                               Converter={StaticResource HexToSolidColorBrushConverter}}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.LiveStatusText, Mode=OneWay}"
                                   Style="{StaticResource ST_RowDescription}"
                                   Foreground="{x:Bind ViewModel.LiveStatusColorHex, Mode=OneWay,
                                                Converter={StaticResource HexToSolidColorBrushConverter}}"
                                   TextWrapping="Wrap" MaxWidth="600"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</Page>
