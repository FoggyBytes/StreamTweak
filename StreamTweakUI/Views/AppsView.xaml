<Page
    x:Class="StreamTweak.Views.AppsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StreamTweak.ViewModels"
    Background="Transparent">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- status bar -->
            <RowDefinition Height="*"/>     <!-- main card -->
        </Grid.RowDefinitions>

        <!-- ── Status InfoBar ────────────────────────────────────────────── -->
        <InfoBar Grid.Row="0"
                 Margin="20,16,20,0"
                 IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.StatusIsError, Mode=OneWay,
                            Converter={StaticResource BoolToInfoBarSeverityConverter}}"
                 Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                 IsClosable="True"
                 Closed="StatusInfoBar_Closed"/>

        <!-- ── Main card ─────────────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                Margin="20,0,20,24">
            <Grid Margin="16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Text="Streaming App Manager"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,0,0,4"/>

                <!-- Description -->
                <TextBlock Grid.Row="1"
                           Text="Apps in this list are closed when a streaming session starts and relaunched when it ends."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Opacity="0.7" TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <!-- App list -->
                <ListView Grid.Row="2"
                          x:Name="AppListView"
                          ItemsSource="{x:Bind ViewModel.Apps}"
                          SelectedItem="{x:Bind ViewModel.SelectedApp, Mode=TwoWay}"
                          SelectionMode="Single"
                          Margin="0,0,0,12">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppEntry">
                            <!-- Row card — same styling as GameLibraryView rows -->
                            <Border Margin="0"
                                    Padding="10,8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Exe icon -->
                                    <Image Grid.Column="0"
                                           Source="{x:Bind Icon, Mode=OneWay}"
                                           Width="20" Height="20"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                    <!-- Name + path -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1"
                                                Margin="0,0,8,0">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   FontSize="13"/>
                                        <TextBlock Text="{x:Bind Path}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Opacity="0.55"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- AutoManage toggle -->
                                    <ToggleSwitch Grid.Column="2"
                                                 IsOn="{x:Bind AutoManage, Mode=TwoWay}"
                                                 OffContent="{x:Null}" OnContent="{x:Null}"
                                                 MinWidth="0"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Left"
                                                 ToolTipService.ToolTip="Auto-manage on session start/end"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Action buttons -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            Spacing="8">

                    <Button Content="Add"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="AddButton_Click"/>

                    <Button Content="Remove"
                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                            Click="RemoveButton_Click"/>

                    <Button Content="End now"
                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                            Click="KillButton_Click"
                            ToolTipService.ToolTip="Immediately terminate the selected app"/>

                    <Button Content="Restart"
                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                            Click="RestartButton_Click"
                            ToolTipService.ToolTip="Kill then relaunch the selected app"/>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Page>
