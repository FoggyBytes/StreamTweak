<Page
    x:Class="StreamTweak.Views.AppsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StreamTweak.ViewModels"
    Background="{StaticResource STBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- status bar -->
            <RowDefinition Height="*"/>     <!-- main card -->
        </Grid.RowDefinitions>

        <!-- Dynamic status InfoBar (keep as InfoBar — closable) -->
        <InfoBar Grid.Row="0"
                 Margin="28,24,28,0"
                 IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.StatusIsError, Mode=OneWay,
                            Converter={StaticResource BoolToInfoBarSeverityConverter}}"
                 Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                 IsClosable="True"
                 Closed="StatusInfoBar_Closed"/>

        <!-- ── Main card ─────────────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Style="{StaticResource ST_CardNoPad}"
                Margin="28,12,28,28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Spacing="3" Margin="20,16,20,10">
                    <TextBlock Text="STREAMING APP MANAGER" Style="{StaticResource ST_SectionLabel}"/>
                    <TextBlock Text="Apps in this list are closed when a streaming session starts and relaunched when it ends."
                               Style="{StaticResource ST_RowDescription}"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource ST_Separator}"/>

                <!-- App list -->
                <ListView Grid.Row="2"
                          x:Name="AppListView"
                          ItemsSource="{x:Bind ViewModel.Apps}"
                          SelectedItem="{x:Bind ViewModel.SelectedApp, Mode=TwoWay}"
                          SelectionMode="Single"
                          Padding="20,8,20,8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppEntry">
                            <Border Background="{StaticResource STInput}"
                                    BorderBrush="{StaticResource STBorder}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Exe icon -->
                                    <Image Grid.Column="0"
                                           Source="{x:Bind Icon, Mode=OneWay}"
                                           Width="20" Height="20"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>

                                    <!-- Name + path -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource ST_RowLabel}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Path}"
                                                   Style="{StaticResource ST_RowDescription}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- AutoManage toggle -->
                                    <ToggleSwitch Grid.Column="2"
                                                  Style="{StaticResource ST_Toggle}"
                                                  IsOn="{x:Bind AutoManage, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Right"
                                                  ToolTipService.ToolTip="Auto-manage on session start/end"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Action buttons -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="20,0,20,16">

                    <Button Content="Add"
                            Style="{StaticResource ST_ButtonPrimary}"
                            Click="AddButton_Click"/>

                    <Button Content="Remove"
                            Style="{StaticResource ST_ButtonSecondary}"
                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                            Click="RemoveButton_Click"/>

                    <Button Content="End now"
                            Style="{StaticResource ST_ButtonSecondary}"
                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                            Click="KillButton_Click"
                            ToolTipService.ToolTip="Immediately terminate the selected app"/>

                    <Button Content="Restart"
                            Style="{StaticResource ST_ButtonSecondary}"
                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                            Click="RestartButton_Click"
                            ToolTipService.ToolTip="Kill then relaunch the selected app"/>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Page>
