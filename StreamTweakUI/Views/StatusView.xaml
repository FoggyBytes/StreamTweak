<Page
    x:Class="StreamTweak.Views.StatusView"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StreamTweak.ViewModels"
    xmlns:ctrl="using:StreamTweak.Controls"
    Background="{StaticResource STBackground}">

    <!-- 10.0 Status, the page StreamTweak opens on and the one the README shows (plan phase 4,
         mockup «Vetrina» B, 22/10): a hero over the covers of the games on this PC, three figures,
         then what needs you, the stream running now and eight tiles on solid surfaces, each opening
         the page that sets it. Nothing here floats on Mica: every block has a surface of its own. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel x:Name="PageRoot" Padding="32,24,32,40" Spacing="14">

            <!-- ── Hero ──────────────────────────────────────────────────────────────────── -->
            <Grid x:Name="Hero" MinHeight="208" CornerRadius="14" Background="{StaticResource ST10Hero}"
                  BorderBrush="{StaticResource ST9CardStroke}" BorderThickness="1" SizeChanged="Hero_SizeChanged">
                <!-- The brand's light, top left and bottom right -->
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#384ade80" Offset="0"/>
                            <GradientStop Color="#004ade80" Offset="0.45"/>
                            <GradientStop Color="#0038bdf8" Offset="0.6"/>
                            <GradientStop Color="#2438bdf8" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- The covers of the games on this PC, tilted, filled in code (BuildCoverWall) -->
                <Canvas x:Name="CoverWall" Width="600" HorizontalAlignment="Right" Opacity="0.55" IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="-8"/>
                    </Canvas.RenderTransform>
                </Canvas>
                <!-- …fading into the hero's own colour under the words -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF141716" Offset="0"/>
                            <GradientStop Color="#FF141716" Offset="0.36"/>
                            <GradientStop Color="#C0141716" Offset="0.58"/>
                            <GradientStop Color="#33141716" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid Padding="28,26" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="6">
                        <Border HorizontalAlignment="Left" CornerRadius="12" Padding="10,3,12,4" BorderThickness="1"
                                Background="#14FFFFFF" BorderBrush="#24FFFFFF">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{x:Bind ViewModel.EyebrowHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                <TextBlock Text="{x:Bind ViewModel.Eyebrow, Mode=OneWay}" FontFamily="{StaticResource DMSansSemiBold}" FontSize="12"
                                           Foreground="{StaticResource ST9Text2}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.HeroTitle, Mode=OneWay}" FontFamily="{StaticResource DMSansSemiBold}" FontSize="34"
                                   CharacterSpacing="-20" Foreground="{StaticResource ST9Text}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="{x:Bind ViewModel.HeroSub, Mode=OneWay}" Style="{StaticResource ST9_Body}" Foreground="{StaticResource ST9Text2}"
                                   TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- The three figures -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Style="{StaticResource ST10_HeroKpi}">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{x:Bind ViewModel.KpiLink, Mode=OneWay}" Style="{StaticResource ST10_HeroKpiValue}"/>
                                    <TextBlock Text="{x:Bind ViewModel.KpiLinkUnit, Mode=OneWay}" Style="{StaticResource ST10_HeroKpiUnit}"/>
                                </StackPanel>
                                <TextBlock Text="Wired link" Style="{StaticResource ST10_HeroKpiLabel}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ST10_HeroKpi}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.KpiGames, Mode=OneWay}" Style="{StaticResource ST10_HeroKpiValue}"/>
                                <TextBlock Text="Games listed" Style="{StaticResource ST10_HeroKpiLabel}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ST10_HeroKpi}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.KpiGrade, Mode=OneWay}" Style="{StaticResource ST10_HeroKpiValue}"
                                           Foreground="{x:Bind ViewModel.KpiGradeHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                <TextBlock Text="{x:Bind ViewModel.KpiGradeWhen, Mode=OneWay}" Style="{StaticResource ST10_HeroKpiLabel}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ── Getting started: the first run's four steps, until they are done or hidden ── -->
            <Border Style="{StaticResource ST10_Panel}" BorderBrush="{StaticResource ST9MintStroke}"
                    Visibility="{x:Bind ViewModel.ShowSteps, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="{x:Bind ViewModel.StepsCaption, Mode=OneWay}" Style="{StaticResource ST_SectionLabel}"
                                   Foreground="{StaticResource ST9Mint}" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource ST9_ButtonGhost}" Content="Hide" Click="HideSteps_Click"/>
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ST10_Step}">
                            <StackPanel Spacing="3">
                                <FontIcon Glyph="{x:Bind StepGlyph(ViewModel.StepServer), Mode=OneWay}" FontSize="14" HorizontalAlignment="Left"
                                          Foreground="{x:Bind StepBrush(ViewModel.StepServer), Mode=OneWay}"/>
                                <TextBlock Text="Streaming server" Style="{StaticResource ST9_RowTitle}"/>
                                <TextBlock Text="Sunshine, Apollo, Vibeshine or Vibepollo on this PC" Style="{StaticResource ST9_Hint}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ST10_Step}">
                            <StackPanel Spacing="3">
                                <FontIcon Glyph="{x:Bind StepGlyph(ViewModel.StepPort), Mode=OneWay}" FontSize="14" HorizontalAlignment="Left"
                                          Foreground="{x:Bind StepBrush(ViewModel.StepPort), Mode=OneWay}"/>
                                <TextBlock Text="Bridge port open" Style="{StaticResource ST9_RowTitle}"/>
                                <TextBlock Text="TCP 47998 in Windows Firewall, set by the installer" Style="{StaticResource ST9_Hint}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource ST10_Step}">
                            <StackPanel Spacing="3">
                                <FontIcon Glyph="{x:Bind StepGlyph(ViewModel.StepClient), Mode=OneWay}" FontSize="14" HorizontalAlignment="Left"
                                          Foreground="{x:Bind StepBrush(ViewModel.StepClient), Mode=OneWay}"/>
                                <TextBlock Text="Approve a device" Style="{StaticResource ST9_RowTitle}"/>
                                <TextBlock Text="Open this host in StreamLight: it asks for access here" Style="{StaticResource ST9_Hint}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource ST10_Step}">
                            <StackPanel Spacing="3">
                                <FontIcon Glyph="{x:Bind StepGlyph(ViewModel.StepApps), Mode=OneWay}" FontSize="14" HorizontalAlignment="Left"
                                          Foreground="{x:Bind StepBrush(ViewModel.StepApps), Mode=OneWay}"/>
                                <TextBlock Text="Choose your apps" Style="{StaticResource ST9_RowTitle}"/>
                                <TextBlock Text="Closed while you stream · Setup › Apps" Style="{StaticResource ST9_Hint}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Needs you: a device asking for access ──────────────────────────────────── -->
            <Border Style="{StaticResource ST10_Panel}" Background="#FF231E12" BorderBrush="#59fbbf24" Padding="18,14"
                    Visibility="{x:Bind ViewModel.HasPending, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource ST9AmberSoft}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8CC;" FontSize="18" Foreground="{StaticResource ST9Amber}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.PendingTitle, Mode=OneWay}" Style="{StaticResource ST9_CardTitle}"/>
                        <TextBlock Text="{x:Bind ViewModel.PendingMore, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource ST10Code}" BorderBrush="{StaticResource ST9Stroke2}" BorderThickness="1"
                            CornerRadius="8" Padding="14,4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.PendingPin, Mode=OneWay}" Style="{StaticResource ST9_Mono}" FontSize="22"
                                   Foreground="{StaticResource ST9Text}" CharacterSpacing="300"/>
                    </Border>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Style="{StaticResource ST9_ButtonGhost}" Content="Deny" Click="Deny_Click"/>
                        <Button Style="{StaticResource ST9_ButtonSubtle}" Content="Approve" Click="Approve_Click"/>
                        <Button Style="{StaticResource ST9_ButtonPrimary}" Content="With host management" Click="ApproveManage_Click"
                                ToolTipService.ToolTip="Also lets it change managed apps, spatial audio and NVIDIA Sentinel, and sync the library, from StreamLight"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Streaming now ────────────────────────────────────────────────────────────── -->
            <Border Style="{StaticResource ST10_Panel}" Background="#FF132219" BorderBrush="{StaticResource ST9MintStroke}" Padding="18,14"
                    Visibility="{x:Bind ViewModel.Streaming, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="60" CornerRadius="5" Background="{StaticResource ST10Code}"
                            Visibility="{x:Bind ViewModel.HasLiveCover, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Through the converter: a bare string bound to Source makes x:Bind call
                             ConvertValue, which throws on null — and took the whole app down at start. -->
                        <Image Source="{x:Bind ViewModel.LiveCover, Mode=OneWay, Converter={StaticResource CoverPathToBitmapRowConverter}}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="STREAMING NOW" Style="{StaticResource ST_SectionLabel}" Foreground="{StaticResource ST9Mint}"/>
                        <TextBlock Text="{x:Bind ViewModel.LiveTitle, Mode=OneWay}" Style="{StaticResource ST9_CardTitle}"/>
                        <TextBlock Text="{x:Bind ViewModel.LiveSub, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource ST9_ButtonSubtle}" Content="Return to client" VerticalAlignment="Center"
                            Click="ReturnToClient_Click"
                            ToolTipService.ToolTip="Asks StreamLight to end the stream and go back to its own screen"/>
                </Grid>
            </Border>

            <!-- ── The eight tiles ────────────────────────────────────────────────────────── -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctrl:ResponsiveGrid MinColumnWidth="230" MaxColumns="4" ColumnSpacing="12" RowSpacing="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatusRow">
                        <Button Style="{StaticResource ST10_Tile}" Padding="16,14" Tag="{x:Bind Target}" Click="Tile_Click"
                                Background="{x:Bind FillHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                BorderBrush="{x:Bind BorderHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                AutomationProperties.Name="{x:Bind Name}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Top"
                                        Background="{x:Bind BubbleHex, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="19"
                                              Foreground="{x:Bind IconHex, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3" MinWidth="0">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource ST9_RowTitle}" VerticalAlignment="Center"/>
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                 Fill="{x:Bind DotHex, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{x:Bind Value}" FontFamily="{StaticResource DMSansSemiBold}" FontSize="20"
                                                   Foreground="{StaticResource ST9Text}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Unit}" Style="{StaticResource ST9_Hint}" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                                   Visibility="{x:Bind HasUnit, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Line}" FontSize="12.5" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                               Foreground="{x:Bind LineHex, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                    <Button Style="{StaticResource ST9_ButtonSubtle}" Content="Restore now" Margin="0,6,0,0" HorizontalAlignment="Left"
                                            Visibility="{x:Bind CanRestore, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Click="RestoreLink_Click"
                                            ToolTipService.ToolTip="Put the adapter back to its normal speed now"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
