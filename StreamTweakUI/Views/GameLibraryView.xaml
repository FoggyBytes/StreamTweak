<Page
    x:Class="StreamTweak.Views.GameLibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StreamTweak.ViewModels"
    xmlns:ctrl="using:StreamTweak.Controls"
    Background="{StaticResource STBackground}">

    <!-- ═══════════════════════════════════════════════════════════════════════
         9.0 Library. The page is one GridView (virtualised: only the covers on screen
         are decoded), with everything above the covers in its Header so it all scrolls
         as one. The cover size is worked out from the width in code-behind, in the shared content
         column (Controls/PageLayout). A game opens in a sheet on the right.
    ════════════════════════════════════════════════════════════════════════ -->

    <Page.Resources>
        <!-- Cover tile -->
        <DataTemplate x:Key="GameTileTemplate" x:DataType="vm:ObservableGameEntry">
            <Grid Padding="6,6,6,2" Background="Transparent"
                  PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited" PointerCanceled="Tile_PointerExited">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border CornerRadius="8" Background="{StaticResource ST9Inset}" BorderBrush="{StaticResource ST9Stroke}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource ST9_Small}" TextAlignment="Center"
                                   VerticalAlignment="Center" Margin="10" Visibility="{x:Bind NameFallbackVisibility}"/>
                        <Image Source="{x:Bind CoverPath, Converter={StaticResource CoverPathToBitmapTileConverter}}"
                               Stretch="UniformToFill" Opacity="{x:Bind CoverOpacity, Mode=OneWay}"/>

                        <!-- Store badge (bottom-right; hidden under the hover actions) / manual tag -->
                        <Border x:Name="StoreBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" Width="24" Height="24" CornerRadius="7"
                                Background="#B3141616" Visibility="{x:Bind ShowBadge, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTipService.ToolTip="{x:Bind BadgeLabel}">
                            <Image Width="14" Height="14">
                                <Image.Source><SvgImageSource UriSource="{x:Bind BadgeUri}"/></Image.Source>
                            </Image>
                        </Border>
                        <Border Style="{StaticResource ST9_TagGreen}" Margin="7" VerticalAlignment="Top" Background="#E6141616"
                                Visibility="{x:Bind ManualVisibility}">
                            <TextBlock Text="Manual" Style="{StaticResource ST9_TagTextGreen}"/>
                        </Border>
                        <Border Style="{StaticResource ST9_TagGrey}" Margin="7" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E6141616"
                                Visibility="{x:Bind HiddenVisibility, Mode=OneWay}">
                            <TextBlock Text="Hidden" Style="{StaticResource ST9_TagText}"/>
                        </Border>

                        <!-- Hover actions (mouse). Touch and controller open the sheet, which has them all. -->
                        <Grid x:Name="Overlay" Opacity="0" IsHitTestVisible="False">
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                        <GradientStop Color="#C0000000" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="0.6"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                <Button Style="{StaticResource ST9_ButtonPrimary}" Width="36" Height="36" Padding="0" CornerRadius="18"
                                        Click="TilePlay_Click" ToolTipService.ToolTip="Play on this PC" AutomationProperties.Name="Play on this PC">
                                    <FontIcon Glyph="&#xE768;" FontSize="13"/>
                                </Button>
                                <Button Style="{StaticResource ST9_IconButton}" Width="36" Height="36" CornerRadius="18" Background="#33FFFFFF"
                                        Content="&#xED43;" Click="TileFolder_Click" ToolTipService.ToolTip="Open install folder"
                                        Visibility="{x:Bind ShowFolderButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Style="{StaticResource ST9_IconButton}" Width="36" Height="36" CornerRadius="18" Background="#33FFFFFF"
                                        Content="&#xE712;" Click="TileDetails_Click" ToolTipService.ToolTip="Details"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{x:Bind Name}" Style="{StaticResource ST9_RowTitle}" FontSize="13" Margin="2,8,2,0"
                           ToolTipService.ToolTip="{x:Bind Name}"/>
                <TextBlock Grid.Row="2" Text="{x:Bind MetaText, Mode=OneWay}" Style="{StaticResource ST9_Hint}" FontSize="12" Margin="2,0,2,0"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <SplitView x:Name="Sheet" PanePlacement="Right" DisplayMode="Overlay" IsPaneOpen="False" OpenPaneLength="440"
               LightDismissOverlayMode="On" PaneBackground="{StaticResource ST9Pane}" PaneClosed="Sheet_PaneClosed">

        <!-- ═════════════════════════════ GAME SHEET ═════════════════════════════ -->
        <SplitView.Pane>
            <Grid BorderBrush="{StaticResource ST9CardStroke}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <!-- The cover's colours, as behind the Library hero; fades into the pane below. -->
                    <ctrl:CoverGradient CoverPath="{x:Bind ViewModel.SelectedCoverPath, Mode=OneWay}" Opacity="0.8"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                <GradientStop Color="#FF0C0C0E" Offset="0"/>
                                <GradientStop Color="#8C0C0C0E" Offset="0.6"/>
                                <GradientStop Color="#4D0C0C0E" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Grid Padding="20,18,16,18" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="118" Height="177" CornerRadius="8" Background="{StaticResource ST9Inset}"
                                BorderBrush="{StaticResource ST9Stroke2}" BorderThickness="1">
                            <Image Source="{x:Bind ViewModel.SelectedCoverPath, Mode=OneWay, Converter={StaticResource CoverPathToBitmapLargeConverter}}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="3">
                            <TextBlock Text="{x:Bind ViewModel.SheetStore, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                            <TextBlock Text="{x:Bind ViewModel.SheetTitle, Mode=OneWay}" FontSize="22" FontFamily="{StaticResource DMSansSemiBold}"
                                       Foreground="{StaticResource ST9Text}" TextWrapping="Wrap" MaxLines="3"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                                <Button Style="{StaticResource ST9_ButtonPrimary}" Click="SheetPlay_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="13"/>
                                        <TextBlock Text="Play on this PC"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ST9_IconButton}" Content="&#xED43;" Click="SheetFolder_Click"
                                        ToolTipService.ToolTip="Open install folder"
                                        Visibility="{x:Bind ViewModel.SheetHasFolder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ST9_IconButton}" VerticalAlignment="Top" Content="&#xE711;"
                                ToolTipService.ToolTip="Close (Esc)" Click="SheetClose_Click"/>
                    </Grid>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <StackPanel>
                        <!-- Stats -->
                        <Border Padding="20,16" BorderBrush="{StaticResource ST9Stroke}" BorderThickness="0,1,0,0">
                            <ctrl:ResponsiveGrid MinColumnWidth="90" MaxColumns="4" ColumnSpacing="14" RowSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Streamed" Style="{StaticResource ST9_Label}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SheetStreamed, Mode=OneWay}" Style="{StaticResource ST9_RowTitle}"/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Sessions" Style="{StaticResource ST9_Label}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SheetSessions, Mode=OneWay}" Style="{StaticResource ST9_RowTitle}"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Typical grade" Style="{StaticResource ST9_Label}"/>
                                    <Border HorizontalAlignment="Left" CornerRadius="4" Padding="7,2,7,3" BorderThickness="1"
                                            Background="{x:Bind ViewModel.SheetGradeBg, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                            BorderBrush="{x:Bind ViewModel.SheetGradeBorder, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                        <TextBlock Text="{x:Bind ViewModel.SheetGrade, Mode=OneWay}" Style="{StaticResource ST9_TagText}"
                                                   Foreground="{x:Bind ViewModel.SheetGradeFg, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Last streamed" Style="{StaticResource ST9_Label}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SheetLast, Mode=OneWay}" Style="{StaticResource ST9_RowTitle}"/>
                                </StackPanel>
                            </ctrl:ResponsiveGrid>
                        </Border>

                        <!-- Settings -->
                        <Border Padding="20,6" BorderBrush="{StaticResource ST9Stroke}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <Grid Padding="0,10" ColumnSpacing="12" BorderBrush="{StaticResource ST9Stroke}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.ShowInText, Mode=OneWay}" Style="{StaticResource ST9_RowTitle}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SheetSyncHint, Mode=OneWay}" Style="{StaticResource ST9_Hint}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SheetEnabledToggle" Grid.Column="1" Style="{StaticResource ST_Toggle}" MinWidth="0"
                                                  OnContent="" OffContent="" VerticalAlignment="Center" Toggled="SheetEnabled_Toggled"/>
                                </Grid>
                                <StackPanel Padding="0,10" Spacing="4">
                                    <TextBlock Text="Launched through" Style="{StaticResource ST9_RowTitle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SheetLaunch, Mode=OneWay}" Style="{StaticResource ST9_Mono}" FontSize="12"
                                               TextWrapping="Wrap" TextTrimming="None" IsTextSelectionEnabled="True"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Recent sessions -->
                        <Border Padding="20,16" BorderBrush="{StaticResource ST9Stroke}" BorderThickness="0,1,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="RECENT SESSIONS" Style="{StaticResource ST9_Eyebrow}"/>
                                <TextBlock Text="Not streamed yet." Style="{StaticResource ST9_Small}"
                                           Visibility="{x:Bind ViewModel.HasSheetRecent, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SheetRecent}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GameSessionRow">
                                            <Button Style="{StaticResource ST9_ButtonGhost}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    Padding="4,7" Tag="{x:Bind Id}" Click="SheetSession_Click">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Width="4" Height="30" RadiusX="2" RadiusY="2"
                                                               Fill="{x:Bind StripeHex, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource ST9_RowTitle}"/>
                                                        <TextBlock Text="{x:Bind Sub}" Style="{StaticResource ST9_Hint}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="4" Padding="7,2,7,3" BorderThickness="1"
                                                            Background="{x:Bind GradeBgHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                            BorderBrush="{x:Bind GradeBorderHex, Converter={StaticResource HexToSolidColorBrushConverter}}">
                                                        <TextBlock Text="{x:Bind GradeLabel}" Style="{StaticResource ST9_TagText}"
                                                                   Foreground="{x:Bind GradeFgHex, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Origin + remove -->
                        <Border Padding="20,14,20,24" BorderBrush="{StaticResource ST9Stroke}" BorderThickness="0,1,0,0">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.SheetOrigin, Mode=OneWay}" Style="{StaticResource ST9_Small}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource ST9_ButtonDanger}" Click="SheetRemove_Click"
                                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                        <TextBlock Text="Remove"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </SplitView.Pane>

        <!-- ═════════════════════════════ PAGE ═════════════════════════════ -->
        <GridView x:Name="LibraryGrid"
                  ItemsSource="{x:Bind ViewModel.FilteredGames}"
                  ItemTemplate="{StaticResource GameTileTemplate}"
                  ItemContainerStyle="{StaticResource ST9_CoverItem}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="Game_ItemClick"
                  SizeChanged="LibraryGrid_SizeChanged" GotFocus="LibraryGrid_GotFocus"
                  Padding="26,24,26,40">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="168" ItemHeight="290"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <GridView.Header>
                <StackPanel Spacing="16" Margin="6,0,6,14">
                    <!-- Header -->
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Library" Style="{StaticResource ST9_PageTitle}"/>
                            <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}" Style="{StaticResource ST9_PageSubtitle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20"
                                          Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Style="{StaticResource ST9_ButtonGhost}" Click="AddGame_Click" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                    ToolTipService.ToolTip="Add an executable by hand">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                    <TextBlock Text="Add game"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ST9_ButtonPrimary}" Click="SyncNow_Click" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE895;" FontSize="13"/>
                                    <TextBlock Text="Sync now"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ST9_IconButton}" Content="&#xE712;" ToolTipService.ToolTip="More">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="Clear sync…" Click="ClearSync_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Status (kept an InfoBar: closable). Visibility bound so a closed one leaves no gap. -->
                    <InfoBar Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                             IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                             Severity="{x:Bind ViewModel.StatusIsError, Mode=OneWay, Converter={StaticResource BoolToInfoBarSeverityConverter}}"
                             Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                             IsClosable="True" Closed="StatusInfoBar_Closed">
                        <InfoBar.Resources>
                            <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#4ade80"/>
                        </InfoBar.Resources>
                    </InfoBar>

                    <!-- Hero + side cards, half the width each; the row takes the taller of the two,
                         so the hero is always as tall as the two cards beside it -->
                    <ctrl:ResponsiveGrid Breakpoints="0,900" Columns="1,2" ColumnSpacing="16" RowSpacing="16"
                                         Visibility="{x:Bind ViewModel.HasGames, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Hero: the cover the pointer or the focus is on, else the default game -->
                        <Border x:Name="HeroCard" Style="{StaticResource ST9_Hero}"
                                SizeChanged="HeroCard_SizeChanged">
                            <Grid>
                                <!-- The cover's colours in a gradient (CoverGradient), under a veil that
                                     keeps the text side dark: a stretched 24 px cover showed its pixels. -->
                                <ctrl:CoverGradient CoverPath="{x:Bind ViewModel.HeroCoverPath, Mode=OneWay}" Opacity="0.8"/>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#CC0C0D0D" Offset="0"/>
                                            <GradientStop Color="#660C0D0D" Offset="0.6"/>
                                            <GradientStop Color="#100C0D0D" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Grid x:Name="HeroContent" Padding="24,22" ColumnSpacing="24" VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="HeroCover" Width="150" Height="225" CornerRadius="8" Background="{StaticResource ST9Inset}"
                                            BorderBrush="{StaticResource ST9Stroke2}" BorderThickness="1">
                                        <Image Source="{x:Bind ViewModel.HeroCoverPath, Mode=OneWay, Converter={StaticResource CoverPathToBitmapLargeConverter}}" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource ST9Mint}" VerticalAlignment="Center"
                                                     Visibility="{x:Bind ViewModel.HeroIsLive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="{x:Bind ViewModel.HeroEyebrow, Mode=OneWay}" Style="{StaticResource ST9_Eyebrow}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HeroTitleText" Text="{x:Bind ViewModel.HeroTitle, Mode=OneWay}" FontSize="32"
                                                   FontFamily="{StaticResource DMSansSemiBold}" Foreground="{StaticResource ST9Text}"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" LineHeight="36"/>
                                        <TextBlock Text="{x:Bind ViewModel.HeroMeta, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="26" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind ViewModel.HeroStreamed, Mode=OneWay}" Style="{StaticResource ST9_RowTitle}" FontSize="18"/>
                                                <TextBlock Text="streamed in total" Style="{StaticResource ST9_Hint}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind ViewModel.HeroSessions, Mode=OneWay}" Style="{StaticResource ST9_RowTitle}" FontSize="18"/>
                                                <TextBlock Text="sessions" Style="{StaticResource ST9_Hint}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind ViewModel.HeroGrade, Mode=OneWay}" Style="{StaticResource ST9_RowTitle}" FontSize="18"
                                                           Foreground="{x:Bind ViewModel.HeroGradeFg, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                                <TextBlock Text="typical grade" Style="{StaticResource ST9_Hint}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                                            <Button Style="{StaticResource ST9_ButtonPrimary}" Click="HeroPlay_Click"
                                                    Visibility="{x:Bind ViewModel.HeroIsNotLive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE768;" FontSize="13"/>
                                                    <TextBlock Text="Play on this PC"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ST9_ButtonSubtle}" Click="HeroLive_Click"
                                                    Visibility="{x:Bind ViewModel.HeroIsLive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE9D9;" FontSize="13"/>
                                                    <TextBlock Text="Live session"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ST9_ButtonGhost}" Content="Details" Click="HeroDetails_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Sync + host tiles, filling the hero's height: the sync card takes what the tiles card leaves -->
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource ST9_Card}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource ST9_IconBubble}" Background="{StaticResource ST9MintSoft}">
                                            <FontIcon Glyph="&#xE895;" FontSize="15" Foreground="{StaticResource ST9Mint2}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.SyncTitle, Mode=OneWay}" Style="{StaticResource ST9_CardTitle}"/>
                                            <TextBlock Text="{x:Bind ViewModel.LastSyncText, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" Style="{StaticResource ST_Toggle}" MinWidth="0" OnContent="" OffContent=""
                                                      AutomationProperties.AutomationId="GameLibrarySyncToggle"
                                                      AutomationProperties.Name="{x:Bind ViewModel.SyncLabel, Mode=OneWay}"
                                                      ToolTipService.ToolTip="{x:Bind ViewModel.SyncLabel, Mode=OneWay}"
                                                      IsOn="{x:Bind ViewModel.SyncEnabled, Mode=TwoWay}"
                                                      IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"/>
                                    </Grid>
                                    <TextBlock Text="{x:Bind ViewModel.CountsText, Mode=OneWay}" Style="{StaticResource ST9_Small}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource ST9_Card}"
                                    Visibility="{x:Bind ViewModel.HostAssetsAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource ST9_IconBubble}" Background="{StaticResource ST9BlueSoft}">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="15" Foreground="{StaticResource ST9Blue}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Host tiles" Style="{StaticResource ST9_CardTitle}"/>
                                            <TextBlock Text="{x:Bind ViewModel.HostTilesHint, Mode=OneWay}" Style="{StaticResource ST9_Hint}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource ST9_TagGreen}"
                                                Visibility="{x:Bind ViewModel.HostAssetsApplied, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Replaced" Style="{StaticResource ST9_TagTextGreen}"/>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource ST9_TagGrey}"
                                                Visibility="{x:Bind ViewModel.HostAssetsApplied, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <TextBlock Text="Original" Style="{StaticResource ST9_TagText}"/>
                                        </Border>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.HostAssetsHelpText, Mode=OneWay}" Style="{StaticResource ST9_Small}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Style="{StaticResource ST9_ButtonSubtle}" Content="{x:Bind ViewModel.HostAssetsButtonText, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" Click="ToggleHostAssets_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ctrl:ResponsiveGrid>

                    <!-- Toolbar -->
                    <StackPanel Spacing="10" Margin="0,8,0,0"
                                Visibility="{x:Bind ViewModel.HasGames, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource ST9_SearchBox}" MinWidth="240" MaxWidth="320" HorizontalAlignment="Left"
                                     PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <ComboBox Grid.Column="1" MinWidth="170" ItemsSource="{x:Bind ViewModel.SortOptions}"
                                      SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" ToolTipService.ToolTip="Sort"/>
                        </Grid>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                            <StackPanel x:Name="StoreChipsPanel" Orientation="Horizontal" Spacing="6"/>
                        </ScrollViewer>
                    </StackPanel>

                    <TextBlock Text="No games yet. Sync now scans the stores installed on this PC; Add game takes any executable."
                               Style="{StaticResource ST9_Body}"
                               Visibility="{x:Bind ViewModel.HasGames, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBlock Text="No games match." Style="{StaticResource ST9_Body}"
                               Visibility="{x:Bind ViewModel.HasNoMatch, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </GridView.Header>
        </GridView>
    </SplitView>
</Page>
