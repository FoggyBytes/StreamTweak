<Page
    x:Class="StreamTweak.Views.GameLibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StreamTweak.ViewModels"
    Background="{StaticResource STBackground}">

    <!-- ═══════════════════════════════════════════════════════════════════════
         10.0 Library (plan phase 4, mockup A «Tabella piena», 22/10): everything on solid
         surfaces, nothing floating on the page. The server's card (state, Add a game, Sync and
         restart, four figures, the start-up sync), then the tabs and a table of the games —
         cover, name, store, the exact command the streaming server runs, Play and Exclude.
         The page is one ListView (virtualised): the card, the tabs and the table's head are
         its Header, the table's rounded foot its Footer, in the shared content column
         (Controls/PageLayout).
    ════════════════════════════════════════════════════════════════════════ -->

    <Page.Resources>
        <DataTemplate x:Key="GameRowTemplate" x:DataType="vm:LibraryRow">
            <Border Background="{StaticResource ST10Surface}" BorderBrush="{StaticResource ST9CardStroke}" BorderThickness="1,0,1,1">
                <Grid Padding="18,10" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="196"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cover -->
                    <Border Width="48" Height="72" CornerRadius="6" Background="{StaticResource ST10Surface2}"
                            BorderBrush="{StaticResource ST9CardStroke}" BorderThickness="1">
                        <Grid>
                            <FontIcon Glyph="&#xE7FC;" FontSize="16" Foreground="{StaticResource ST9Text4}"
                                      Visibility="{x:Bind ShowNameOnCover, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Image Source="{x:Bind CoverPath, Converter={StaticResource CoverPathToBitmapRowConverter}}" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <!-- Name and store -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource ST9_RowTitle}" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind Name}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Width="13" Height="13" VerticalAlignment="Center"
                                   Visibility="{x:Bind ShowBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Image.Source><SvgImageSource UriSource="{x:Bind BadgeUri}"/></Image.Source>
                            </Image>
                            <TextBlock Text="{x:Bind StoreText}" Style="{StaticResource ST9_Hint}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- The command, as written in the streaming server -->
                    <Border Grid.Column="2" Background="{StaticResource ST10Code}" BorderBrush="{StaticResource ST9CardStroke}" BorderThickness="1"
                            CornerRadius="6" Padding="9,6" VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind CommandOrNote}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="{x:Bind Kind}" Style="{StaticResource ST9_Mono}" FontSize="11.5" Foreground="{StaticResource ST9Text4}"
                                       Visibility="{x:Bind HasCommand, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="{x:Bind CommandOrNote}" Style="{StaticResource ST9_Mono}" FontSize="11.5" Foreground="{StaticResource ST9Text2}"
                                       TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"/>
                        </StackPanel>
                    </Border>

                    <!-- Play (a test of the command) and the row's one action -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ST9_ButtonSubtle}" Padding="10,4" MinHeight="28" Click="Play_Click"
                                Visibility="{x:Bind CanPlay, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTipService.ToolTip="Runs this command on this PC, to test it. Not an exact replay of the server: no prep commands, no elevation."
                                AutomationProperties.Name="Play">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="11"/>
                                <TextBlock Text="Play"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ST9_ButtonGhost}" Padding="10,4" MinHeight="28" MinWidth="104"
                                Content="{x:Bind ActionText}" Click="Act_Click"
                                ToolTipService.ToolTip="{x:Bind ActionTip}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One of the card's four figures -->
        <Style x:Key="LibKpiValue" TargetType="TextBlock" BasedOn="{StaticResource ST10_HeroKpiValue}">
            <Setter Property="FontSize" Value="20"/>
        </Style>
    </Page.Resources>

    <ListView x:Name="GameList"
              ItemsSource="{x:Bind ViewModel.Rows}"
              ItemTemplate="{StaticResource GameRowTemplate}"
              ItemContainerStyle="{StaticResource ST9_PlainListItem}"
              SelectionMode="None"
              Padding="32,0,32,40">
        <ListView.Header>
            <StackPanel x:Name="HeaderRoot" Spacing="16" Margin="0,24,0,0">

                <StackPanel Spacing="3">
                    <TextBlock Text="Library" Style="{StaticResource ST9_PageTitle}"/>
                    <TextBlock Text="The games StreamTweak lists in the streaming server, and the exact command each one runs."
                               Style="{StaticResource ST9_PageSubtitle}"/>
                </StackPanel>

                <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                         Severity="{x:Bind ViewModel.StatusIsError, Mode=OneWay, Converter={StaticResource BoolToInfoBarSeverityConverter}}"
                         Message="{x:Bind ViewModel.StatusText, Mode=OneWay}" IsClosable="True" Closed="Status_Closed">
                    <InfoBar.Resources><SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#4ade80"/></InfoBar.Resources>
                </InfoBar>

                <!-- ── The streaming server ────────────────────────────────────────── -->
                <Border Style="{StaticResource ST10_Panel}" Padding="0">
                    <StackPanel>
                        <Grid Padding="20,18" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="12" Background="#24a78bfa" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7F4;" FontSize="20" Foreground="#a78bfa"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="STREAMING SERVER" Style="{StaticResource ST_SectionLabel}"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{x:Bind ViewModel.Server, Mode=OneWay}" Style="{StaticResource ST9_CardTitle}" FontSize="18" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                Visibility="{x:Bind ViewModel.HasServerState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{x:Bind ViewModel.ServerStateHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                        <TextBlock Text="{x:Bind ViewModel.ServerState, Mode=OneWay}" Style="{StaticResource ST9_Hint}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Style="{StaticResource ST9_ButtonSubtle}" Click="AddGame_Click"
                                        IsEnabled="{x:Bind ViewModel.CanChange, Mode=OneWay}"
                                        ToolTipService.ToolTip="Any program, listed in the streaming server by hand">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                        <TextBlock Text="Add a game…"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ST9_ButtonPrimary}" Click="SyncRestart_Click"
                                        IsEnabled="{x:Bind ViewModel.CanChange, Mode=OneWay}"
                                        ToolTipService.ToolTip="Looks for games in the stores installed on this PC, writes the list and restarts the streaming server so it shows it. About a minute. Excluded games stay out.">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE895;" FontSize="13"/>
                                        <TextBlock Text="{x:Bind ViewModel.SyncButtonText, Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- The job, while it runs and once when it ends; then what is waiting and the Steam warning -->
                        <StackPanel Padding="20,0,20,14" Spacing="8"
                                    Visibility="{x:Bind ViewModel.HasJobText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressBar IsIndeterminate="True" Foreground="{StaticResource ST9Mint}"
                                         Visibility="{x:Bind ViewModel.JobRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="{x:Bind ViewModel.JobText, Mode=OneWay}" Style="{StaticResource ST9_Small}" TextWrapping="Wrap"
                                       Foreground="{x:Bind JobBrush(ViewModel.JobFailed), Mode=OneWay}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.PendingText, Mode=OneWay}" Style="{StaticResource ST9_Small}" TextWrapping="Wrap"
                                   Foreground="{StaticResource ST9Amber}" Margin="20,0,20,14"
                                   Visibility="{x:Bind ViewModel.Pending, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Border Margin="20,0,20,14" Padding="12,9" CornerRadius="8" Background="#FF201C13" BorderBrush="#40fbbf24" BorderThickness="1"
                                Visibility="{x:Bind ViewModel.HasSteamConflict, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{StaticResource ST9Amber}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SteamConflict, Mode=OneWay}" Style="{StaticResource ST9_Small}" TextWrapping="Wrap"
                                           Foreground="{StaticResource ST9Amber}"/>
                            </Grid>
                        </Border>

                        <!-- Four figures -->
                        <Grid BorderBrush="{StaticResource ST9CardStroke}" BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Padding="20,12">
                                <TextBlock Text="{x:Bind ViewModel.KpiListed, Mode=OneWay}" Style="{StaticResource LibKpiValue}"/>
                                <TextBlock Text="{x:Bind ViewModel.ListedLabel, Mode=OneWay}" Style="{StaticResource ST10_HeroKpiLabel}"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="{StaticResource ST9CardStroke}" BorderThickness="1,0,0,0" Padding="20,12">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.KpiExcluded, Mode=OneWay}" Style="{StaticResource LibKpiValue}"/>
                                    <TextBlock Text="Excluded" Style="{StaticResource ST10_HeroKpiLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="{StaticResource ST9CardStroke}" BorderThickness="1,0,0,0" Padding="20,12">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.KpiManual, Mode=OneWay}" Style="{StaticResource LibKpiValue}"/>
                                    <TextBlock Text="Added by hand" Style="{StaticResource ST10_HeroKpiLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" BorderBrush="{StaticResource ST9CardStroke}" BorderThickness="1,0,0,0" Padding="20,12">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.KpiSync, Mode=OneWay}" Style="{StaticResource LibKpiValue}"/>
                                    <TextBlock Text="{x:Bind ViewModel.KpiSyncLabel, Mode=OneWay}" Style="{StaticResource ST10_HeroKpiLabel}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- The start-up sync and the host tiles, on the card's darker foot -->
                        <Grid Padding="20,12" ColumnSpacing="16" Background="{StaticResource ST10Surface2}" CornerRadius="0,0,11,11"
                              BorderBrush="{StaticResource ST9CardStroke}" BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Sync when StreamTweak starts" Style="{StaticResource ST9_RowTitle}"/>
                                <TextBlock Text="Writes the list without restarting the server: it shows it at its next start." Style="{StaticResource ST9_Hint}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Style="{StaticResource ST_Toggle}" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                                          AutomationProperties.Name="Sync when StreamTweak starts"
                                          IsOn="{x:Bind ViewModel.SyncEnabled, Mode=TwoWay}"/>
                            <Button Grid.Column="2" Style="{StaticResource ST9_ButtonGhost}" VerticalAlignment="Center"
                                    Content="{x:Bind ViewModel.HostAssetsButtonText, Mode=OneWay}" Click="HostTiles_Click"
                                    IsEnabled="{x:Bind ViewModel.CanChange, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HostAssetsAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTipService.ToolTip="The streaming server's own Desktop and Steam tiles, swapped for StreamTweak's and back. Kept in place if the server's updater puts its own back."/>
                            <Button Grid.Column="3" Style="{StaticResource ST9_ButtonGhost}" VerticalAlignment="Center" Click="ClearLibrary_Click"
                                    IsEnabled="{x:Bind ViewModel.CanChange, Mode=OneWay}"
                                    ToolTipService.ToolTip="Takes every game StreamTweak listed out of the streaming server and empties this list, then restarts the server. Asks first.">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                    <TextBlock Text="Clear library"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Games removed before 10.0: kept out by a key without a name -->
                <Border Style="{StaticResource ST10_Panel}" Padding="16,12"
                        Visibility="{x:Bind ViewModel.HasLegacyExcluded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.LegacyText, Mode=OneWay}" Style="{StaticResource ST9_Small}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource ST9_ButtonGhost}" Content="Let them back" Click="ClearLegacy_Click"
                                IsEnabled="{x:Bind ViewModel.CanChange, Mode=OneWay}"
                                ToolTipService.ToolTip="The next Sync and restart finds them again, if they are still installed"/>
                    </Grid>
                </Border>

                <!-- ── Tabs, filter and the table's head ────────────────────────────── -->
                <StackPanel>
                    <Grid ColumnSpacing="12" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged" Margin="-12,0,0,0">
                            <SelectorBar.Resources>
                                <SolidColorBrush x:Key="SelectorBarItemPillFill" Color="#4ade80"/>
                            </SelectorBar.Resources>
                            <SelectorBarItem x:Name="TabListed"   Tag="listed"   Text="{x:Bind ViewModel.ListedTab, Mode=OneWay}" IsSelected="True"/>
                            <SelectorBarItem x:Name="TabExcluded" Tag="excluded" Text="{x:Bind ViewModel.ExcludedTab, Mode=OneWay}"/>
                            <SelectorBarItem x:Name="TabManual"   Tag="manual"   Text="{x:Bind ViewModel.ManualTab, Mode=OneWay}"/>
                        </SelectorBar>
                        <TextBox Grid.Column="1" Style="{StaticResource ST9_SearchBox}" Width="240" VerticalAlignment="Center"
                                 PlaceholderText="Filter" AutomationProperties.Name="Filter games"
                                 Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Border Background="{StaticResource ST10Surface2}" BorderBrush="{StaticResource ST9CardStroke}" BorderThickness="1"
                            CornerRadius="12,12,0,0">
                        <Grid Padding="18,9" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="196"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="GAME" Style="{StaticResource ST_SectionLabel}"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.CommandHeader, Mode=OneWay}" Style="{StaticResource ST_SectionLabel}"/>
                            <TextBlock Grid.Column="3" Text="ACTIONS" Style="{StaticResource ST_SectionLabel}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource ST10Surface}" BorderBrush="{StaticResource ST9CardStroke}" BorderThickness="1,0,1,0" Padding="18,16"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource ST9_Body}" TextWrapping="Wrap"
                                   Foreground="{StaticResource ST9Text3}"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ListView.Header>
        <ListView.Footer>
            <Border Height="12" Background="{StaticResource ST10Surface}" BorderBrush="{StaticResource ST9CardStroke}" BorderThickness="1,0,1,1"
                    CornerRadius="0,0,12,12"/>
        </ListView.Footer>
    </ListView>
</Page>
