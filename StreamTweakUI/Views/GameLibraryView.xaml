<Page
    x:Class="StreamTweak.Views.GameLibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StreamTweak.ViewModels"
    Background="{StaticResource STBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- page header -->
            <RowDefinition Height="Auto"/>  <!-- status bar -->
            <RowDefinition Height="*"/>     <!-- main card -->
        </Grid.RowDefinitions>

        <!-- Page title (matches Network / Display / Audio pattern) -->
        <StackPanel Grid.Row="0" Margin="28,24,28,4">
            <TextBlock Text="Game Library" Style="{StaticResource ST_PageTitle}"/>
        </StackPanel>

        <!-- Dynamic status InfoBar (keep as InfoBar — closable).
             Visibility is bound explicitly so the control is removed from the layout
             when there is no status — IsOpen alone only collapses the InfoBar's inner
             content, not the control itself, which would otherwise leave an 8px
             phantom gap above the main card. -->
        <InfoBar Grid.Row="1"
                 Margin="28,8,28,0"
                 Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay,
                              Converter={StaticResource BoolToVisibilityConverter}}"
                 IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.StatusIsError, Mode=OneWay,
                            Converter={StaticResource BoolToInfoBarSeverityConverter}}"
                 Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                 IsClosable="True"
                 Closed="StatusInfoBar_Closed">
            <InfoBar.Resources>
                <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#4ade80"/>
            </InfoBar.Resources>
        </InfoBar>

        <!-- ── Main card ─────────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Style="{StaticResource ST_CardNoPad}"
                Margin="28,16,28,28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- sync row (last-sync label + sync toggle) -->
                    <RowDefinition Height="Auto"/>  <!-- separator -->
                    <RowDefinition Height="Auto"/>  <!-- toolbar -->
                    <RowDefinition Height="*"/>     <!-- game list -->
                </Grid.RowDefinitions>

                <!-- Sync row: last-sync info (left) + sync-to-host toggle (right). The
                     section title is no longer rendered here — it now appears as the
                     page title outside the card, like every other view. -->
                <Grid Grid.Row="0" Margin="20,16,20,12">
                    <TextBlock Text="{x:Bind ViewModel.LastSyncText, Mode=OneWay}"
                               Style="{StaticResource ST_RowDescription}"
                               VerticalAlignment="Center"
                               Margin="0,0,120,0"/>

                    <!-- Sync enable toggle -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.SyncLabel, Mode=OneWay}"
                                   Style="{StaticResource ST_RowDescription}"
                                   VerticalAlignment="Center"/>
                        <ToggleSwitch Style="{StaticResource ST_Toggle}"
                                      AutomationProperties.AutomationId="GameLibrarySyncToggle"
                                      AutomationProperties.Name="Sync game library to Sunshine"
                                      IsOn="{x:Bind ViewModel.SyncEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource ST_Separator}"/>

                <!-- Toolbar. The bottom margin is what keeps scrolled rows off the
                     buttons: it sits OUTSIDE the list's scroll viewport, so unlike the
                     ListView's own top padding (which scrolls away with the content) it
                     stays a permanent gap while the library scrolls underneath. -->
                <Grid Grid.Row="2" Margin="20,12,20,14">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">

                        <Button Content="Sync now"
                                Style="{StaticResource ST_ButtonGreen}"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                Click="SyncNow_Click"/>

                        <Button Content="Add game"
                                Style="{StaticResource ST_ButtonSecondary}"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                Click="AddGame_Click"
                                ToolTipService.ToolTip="Add an executable manually"/>

                        <Button Content="Clear sync"
                                Style="{StaticResource ST_ButtonDanger}"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                Click="ClearSync_Click"
                                ToolTipService.ToolTip="Remove all managed entries from Sunshine and reset game list"/>

                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                      Width="20" Height="20"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay,
                                                   Converter={StaticResource BoolToVisibilityConverter}}"/>

                    </StackPanel>

                    <!-- Host tile swap: replaces the default desktop.png/steam.png in
                         <HostInstallDir>\assets with StreamTweak's bundled tiles.
                         Visible only when a streaming-server install is detected. -->
                    <StackPanel Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.HostAssetsAvailable, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ViewModel.HostAssetsHelpText, Mode=OneWay}"
                                   Style="{StaticResource ST_RowDescription}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"/>
                        <Button Content="{x:Bind ViewModel.HostAssetsButtonText, Mode=OneWay}"
                                Style="{StaticResource ST_ButtonSecondary}"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                Click="ToggleHostAssets_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Game list — virtualized ListView so large libraries (hundreds of
                     titles) only realize the rows and covers actually on screen,
                     instead of an ItemsControl that materializes every entry at once. -->
                <ListView Grid.Row="3"
                          ItemsSource="{x:Bind ViewModel.Games}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Padding="20,0,20,16">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ObservableGameEntry">

                                <Border Margin="0,0,0,6"
                                        Background="{StaticResource STInput}"
                                        BorderBrush="{StaticResource STBorder}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="12,10,16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- cover   -->
                                            <ColumnDefinition Width="*"/>    <!-- info    -->
                                            <ColumnDefinition Width="400"/>  <!-- meta    -->
                                            <ColumnDefinition Width="Auto"/> <!-- toggle  -->
                                            <ColumnDefinition Width="Auto"/> <!-- play    -->
                                            <ColumnDefinition Width="Auto"/> <!-- folder  -->
                                            <ColumnDefinition Width="Auto"/> <!-- remove  -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Cover thumbnail (67×100, 2:3) -->
                                        <Border Grid.Column="0"
                                                Width="67" Height="100"
                                                CornerRadius="5"
                                                Margin="0,0,14,0"
                                                Background="{StaticResource STBackground}">
                                            <Grid>
                                                <Image Source="{x:Bind CoverImage, Mode=OneWay}"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind Name}"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           FontSize="8"
                                                           Foreground="{StaticResource STTextMuted}"
                                                           Margin="3"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Visibility="{x:Bind HasNoCover, Mode=OneWay,
                                                                        Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Game info -->
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="4"
                                                    Margin="0,0,12,0">

                                            <!-- Store badge -->
                                            <StackPanel Orientation="Horizontal" Spacing="5"
                                                        Visibility="{x:Bind ShowBadge,
                                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Image Width="14" Height="14" VerticalAlignment="Center">
                                                    <Image.Source>
                                                        <SvgImageSource UriSource="{x:Bind BadgeUri}"/>
                                                    </Image.Source>
                                                </Image>
                                                <TextBlock Text="{x:Bind BadgeLabel}"
                                                           Style="{StaticResource ST_RowDescription}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource STTextPrimary}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Game name -->
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource ST_RowLabel}"
                                                       FontSize="14"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind Name}"/>

                                            <!-- Manual badge -->
                                            <Border CornerRadius="4" Padding="6,2"
                                                    Background="{StaticResource STBadgeGreenBg}"
                                                    BorderBrush="{StaticResource STBadgeGreenBdr}"
                                                    BorderThickness="1"
                                                    Visibility="{x:Bind IsManual,
                                                                 Converter={StaticResource BoolToVisibilityConverter}}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="Manual"
                                                           Style="{StaticResource ST_BadgeText}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource STSuccess}"/>
                                            </Border>

                                        </StackPanel>

                                        <!-- Developer & Release date -->
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Spacing="4"
                                                    Margin="8,0"
                                                    Visibility="{x:Bind HasMeta, Mode=OneWay,
                                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource ST_RowDescription}"
                                                       TextWrapping="NoWrap">
                                                <Run Text="Developers: "
                                                     Foreground="{StaticResource STTextMuted}"/>
                                                <Run Text="{x:Bind MetaDeveloper, Mode=OneWay}"
                                                     Foreground="{StaticResource STTextPrimary}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource ST_RowDescription}"
                                                       TextWrapping="NoWrap">
                                                <Run Text="Release Date: "
                                                     Foreground="{StaticResource STTextMuted}"/>
                                                <Run Text="{x:Bind MetaReleaseDate, Mode=OneWay}"
                                                     Foreground="{StaticResource STTextPrimary}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Enable toggle -->
                                        <ToggleSwitch Grid.Column="3"
                                                      Style="{StaticResource ST_Toggle}"
                                                      AutomationProperties.Name="{x:Bind Name}"
                                                      IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Right"
                                                      ToolTipService.ToolTip="{x:Bind SyncTooltip}"/>

                                        <!-- Play button -->
                                        <Button Grid.Column="4"
                                                Style="{StaticResource ST_ButtonGhost}"
                                                Content="&#xE768;"
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                FontSize="12"
                                                Width="30" Height="30"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Margin="6,0,0,0"
                                                Click="PlayGame_Click"
                                                AutomationProperties.Name="Launch game"
                                                ToolTipService.ToolTip="Launch game"/>

                                        <!-- Open folder button -->
                                        <Button Grid.Column="5"
                                                Style="{StaticResource ST_ButtonGhost}"
                                                Content="&#xED43;"
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                FontSize="12"
                                                Width="30" Height="30"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Margin="4,0,0,0"
                                                Click="OpenFolder_Click"
                                                AutomationProperties.Name="Open install folder"
                                                ToolTipService.ToolTip="{x:Bind InstallFolder}"
                                                Visibility="{x:Bind ShowFolderButton,
                                                             Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- Remove button -->
                                        <Button Grid.Column="6"
                                                Style="{StaticResource ST_ButtonGhost}"
                                                Content="&#xE711;"
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                FontSize="12"
                                                Width="30" Height="30"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Margin="4,0,0,0"
                                                Click="RemoveGame_Click"
                                                AutomationProperties.Name="Remove from list"
                                                ToolTipService.ToolTip="Remove from list"/>

                                    </Grid>
                                </Border>

                            </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </Grid>
        </Border>
    </Grid>

</Page>
