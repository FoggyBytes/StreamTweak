<Page
    x:Class="StreamTweak.Views.GlossaryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StreamTweak.Views"
    Background="{StaticResource STBackground}">

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,14">
            <TextBlock Text="Glossary" Style="{StaticResource ST_PageTitle}"/>
            <TextBlock Text="Technical terms used across StreamTweak and StreamLight."
                       Style="{StaticResource ST_PageSubtitle}"/>
        </StackPanel>

        <!-- Terminal-style content panel -->
        <Border Grid.Row="1"
                Background="#0A0908"
                BorderBrush="{StaticResource STBorder}"
                BorderThickness="1"
                CornerRadius="10">
            <ScrollViewer x:Name="GlossaryScroll" VerticalScrollBarVisibility="Auto"
                          Padding="20,16,24,16">
                <StackPanel x:Name="GlossaryStack" Spacing="0">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Cascadia Code, Cascadia Mono, Consolas, Courier New"/>
                        </Style>
                    </StackPanel.Resources>

                    <!-- ── NETWORK ── -->
                    <TextBlock Text="// NETWORK"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource STSuccess}"
                               Margin="0,4,0,3"/>
                    <Rectangle Height="0.5" Fill="{StaticResource STBorderActive}" Margin="0,0,0,10"/>

                    <local:GlossaryRow Term="NIC"
                                       Definition="Network Interface Card — the physical network adapter in the computer."/>
                    <local:GlossaryRow Term="Link Speed"
                                       Definition="Negotiated transmission speed between two network adapters (e.g. 1 Gbps, 2.5 Gbps)."/>
                    <local:GlossaryRow Term="Link-speed switch"
                                       Definition="StreamTweak's founding feature — temporarily switch the host NIC to a chosen speed while streaming, then restore it. Matching the host speed to the client eliminates bufferbloat and its latency spikes. A brief reconnect happens on switch."/>
                    <local:GlossaryRow Term="Auto-switch"
                                       Definition="Apply the link-speed switch automatically when the streaming-server log reports a client connecting, and restore it when the session ends."/>
                    <local:GlossaryRow Term="NIC Throttle"
                                       Definition="Temporary reduction of the host NIC speed to match the client, eliminating bufferbloat (the classic name for the link-speed switch)."/>
                    <local:GlossaryRow Term="Bufferbloat"
                                       Definition="High latency caused by excessive packet queuing in network buffers between host and client."/>
                    <local:GlossaryRow Term="Net TX"
                                       Definition="Outbound network throughput from the host, expressed in Mbps."/>
                    <local:GlossaryRow Term="Tailscale"
                                       Definition="Mesh VPN. Its 100.x address lets a client reach the host from outside the LAN; StreamTweak surfaces it per host so you can stream remotely."/>

                    <!-- ── STREAMING · CLIENT ── -->
                    <TextBlock Text="// STREAMING · CLIENT"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource STSuccess}"
                               Margin="0,20,0,3"/>
                    <Rectangle Height="0.5" Fill="{StaticResource STBorderActive}" Margin="0,0,0,10"/>

                    <local:GlossaryRow Term="RTT"
                                       Definition="Round Trip Time — time for a packet to travel from client to host and back."/>
                    <local:GlossaryRow Term="Jitter"
                                       Definition="RTT variability. Low but unstable RTT causes perceptible micro-stutter during streaming."/>
                    <local:GlossaryRow Term="Frame Drops"
                                       Definition="Video frames lost in transit during network transmission."/>
                    <local:GlossaryRow Term="Bitrate"
                                       Definition="Amount of video data transmitted per second, expressed in Mbps."/>
                    <local:GlossaryRow Term="Decode Latency"
                                       Definition="Time the client takes to decode each received video frame, in milliseconds."/>

                    <!-- ── HOST METRICS ── -->
                    <TextBlock Text="// HOST METRICS"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource STSuccess}"
                               Margin="0,20,0,3"/>
                    <Rectangle Height="0.5" Fill="{StaticResource STBorderActive}" Margin="0,0,0,10"/>

                    <local:GlossaryRow Term="GPU"
                                       Definition="Graphics Processing Unit — 3D engine utilization of the graphics card (%)."/>
                    <local:GlossaryRow Term="GPU Encoder"
                                       Definition="Hardware video encoding engine on the GPU used to compress the stream (NVENC on NVIDIA)."/>
                    <local:GlossaryRow Term="GPU Temp"
                                       Definition="GPU temperature in degrees Celsius, read cross-vendor (NVIDIA, AMD, Intel) from the same kernel source Windows Task Manager uses."/>
                    <local:GlossaryRow Term="VRAM"
                                       Definition="Dedicated video memory of the GPU, shown as used / total in MB."/>
                    <local:GlossaryRow Term="CPU"
                                       Definition="Main processor utilization averaged across all cores (%)."/>
                    <local:GlossaryRow Term="Host Frame Latency"
                                       Definition="Time the host takes to capture and encode each frame before sending it (capture + encode), in ms — the most direct measure of whether the host kept up. Reported by the client from the per-frame host timestamp."/>

                    <!-- ── DISPLAY &amp; AUDIO ── -->
                    <TextBlock Text="// DISPLAY &amp; AUDIO"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource STSuccess}"
                               Margin="0,20,0,3"/>
                    <Rectangle Height="0.5" Fill="{StaticResource STBorderActive}" Margin="0,0,0,10"/>

                    <local:GlossaryRow Term="HDR"
                                       Definition="High Dynamic Range — display mode that expands luminance range beyond standard SDR limits."/>
                    <local:GlossaryRow Term="Auto HDR"
                                       Definition="Windows feature that adds HDR to supported SDR games automatically. Requires at least one HDR-enabled display."/>
                    <local:GlossaryRow Term="Dolby Atmos"
                                       Definition="Spatial audio format that positions sound as 3D objects around the listener."/>
                    <local:GlossaryRow Term="Windows Sonic"
                                       Definition="Microsoft's spatial audio platform, an alternative to Dolby Atmos for headphones."/>
                    <local:GlossaryRow Term="Spatial Audio"
                                       Definition="Technology simulating three-dimensional surround sound through headphones or speakers. StreamTweak can auto-activate the chosen format when a stream starts."/>
                    <local:GlossaryRow Term="Steam Streaming Speakers"
                                       Definition="Virtual audio device created by Steam during a remote play session."/>

                    <!-- ── NVIDIA ── -->
                    <TextBlock Text="// NVIDIA"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource STSuccess}"
                               Margin="0,20,0,3"/>
                    <Rectangle Height="0.5" Fill="{StaticResource STBorderActive}" Margin="0,0,0,10"/>

                    <local:GlossaryRow Term="NVIDIA Sentinel"
                                       Definition="Protects your NVIDIA global driver profile from being reset by NVIDIA App — captures a snapshot of every setting you changed from the driver default and can re-apply it on demand or automatically."/>
                    <local:GlossaryRow Term="Auto-restore"
                                       Definition="When armed, NVIDIA Sentinel watches the driver settings database and silently re-applies your saved profile whenever NVIDIA App resets it."/>

                    <!-- ── SECURITY ── -->
                    <TextBlock Text="// SECURITY"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource STSuccess}"
                               Margin="0,20,0,3"/>
                    <Rectangle Height="0.5" Fill="{StaticResource STBorderActive}" Margin="0,0,0,10"/>

                    <local:GlossaryRow Term="Bridge"
                                       Definition="Authenticated TCP channel (port 47998) between StreamLight and StreamTweak for the advanced integration — host metrics, link-speed switch, power-off. Streaming itself never uses it."/>
                    <local:GlossaryRow Term="Client approval"
                                       Definition="A StreamLight device must be approved once (a 4-digit PIN shown on both sides is compared out of band) before it can use the bridge integration. Its Moonlight certificate then signs every command."/>

                    <!-- ── STREAMING SERVERS ── -->
                    <TextBlock Text="// STREAMING SERVERS"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource STSuccess}"
                               Margin="0,20,0,3"/>
                    <Rectangle Height="0.5" Fill="{StaticResource STBorderActive}" Margin="0,0,0,10"/>

                    <local:GlossaryRow Term="Sunshine / Apollo / Vibeshine / Vibepollo"
                                       Definition="Open-source game streaming server software installed on the host, all compatible with StreamTweak."/>

                    <!-- ── SESSION QUALITY ── -->
                    <TextBlock Text="// SESSION QUALITY"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource STSuccess}"
                               Margin="0,20,0,3"/>
                    <Rectangle Height="0.5" Fill="{StaticResource STBorderActive}" Margin="0,0,0,10"/>

                    <local:GlossaryRow Term="Quality Grade"
                                       Definition="Composite assessment of session quality based on drop rate, RTT, GPU encoder load, and host frame latency: Excellent, Good, or Poor."/>

                    <!-- ── APP MANAGEMENT ── -->
                    <TextBlock Text="// APP MANAGEMENT"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource STSuccess}"
                               Margin="0,20,0,3"/>
                    <Rectangle Height="0.5" Fill="{StaticResource STBorderActive}" Margin="0,0,0,10"/>

                    <local:GlossaryRow Term="Managed apps"
                                       Definition="Apps StreamTweak closes when a stream starts and relaunches when it ends — e.g. Hue Sync, which conflicts when running on both host and client at once."/>
                    <local:GlossaryRow Term="AutoManage"
                                       Definition="When enabled, an app is automatically terminated at stream start and relaunched when the session ends."
                                       IsLast="True"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>

</Page>
