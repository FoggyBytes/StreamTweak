<Page
    x:Class="StreamTweak.Views.TuningView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StreamTweak.ViewModels"
    xmlns:ctrl="using:StreamTweak.Controls"
    Background="{StaticResource STBackground}">

    <!-- 8.0: each Host-setup subsection is its own sidebar item; this page is a
         parametric single-panel host. The nav parameter (TuneNet / TuneAV /
         TuneNv / TuneApps) picks the visible panel (see ShowSection). The page
         container is transparent — each section provides its own card(s). -->
    <Grid Margin="28,24,28,28">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid>

            <!-- ═══ NETWORK — card-per-group + hover hints ════════════════════ -->
            <StackPanel x:Name="PanelNet" Style="{StaticResource ST8_PanelRoot}">
                <StackPanel Spacing="3">
                    <TextBlock Text="Network" Style="{StaticResource ST8_PanelTitle}"/>
                    <TextBlock Text="Switch the host NIC link speed for streaming." Style="{StaticResource ST_PageSubtitle}"/>
                </StackPanel>

                <!-- ADAPTER -->
                <StackPanel Spacing="8">
                    <TextBlock Text="ADAPTER" Style="{StaticResource ST_SectionLabel}"/>
                    <ProgressRing IsActive="{x:Bind Net.IsLoading, Mode=OneWay}" Width="22" Height="22" HorizontalAlignment="Left"
                                  Visibility="{x:Bind Net.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Border Style="{StaticResource ST8_GroupCard}">
                        <StackPanel>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Network adapter" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                        <ctrl:InfoHint Term="NIC" Tip="The physical NIC StreamTweak controls. Detected via CIM/WMI."/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" MinWidth="240" MaxWidth="300" ItemsSource="{x:Bind Net.Adapters}"
                                              SelectedItem="{x:Bind Net.SelectedAdapter, Mode=TwoWay}"
                                              IsEnabled="{x:Bind Net.HasAdapters, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Current link speed" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                        <ctrl:InfoHint Term="Link Speed" Tip="The adapter's current negotiated link speed, updated live."/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="6" Padding="10,3" VerticalAlignment="Center"
                                            Background="#294ade80" BorderBrush="#4D4ade80" BorderThickness="1">
                                        <TextBlock Text="{x:Bind Net.CurrentSpeedText, Mode=OneWay}" FontFamily="{StaticResource DMSansSemiBold}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource STSuccess}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ST_InfoBox}"
                            Visibility="{x:Bind Net.HasAdapters, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{StaticResource STWarning}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                            <StackPanel Spacing="2">
                                <TextBlock Text="No physical adapters detected" Style="{StaticResource ST_RowLabel}"/>
                                <TextBlock Text="Connect a physical Ethernet or Wi-Fi adapter and restart StreamTweak." Style="{StaticResource ST_RowDescription}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- LINK-SPEED SWITCH -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="LINK-SPEED SWITCH" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                        <ctrl:InfoHint Term="Link-speed switch" Tip="Matching the host link speed to the client kills bufferbloat and its latency spikes. A brief reconnect happens on switch — reconnect within 30 seconds or the previous speed is restored automatically."/>
                    </StackPanel>
                    <Border Style="{StaticResource ST8_GroupCard}">
                        <StackPanel>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Streaming speed" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                        <ctrl:InfoHint Term="Link-speed switch" Tip="The speed the NIC switches to while a stream is running. You choose it — no longer forced to 1 Gbps."/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" MinWidth="240" MaxWidth="300" ItemsSource="{x:Bind Net.Speeds}"
                                              SelectedItem="{x:Bind Net.SelectedSpeed, Mode=TwoWay}" IsEnabled="{x:Bind Net.HasAdapters, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Restore to" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                        <ctrl:InfoHint Term="Link-speed switch" Tip="Speed to switch back to after the stream ends. &quot;Previous&quot; = whatever it was before the switch."/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" MinWidth="240" MaxWidth="300" ItemsSource="{x:Bind Net.RestoreOptions}"
                                              SelectedItem="{x:Bind Net.SelectedRestoreSpeed, Mode=TwoWay}" IsEnabled="{x:Bind Net.HasAdapters, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Manual switch" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                        <ctrl:InfoHint Term="Link-speed switch" Tip="Apply the streaming speed now and restore it when you switch back — handy for testing without a live stream."/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Switch now" Style="{StaticResource ST_ButtonGreen}" Click="SwitchNow_Click"
                                            Visibility="{x:Bind Net.IsStreamingModeActive, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <Button Grid.Column="1" Content="Restore link speed" Style="{StaticResource ST_ButtonDanger}" Click="RestoreNow_Click"
                                            Visibility="{x:Bind Net.IsStreamingModeActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}" BorderThickness="0">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <TextBlock Text="Auto-switch on stream" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                        <ctrl:InfoHint Term="Auto-switch" Tip="Detect stream start/end from the streaming-server log and switch the link speed automatically."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border Style="{StaticResource ST8_FlowChip}">
                                            <TextBlock Text="stream detected" Style="{StaticResource ST8_FlowChipText}"/>
                                        </Border>
                                        <FontIcon Glyph="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource STTextDim}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource ST8_FlowChip}" Background="#1A4ade80" BorderBrush="#4D4ade80">
                                            <TextBlock Style="{StaticResource ST8_FlowChipText}" Foreground="{StaticResource STSuccess}">
                                                <Run Text="switch to "/><Run Text="{x:Bind Net.SelectedSpeed, Mode=OneWay, Converter={StaticResource SpeedKeyToShortLabelConverter}}"/>
                                            </TextBlock>
                                        </Border>
                                        <FontIcon Glyph="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource STTextDim}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource ST8_FlowChip}">
                                            <TextBlock Text="stream ends" Style="{StaticResource ST8_FlowChipText}"/>
                                        </Border>
                                        <FontIcon Glyph="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource STTextDim}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource ST8_FlowChip}">
                                            <TextBlock Style="{StaticResource ST8_FlowChipText}">
                                                <Run Text="restore "/><Run Text="{x:Bind Net.SelectedRestoreSpeed, Mode=OneWay, Converter={StaticResource SpeedKeyToShortLabelConverter}}"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" Style="{StaticResource ST_Toggle}"
                                                  IsOn="{x:Bind Net.AutoStreamingEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TAILSCALE -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="TAILSCALE" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                        <ctrl:InfoHint Term="Tailscale" Tip="Your Tailscale VPN address, for connecting from outside your LAN. Install Tailscale to populate it."/>
                    </StackPanel>
                    <Border Style="{StaticResource ST8_GroupCard}">
                        <Border Style="{StaticResource ST8_Row}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{x:Bind Net.TailscaleIcon, Mode=OneWay}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Visibility="{x:Bind Net.HasTailscaleIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Net.TailscaleIp, Mode=OneWay}" Style="{StaticResource ST_MonoValue}"
                                           Foreground="{StaticResource STSuccess}" VerticalAlignment="Center"
                                           Visibility="{x:Bind Net.TailscaleDetected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Grid.Column="1" Text="Not detected" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"
                                           Visibility="{x:Bind Net.TailscaleDetected, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <Button Grid.Column="2" Style="{StaticResource ST_ButtonGhost}" Width="28" Height="28" Padding="0" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Click="CopyTailscaleIp_Click"
                                        Visibility="{x:Bind Net.TailscaleDetected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTipService.ToolTip="Copy to clipboard" AutomationProperties.Name="Copy Tailscale IP">
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" Glyph="&#xE8C8;"/>
                                </Button>
                                <TextBlock Grid.Column="3" Text="Copied!" Style="{StaticResource ST_RowDescription}" Foreground="{StaticResource STSuccess}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Visibility="{x:Bind Net.TailscaleCopiedVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ═══ DISPLAY & AUDIO — card-per-group + hover hints ═════════════ -->
            <StackPanel x:Name="PanelDispAud" Style="{StaticResource ST8_PanelRoot}" Visibility="Collapsed">
                <StackPanel Spacing="3">
                    <TextBlock Text="Display &amp; audio" Style="{StaticResource ST8_PanelTitle}"/>
                    <TextBlock Text="HDR output per display, and spatial audio for streaming." Style="{StaticResource ST_PageSubtitle}"/>
                </StackPanel>

                <InfoBar Visibility="{x:Bind Disp.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                         IsOpen="{x:Bind Disp.HasError, Mode=OneWay}" Severity="Error"
                         Message="{x:Bind Disp.ErrorText, Mode=OneWay}" IsClosable="False"/>

                <!-- HDR OUTPUT (per-display cards) -->
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <TextBlock Text="HDR OUTPUT" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                            <ctrl:InfoHint Term="HDR" Tip="Toggle HDR per display. Enable it on the display you stream from for HDR games."/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource ST_ButtonGhost}" Width="32" Height="32" Padding="0"
                                Click="RefreshDisplays_Click" ToolTipService.ToolTip="Refresh display list" AutomationProperties.Name="Refresh display list">
                            <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                        </Button>
                    </Grid>
                    <ProgressRing IsActive="{x:Bind Disp.IsLoading, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Left"
                                  Visibility="{x:Bind Disp.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <ItemsControl ItemsSource="{x:Bind Disp.Monitors}"
                                  Visibility="{x:Bind Disp.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MonitorEntry">
                                <Border Style="{StaticResource ST8_GroupCard}" Padding="18,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind FriendlyName}" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                                <Border CornerRadius="4" Padding="6,2" Background="{StaticResource STBadgeGrayBg}"
                                                        BorderBrush="{StaticResource STBadgeGrayBdr}" BorderThickness="1" VerticalAlignment="Center"
                                                        Visibility="{x:Bind IsVirtual, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="Virtual" Style="{StaticResource ST_BadgeText}" FontSize="10" Foreground="{StaticResource STTextMuted}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ResolutionText}" Style="{StaticResource ST_RowDescription}"/>
                                            <TextBlock Text="{x:Bind HdrStateText, Mode=OneWay}" Style="{StaticResource ST_RowDescription}"
                                                       Foreground="{x:Bind HdrStateColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" Style="{StaticResource ST_Toggle}" AutomationProperties.Name="{x:Bind FriendlyName}"
                                                      IsOn="{x:Bind HdrEnabled, Mode=OneWay}" IsEnabled="{x:Bind HdrSupported}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Right" Toggled="HdrToggle_Toggled"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- AUTO HDR -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="AUTO HDR" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                        <ctrl:InfoHint Term="Auto HDR" Tip="Enables Windows Auto HDR for supported SDR games. Requires at least one HDR display active."/>
                    </StackPanel>
                    <Border Style="{StaticResource ST8_GroupCard}">
                        <Border Style="{StaticResource ST8_Row}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Auto HDR" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource ST_Toggle}"
                                              IsOn="{x:Bind Disp.AutoHdrEnabled, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </Border>
                    <InfoBar IsOpen="{x:Bind Disp.ShowAutoHdrWarning, Mode=OneWay}" Severity="Warning"
                             Title="No HDR display active" Message="Auto HDR requires at least one display with HDR enabled." IsClosable="False"/>
                </StackPanel>

                <!-- AUDIO OUTPUT -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="AUDIO OUTPUT" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                        <ctrl:InfoHint Term="Spatial Audio" Tip="The headphone or speaker device that receives the spatial audio signal."/>
                    </StackPanel>
                    <ProgressRing IsActive="{x:Bind Aud.IsLoading, Mode=OneWay}" Width="22" Height="22" HorizontalAlignment="Left"
                                  Visibility="{x:Bind Aud.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Border Style="{StaticResource ST8_GroupCard}"
                            Visibility="{x:Bind Aud.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Border Style="{StaticResource ST8_Row}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Output device" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <ComboBox Grid.Column="1" MinWidth="280" MaxWidth="380" ItemsSource="{x:Bind Aud.Devices}"
                                          SelectedItem="{x:Bind Aud.SelectedDevice, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </Border>
                </StackPanel>

                <!-- SPATIAL AUDIO -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="SPATIAL AUDIO" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                        <ctrl:InfoHint Term="Spatial Audio" Tip="Dolby Atmos or Windows Sonic virtual surround for headphones. When Auto-activate is on, the chosen format is enabled at stream start."/>
                    </StackPanel>
                    <Border Style="{StaticResource ST8_GroupCard}">
                        <StackPanel>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <FontIcon Glyph="&#xE915;" FontSize="10"
                                                  Foreground="{x:Bind Aud.DolbyStatusColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Dolby Atmos for Headphones" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="DolbyToggle" Style="{StaticResource ST_Toggle}"
                                                  IsEnabled="{x:Bind Aud.IsDolbyAvailable, Mode=OneWay}" Toggled="DolbyToggle_Toggled" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <FontIcon Glyph="&#xE915;" FontSize="10"
                                                  Foreground="{x:Bind Aud.SonicStatusColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Windows Sonic for Headphones" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="SonicToggle" Style="{StaticResource ST_Toggle}"
                                                  IsEnabled="{x:Bind Aud.IsSonicAvailable, Mode=OneWay}" Toggled="SonicToggle_Toggled" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Auto-activate on stream" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center"/>
                                        <ctrl:InfoHint Term="Spatial Audio" Tip="Automatically activates the format below when a streaming session starts."/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource ST_Toggle}"
                                                  IsOn="{x:Bind Aud.SpatialAudioEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}" BorderThickness="0">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Format to activate" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <ComboBox Grid.Column="1" MinWidth="260" MaxWidth="320" SelectedIndex="{x:Bind Aud.AutoFormatIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="Dolby Atmos for Headphones"/>
                                            <ComboBoxItem Content="Windows Sonic for Headphones"/>
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                Visibility="{x:Bind Aud.HasLiveStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <FontIcon Glyph="&#xE915;" FontSize="10"
                                                  Foreground="{x:Bind Aud.LiveStatusColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind Aud.LiveStatusText, Mode=OneWay}" Style="{StaticResource ST_RowDescription}"
                                                   Foreground="{x:Bind Aud.LiveStatusColorHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                   TextWrapping="Wrap" MaxWidth="600" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ═══ NVIDIA SENTINEL — card-per-group + hover hints ════════════ -->
            <StackPanel x:Name="PanelNv" Style="{StaticResource ST8_PanelRoot}" Visibility="Collapsed">
                <StackPanel Spacing="3">
                    <TextBlock Text="NVIDIA Sentinel" Style="{StaticResource ST8_PanelTitle}"/>
                    <TextBlock Text="{x:Bind Nv.GpuHeader, Mode=OneWay}" Style="{StaticResource ST_PageSubtitle}"/>
                </StackPanel>

                <!-- USER PROFILE -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="USER PROFILE" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                        <ctrl:InfoHint Term="NVIDIA Sentinel" Tip="Capture a snapshot of your NVIDIA global driver profile. StreamTweak stores every setting you changed from the driver default and can re-apply it whenever NVIDIA App resets the profile."/>
                    </StackPanel>
                    <Border Style="{StaticResource ST8_GroupCard}">
                        <Border Style="{StaticResource ST8_Row}" BorderThickness="0">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Save current as my profile" Style="{StaticResource ST_ButtonGreen}"
                                            IsEnabled="{x:Bind Nv.IsNotBusy, Mode=OneWay}" Click="SaveProfile_Click"/>
                                    <Button Content="Restore my profile" Style="{StaticResource ST_ButtonSecondary}"
                                            IsEnabled="{x:Bind Nv.IsNotBusy, Mode=OneWay}" Click="RestoreProfile_Click"/>
                                    <Button Content="Clear my profile" Style="{StaticResource ST_ButtonDanger}"
                                            IsEnabled="{x:Bind Nv.HasSnapshot, Mode=OneWay}" Click="ClearProfile_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                    <ProgressRing IsActive="{x:Bind Nv.IsBusy, Mode=OneWay}" Width="16" Height="16"
                                                  Visibility="{x:Bind Nv.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{x:Bind Nv.ProfileSavedText, Mode=OneWay}" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind Nv.CapturedCountText, Mode=OneWay}" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"
                                               Visibility="{x:Bind Nv.HasSnapshot, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                                <InfoBar IsOpen="{x:Bind Nv.HasStatusMessage, Mode=OneWay}"
                                         Visibility="{x:Bind Nv.HasStatusMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                         Severity="Informational" Message="{x:Bind Nv.StatusMessage, Mode=OneWay}" IsClosable="False">
                                    <InfoBar.Resources><SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#4ade80"/></InfoBar.Resources>
                                </InfoBar>
                            </StackPanel>
                        </Border>
                    </Border>
                </StackPanel>

                <!-- AUTO-RESTORE -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="AUTO-RESTORE" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                        <ctrl:InfoHint Term="Auto-restore" Tip="When armed, StreamTweak watches the NVIDIA driver settings database and silently re-applies your saved profile whenever NVIDIA App resets it."/>
                    </StackPanel>
                    <Border Style="{StaticResource ST8_GroupCard}">
                        <StackPanel>
                            <Border Style="{StaticResource ST8_Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Auto-restore my profile" Style="{StaticResource ST_RowLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource ST_Toggle}"
                                                  IsOn="{x:Bind Nv.AutoRestoreEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ST8_Row}" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Last auto-restore:" Style="{StaticResource ST_RowDescription}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind Nv.LastRestoreText, Mode=OneWay}" Style="{StaticResource ST_MonoValueSmall}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Open log file" Style="{StaticResource ST_ButtonSecondary}" Click="OpenLog_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="{x:Bind Nv.CapturedExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CAPTURED SETTINGS" Style="{StaticResource ST_SectionLabel}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Nv.ReadableCountText, Mode=OneWay}" Style="{StaticResource ST_RowDescription}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                        </Grid>
                    </Expander.Header>
                    <Border Background="#0A0908" BorderBrush="{StaticResource STBorder}" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0">
                        <StackPanel Padding="20,14,24,16" Spacing="0">
                            <StackPanel.Resources>
                                <!-- 8.0 font unification: was a Cascadia/Consolas terminal look.
                                     Safe to switch — the name/value alignment here comes from the
                                     Grid columns below, not from fixed character width. -->
                                <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DMSans}"/></Style>
                            </StackPanel.Resources>
                            <TextBlock Text="// GLOBAL DRIVER PROFILE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource STSuccess}" Margin="0,0,0,3"/>
                            <Rectangle Height="0.5" Fill="{StaticResource STBorderActive}" Margin="0,0,0,10"/>
                            <TextBlock Text="No human-readable settings captured. Click &#x201C;Save current as my profile&#x201D; to take a snapshot."
                                       FontSize="12" Foreground="{StaticResource STTextMuted}" TextWrapping="Wrap"
                                       Visibility="{x:Bind Nv.HasReadableSettings, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <ItemsControl ItemsSource="{x:Bind Nv.CapturedSettings}"
                                          Visibility="{x:Bind Nv.HasReadableSettings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CapturedSettingVM">
                                        <Grid Margin="0,3,0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{x:Bind DisplayName}" FontSize="12.5" Foreground="{StaticResource STTextPrimary}" TextWrapping="NoWrap"/>
                                                <TextBlock Text="{x:Bind HexId}" FontSize="12" Foreground="{StaticResource STTextMuted}" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ValueLabel}" FontSize="12.5" Foreground="{StaticResource STSuccess}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>

            <!-- ═══ MANAGED APPS — Library-style single container ═════════════ -->
            <StackPanel x:Name="PanelApps" Style="{StaticResource ST8_PanelRoot}" Visibility="Collapsed">
                <StackPanel Spacing="3">
                    <TextBlock Text="Managed apps" Style="{StaticResource ST8_PanelTitle}"/>
                    <TextBlock Text="Closed when a stream starts, relaunched when it ends." Style="{StaticResource ST_PageSubtitle}"/>
                </StackPanel>

                <InfoBar Visibility="{x:Bind AppsVm.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                         IsOpen="{x:Bind AppsVm.HasStatus, Mode=OneWay}"
                         Severity="{x:Bind AppsVm.StatusIsError, Mode=OneWay, Converter={StaticResource BoolToInfoBarSeverityConverter}}"
                         Message="{x:Bind AppsVm.StatusText, Mode=OneWay}" IsClosable="True" Closed="StatusInfoBar_Closed">
                    <InfoBar.Resources><SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#4ade80"/></InfoBar.Resources>
                </InfoBar>

                <!-- One container card holds the toolbar + the app list (Library style) -->
                <Border Style="{StaticResource ST_CardNoPad}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,16,20,12">
                            <Button Content="Add" Style="{StaticResource ST_ButtonSecondary}" Click="AddButton_Click"/>
                            <Button Content="Remove" Style="{StaticResource ST_ButtonSecondary}" IsEnabled="{x:Bind AppsVm.HasSelection, Mode=OneWay}" Click="RemoveButton_Click"/>
                            <Button Content="End now" Style="{StaticResource ST_ButtonSecondary}" IsEnabled="{x:Bind AppsVm.HasSelection, Mode=OneWay}" Click="KillButton_Click"
                                    ToolTipService.ToolTip="Immediately terminate the selected app"/>
                            <Button Content="Restart" Style="{StaticResource ST_ButtonSecondary}" IsEnabled="{x:Bind AppsVm.HasSelection, Mode=OneWay}" Click="RestartButton_Click"
                                    ToolTipService.ToolTip="Kill then relaunch the selected app"/>
                        </StackPanel>

                        <Border Style="{StaticResource ST_Separator}"/>

                        <ListView x:Name="AppListView" ItemsSource="{x:Bind AppsVm.Apps}" SelectedItem="{x:Bind AppsVm.SelectedApp, Mode=TwoWay}"
                                  SelectionMode="Single" MaxHeight="620" Padding="20,12,20,16"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppEntry">
                                    <Border Background="{StaticResource STInput}" BorderBrush="{StaticResource STBorder}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10,16,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{x:Bind Icon, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource ST_RowLabel}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind Path}" Style="{StaticResource ST_RowDescription}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ST_Toggle}" AutomationProperties.Name="{x:Bind Name}"
                                                          IsOn="{x:Bind AutoManage, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                          ToolTipService.ToolTip="Auto-manage on session start/end"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>

          </Grid>
        </ScrollViewer>
    </Grid>

</Page>
