<Page
    x:Class="StreamTweak.Views.NetworkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource STBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="28,24,28,28">

            <!-- Page title -->
            <StackPanel Spacing="3" Margin="0,0,0,4">
                <TextBlock Text="Network" Style="{StaticResource ST_PageTitle}"/>
                <TextBlock Text="NIC speed control and Tailscale integration."
                           Style="{StaticResource ST_PageSubtitle}"/>
            </StackPanel>

            <!-- ── Network Adapter ───────────────────────────────────────────── -->
            <Border Style="{StaticResource ST_Card}">
                <StackPanel Spacing="12">

                    <TextBlock Text="NETWORK ADAPTER" Style="{StaticResource ST_SectionLabel}"/>

                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="24" Height="24"
                                  HorizontalAlignment="Left"
                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay,
                                               Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <ComboBox ItemsSource="{x:Bind ViewModel.Adapters}"
                              SelectedItem="{x:Bind ViewModel.SelectedAdapter, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              IsEnabled="{x:Bind ViewModel.HasAdapters, Mode=OneWay}"/>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Current speed:"
                                   Style="{StaticResource ST_RowDescription}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.CurrentSpeedText, Mode=OneWay}"
                                   Style="{StaticResource ST_MonoValue}"
                                   Foreground="{StaticResource STSuccess}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Warning: no adapters found -->
                    <Border Style="{StaticResource ST_InfoBox}"
                            Visibility="{x:Bind ViewModel.HasAdapters, Mode=OneWay,
                                         Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7BA;" FontSize="13"
                                      Foreground="{StaticResource STWarning}"
                                      VerticalAlignment="Top" Margin="0,1,0,0"/>
                            <StackPanel Spacing="2">
                                <TextBlock Text="No physical adapters detected"
                                           Style="{StaticResource ST_RowLabel}"/>
                                <TextBlock Text="Connect a physical Ethernet or Wi-Fi adapter and restart StreamTweak."
                                           Style="{StaticResource ST_RowDescription}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ── Target Link Speed ─────────────────────────────────────────── -->
            <Border Style="{StaticResource ST_Card}">
                <StackPanel Spacing="12">

                    <TextBlock Text="TARGET LINK SPEED" Style="{StaticResource ST_SectionLabel}"/>

                    <TextBlock Text="StreamTweak throttles to 1 Gbps at stream start. The list below shows all speeds supported by your adapter."
                               Style="{StaticResource ST_RowDescription}"/>

                    <ComboBox ItemsSource="{x:Bind ViewModel.Speeds}"
                              SelectedItem="{x:Bind ViewModel.SelectedSpeed, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              IsEnabled="{x:Bind ViewModel.HasAdapters, Mode=OneWay}"/>

                    <Button Content="Apply Settings"
                            Style="{StaticResource ST_ButtonSecondary}"
                            Click="ApplySettingsButton_Click"
                            HorizontalAlignment="Left"/>

                </StackPanel>
            </Border>

            <!-- ── Auto Streaming Mode ───────────────────────────────────────── -->
            <Border Style="{StaticResource ST_Card}">
                <StackPanel Spacing="14">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3" Margin="0,0,16,0">
                            <TextBlock Text="AUTO STREAMING MODE" Style="{StaticResource ST_SectionLabel}"/>
                            <TextBlock Text="Monitors the streaming server log to detect session start/end."
                                       Style="{StaticResource ST_RowDescription}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      Style="{StaticResource ST_Toggle}"
                                      IsOn="{x:Bind ViewModel.AutoStreamingEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <Border Style="{StaticResource ST_InfoBox}">
                        <TextBlock Text="When a Moonlight stream starts, StreamTweak sets your NIC to 1 Gbps. A brief reconnect will occur. Reconnect within 30 seconds or the original speed is restored automatically."
                                   Style="{StaticResource ST_RowDescription}"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">

                        <Button Content="Start Streaming Mode"
                                Style="{StaticResource ST_ButtonGreen}"
                                Click="ToggleStreamingButton_Click"
                                Visibility="{x:Bind ViewModel.IsStreamingModeActive, Mode=OneWay,
                                             Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <Button Content="Stop Streaming Mode"
                                Style="{StaticResource ST_ButtonDanger}"
                                Click="ToggleStreamingButton_Click"
                                Visibility="{x:Bind ViewModel.IsStreamingModeActive, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}"/>

                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ── Tailscale ─────────────────────────────────────────────────── -->
            <Border Style="{StaticResource ST_Card}">
                <StackPanel Spacing="12">

                    <TextBlock Text="TAILSCALE" Style="{StaticResource ST_SectionLabel}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="{x:Bind ViewModel.TailscaleIcon, Mode=OneWay}"
                               Width="16" Height="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.HasTailscaleIcon, Mode=OneWay,
                                            Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Viewbox Grid.Column="0"
                                 Width="16" Height="16"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Visibility="{x:Bind ViewModel.HasTailscaleIcon, Mode=OneWay,
                                              Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#4F6BED"
                                      Data="M12 2.163c-1.072 0-1.943.872-1.943 1.944 0 1.073.871 1.944 1.943 1.944s1.944-.871 1.944-1.944c0-1.072-.872-1.944-1.944-1.944zm-5.837 0c-1.072 0-1.944.872-1.944 1.944 0 1.073.872 1.944 1.944 1.944s1.944-.871 1.944-1.944c0-1.072-.872-1.944-1.944-1.944zm11.674 0c-1.072 0-1.943.872-1.943 1.944 0 1.073.871 1.944 1.943 1.944s1.944-.871 1.944-1.944c0-1.072-.872-1.944-1.944-1.944zm-5.837 5.837c-1.072 0-1.943.872-1.943 1.944 0 1.073.871 1.944 1.943 1.944s1.944-.871 1.944-1.944c0-1.072-.872-1.944-1.944-1.944zm0 5.837c-1.072 0-1.943.872-1.943 1.944 0 1.073.871 1.944 1.943 1.944s1.944-.871 1.944-1.944c0-1.072-.872-1.944-1.944-1.944zm0 5.837c-1.072 0-1.943.872-1.943 1.944 0 1.073.871 1.944 1.943 1.944s1.944-.872 1.944-1.944c0-1.072-.872-1.944-1.944-1.944z"/>
                            </Canvas>
                        </Viewbox>

                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.TailscaleIp, Mode=OneWay}"
                                   Style="{StaticResource ST_MonoValue}"
                                   Foreground="{StaticResource STSuccess}"
                                   VerticalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.TailscaleDetected, Mode=OneWay,
                                                Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Grid.Column="1"
                                   Text="Not detected"
                                   Style="{StaticResource ST_RowDescription}"
                                   VerticalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.TailscaleDetected, Mode=OneWay,
                                                Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource ST_ButtonGhost}"
                                Width="28" Height="28"
                                Padding="0"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Click="CopyTailscaleIp_Click"
                                Visibility="{x:Bind ViewModel.TailscaleDetected, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTipService.ToolTip="Copy to clipboard">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      FontSize="13" Glyph="&#xE8C8;"/>
                        </Button>

                        <TextBlock Grid.Column="3"
                                   Text="Copied!"
                                   Style="{StaticResource ST_RowDescription}"
                                   Foreground="{StaticResource STSuccess}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Visibility="{x:Bind ViewModel.TailscaleCopiedVisible, Mode=OneWay,
                                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>

                    <TextBlock Text="Install Tailscale to see your VPN address here."
                               Style="{StaticResource ST_RowDescription}"
                               Visibility="{x:Bind ViewModel.TailscaleDetected, Mode=OneWay,
                                            Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</Page>
