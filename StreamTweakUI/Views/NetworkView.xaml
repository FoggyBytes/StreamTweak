<Page
    x:Class="StreamTweak.Views.NetworkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Padding="20,16,20,24">

            <!-- ── Network Adapter card ───────────────────────────────────── -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel Spacing="10">

                    <TextBlock Text="Network Adapter"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>

                    <!-- Loading ring while CIM query runs -->
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="24" Height="24"
                                  HorizontalAlignment="Left"
                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay,
                                               Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <ComboBox ItemsSource="{x:Bind ViewModel.Adapters}"
                              SelectedItem="{x:Bind ViewModel.SelectedAdapter, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              IsEnabled="{x:Bind ViewModel.HasAdapters, Mode=OneWay}"/>

                    <!-- Current link speed display (live refresh) -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Current speed:"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.CurrentSpeedText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Warning if no adapters found -->
                    <InfoBar IsOpen="True"
                             Severity="Warning"
                             Title="No physical adapters detected"
                             Message="Connect a physical Ethernet or Wi-Fi adapter and restart StreamTweak."
                             IsClosable="False"
                             Visibility="{x:Bind ViewModel.HasAdapters, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                </StackPanel>
            </Border>

            <!-- ── Target Link Speed card ─────────────────────────────────── -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel Spacing="10">

                    <TextBlock Text="Target Link Speed"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>

                    <TextBlock Text="StreamTweak throttles to 1 Gbps at stream start. The list below shows all speeds supported by your adapter."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>

                    <ComboBox ItemsSource="{x:Bind ViewModel.Speeds}"
                              SelectedItem="{x:Bind ViewModel.SelectedSpeed, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              IsEnabled="{x:Bind ViewModel.HasAdapters, Mode=OneWay}"/>

                    <Button Content="Apply Settings"
                            Click="ApplySettingsButton_Click"
                            HorizontalAlignment="Left"/>

                </StackPanel>
            </Border>

            <!-- ── Auto Streaming Mode card ───────────────────────────────── -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel Spacing="12">

                    <!-- Toggle row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2"
                                    Margin="0,0,8,0">
                            <TextBlock Text="Auto Streaming Mode"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Monitors the streaming server log to detect session start/end."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.7"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- Column is fixed to track width only; content presenter
                             overflow is invisible (null) and clipped by card CornerRadius -->
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.AutoStreamingEnabled, Mode=TwoWay}"
                                      OffContent="{x:Null}" OnContent="{x:Null}"
                                      MinWidth="0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- Description -->
                    <InfoBar IsOpen="True"
                             Severity="Informational"
                             Title="How it works"
                             Message="When a Moonlight stream starts, StreamTweak sets your NIC to 1 Gbps. A brief reconnect will occur. Reconnect within 30 seconds or the original speed is restored automatically."
                             IsClosable="False"/>

                    <!-- Start / Stop Streaming Mode buttons (mutually exclusive visibility) -->
                    <StackPanel Orientation="Horizontal" Spacing="8">

                        <!-- Green — shown when NOT active -->
                        <Button Click="ToggleStreamingButton_Click"
                                Content="Start Streaming Mode"
                                Visibility="{x:Bind ViewModel.IsStreamingModeActive, Mode=OneWay,
                                             Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground"             Color="#2E7D32"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#388E3C"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#1B5E20"/>
                                <SolidColorBrush x:Key="ButtonForeground"             Color="White"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="White"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed"      Color="White"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="Transparent"/>
                            </Button.Resources>
                        </Button>

                        <!-- Red — shown when ACTIVE -->
                        <Button Click="ToggleStreamingButton_Click"
                                Content="Stop Streaming Mode"
                                Visibility="{x:Bind ViewModel.IsStreamingModeActive, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground"             Color="#B71C1C"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#C62828"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#7F0000"/>
                                <SolidColorBrush x:Key="ButtonForeground"             Color="White"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="White"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed"      Color="White"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="Transparent"/>
                            </Button.Resources>
                        </Button>

                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ── Tailscale card ──────────────────────────────────────────── -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel Spacing="10">

                    <TextBlock Text="Tailscale"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>

                    <!-- Status row: icon + IP + copy button + "Copied!" feedback -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- Tailscale dot icon -->
                            <ColumnDefinition Width="Auto"/>  <!-- IP text -->
                            <ColumnDefinition Width="Auto"/>  <!-- copy button -->
                            <ColumnDefinition Width="Auto"/>  <!-- "Copied!" -->
                            <ColumnDefinition Width="*"/>     <!-- spacer -->
                        </Grid.ColumnDefinitions>

                        <!-- Tailscale icon: real EXE icon when available, dot-grid fallback otherwise -->
                        <Image Grid.Column="0"
                               Source="{x:Bind ViewModel.TailscaleIcon, Mode=OneWay}"
                               Width="16" Height="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.HasTailscaleIcon, Mode=OneWay,
                                            Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Viewbox Grid.Column="0"
                                 Width="16" Height="16"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Visibility="{x:Bind ViewModel.HasTailscaleIcon, Mode=OneWay,
                                              Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#4F6BED"
                                      Data="M12 2.163c-1.072 0-1.943.872-1.943 1.944 0 1.073.871 1.944 1.943 1.944s1.944-.871 1.944-1.944c0-1.072-.872-1.944-1.944-1.944zm-5.837 0c-1.072 0-1.944.872-1.944 1.944 0 1.073.872 1.944 1.944 1.944s1.944-.871 1.944-1.944c0-1.072-.872-1.944-1.944-1.944zm11.674 0c-1.072 0-1.943.872-1.943 1.944 0 1.073.871 1.944 1.943 1.944s1.944-.871 1.944-1.944c0-1.072-.872-1.944-1.944-1.944zm-5.837 5.837c-1.072 0-1.943.872-1.943 1.944 0 1.073.871 1.944 1.943 1.944s1.944-.871 1.944-1.944c0-1.072-.872-1.944-1.944-1.944zm0 5.837c-1.072 0-1.943.872-1.943 1.944 0 1.073.871 1.944 1.943 1.944s1.944-.871 1.944-1.944c0-1.072-.872-1.944-1.944-1.944zm0 5.837c-1.072 0-1.943.872-1.943 1.944 0 1.073.871 1.944 1.943 1.944s1.944-.872 1.944-1.944c0-1.072-.872-1.944-1.944-1.944z"/>
                            </Canvas>
                        </Viewbox>

                        <!-- IP in accent color (when detected) -->
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.TailscaleIp, Mode=OneWay}"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   Visibility="{x:Bind ViewModel.TailscaleDetected, Mode=OneWay,
                                                Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- "Not detected" dim text (when not installed) -->
                        <TextBlock Grid.Column="1"
                                   Text="Not detected"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Opacity="0.45"
                                   Visibility="{x:Bind ViewModel.TailscaleDetected, Mode=OneWay,
                                                Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <!-- Copy button — only when detected -->
                        <Button Grid.Column="2"
                                Width="28" Height="28"
                                Padding="0"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Click="CopyTailscaleIp_Click"
                                Visibility="{x:Bind ViewModel.TailscaleDetected, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTipService.ToolTip="Copy to clipboard">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      FontSize="13" Glyph="&#xE8C8;"/>
                        </Button>

                        <!-- "Copied!" transient feedback -->
                        <TextBlock Grid.Column="3"
                                   Text="Copied!"
                                   FontSize="12"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Visibility="{x:Bind ViewModel.TailscaleCopiedVisible, Mode=OneWay,
                                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>

                    <!-- Sub-text only when not detected -->
                    <TextBlock Text="Install Tailscale to see your VPN address here."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.45" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.TailscaleDetected, Mode=OneWay,
                                            Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</Page>
