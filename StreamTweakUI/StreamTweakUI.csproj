<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Stesso TFM di Core: garantisce accesso alle stesse API WinRT -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>StreamTweak</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WinUI 3 -->
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: distribuzione via InnoSetup, non MSIX -->
    <WindowsPackageType>None</WindowsPackageType>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Resources\streamtweak.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The file name stays StreamTweakUI: the LocalSystem service only accepts pipe clients
         called StreamTweakUI.exe from its own install directory (§22), so renaming the binary
         would silently break every NIC change. What the taskbar, Alt-Tab and Task Manager show
         is FileDescription, which .NET fills from AssemblyName unless told otherwise — hence
         these two, which change the name without touching the file. -->
    <AssemblyName>StreamTweakUI</AssemblyName>
    <AssemblyTitle>StreamTweak</AssemblyTitle>
    <!-- Product, Company and the version come from Directory.Build.props, shared with Core
         and the service. -->
    <!-- Keeps the compiler-generated Main (renamed to XamlGeneratedProgram.XamlGeneratedMain)
         but stops it being the entry point, so Program.cs can opt into the WinAppSDK 2.3
         XAML performance changes before Application.Start. See Program.cs. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\kofi.svg" />
    <None Remove="Resources\nvidia-eye.svg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StreamTweak.Core\StreamTweak.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <!-- No tray package since 9.2.4: Services/TrayIcon.cs on Shell_NotifyIcon replaced
         H.NotifyIcon.WinUI, whose three assemblies are published unsigned (§92.16). -->
    <!-- SystemEvents.SessionEnding (App.xaml.cs, the session saved at Windows shutdown) used
         to arrive unannounced through H.NotifyIcon → System.Drawing.Common. Named now; 8.0.0
         is the version that came that way (file 8.0.23.53103), signed by .NET. -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Custom fonts -->
    <Content Include="Resources\DMSans-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\DMSans-Medium.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\DMSans-SemiBold.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\JetBrainsMono-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\JetBrainsMono-Medium.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\kofi.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\nvidia-eye.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Custom host tile PNGs deployed to <HostInstallDir>\assets\ on demand -->
    <Content Include="Resources\desktop.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\steam.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- ICO files: needed at runtime for tray icon and window icon -->
    <Content Include="Resources\streamtweak.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\streammodeko.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\streammodeok.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Store badge SVGs for Game Library tab -->
    <Content Include="Resources\Badges\store_battlenet.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Badges\store_ea.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Badges\store_epic.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Badges\store_gog.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Badges\store_steam.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Badges\store_ubisoft.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Badges\store_xbox.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
