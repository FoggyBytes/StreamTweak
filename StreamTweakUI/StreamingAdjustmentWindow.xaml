<Window
    x:Class="StreamTweak.StreamingAdjustmentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#1E1E1E">

        <!-- Drag region (needed for SetTitleBar when ExtendsContentIntoTitleBar=true) -->
        <Grid x:Name="TitleBarArea" Height="32" VerticalAlignment="Top"/>

        <!-- Centered content -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14"
                    Margin="32,36,32,28">

            <ProgressRing IsActive="True"
                          Width="32" Height="32"
                          HorizontalAlignment="Center"/>

            <TextBlock Text="Adjusting Network Speed"
                       FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>

            <TextBlock FontSize="12" Opacity="0.65"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="340">
                <Run Text="Setting NIC speed to 1 Gbps for optimal streaming."/>
                <LineBreak/>
                <Run Text="Your stream will briefly disconnect — this is expected."/>
            </TextBlock>

        </StackPanel>
    </Grid>

</Window>
