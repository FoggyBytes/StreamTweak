<Window
    x:Class="StreamTweak.StreamingAdjustmentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="StreamTweak">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource STBackground}">

        <!-- Drag region (needed for SetTitleBar when ExtendsContentIntoTitleBar=true) -->
        <Grid x:Name="TitleBarArea" Height="32" VerticalAlignment="Top"/>

        <!-- Content -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Margin="32,40,32,30">

            <ProgressRing IsActive="True"
                          Width="28" Height="28"
                          HorizontalAlignment="Center"/>

            <TextBlock Text="Adjusting Network Speed"
                       FontFamily="{StaticResource DMSansSemiBold}"
                       FontSize="15"
                       Foreground="{StaticResource STTextPrimary}"
                       HorizontalAlignment="Center"/>

            <TextBlock FontFamily="{StaticResource DMSans}"
                       FontSize="12"
                       Foreground="{StaticResource STTextMuted}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="340"
                       HorizontalAlignment="Center">
                <Run Text="Setting NIC speed to 1 Gbps for optimal streaming."/>
                <LineBreak/>
                <Run Text="Your stream will briefly disconnect — this is expected."/>
            </TextBlock>

        </StackPanel>
    </Grid>

</Window>
