<UserControl
    x:Class="StreamTweak.Controls.SparklineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- title -->
            <RowDefinition Height="*"/>     <!-- chart + axis labels -->
        </Grid.RowDefinitions>

        <!-- Title row: title on the left, optional multi-line legend on the right -->
        <Grid Grid.Row="0" Margin="0,0,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText"
                       Grid.Column="0"
                       FontSize="10" Opacity="0.65"
                       VerticalAlignment="Center"/>
            <StackPanel x:Name="LegendPanel"
                        Grid.Column="1"
                        Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"/>
        </Grid>

        <!-- Chart area: Y-labels column | chart canvas | X-labels row -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>    <!-- chart + y-labels -->
                <RowDefinition Height="15"/>   <!-- x-axis labels -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/> <!-- y-axis labels -->
                <ColumnDefinition Width="*"/>  <!-- chart canvas -->
            </Grid.ColumnDefinitions>

            <!-- Y-axis labels (right-aligned to sit flush against chart edge) -->
            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,3,0">
                <TextBlock x:Name="MaxLabel"
                           FontSize="9" Opacity="0.55"
                           HorizontalAlignment="Right" VerticalAlignment="Top"/>
                <TextBlock x:Name="MidLabel"
                           FontSize="9" Opacity="0.55"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock x:Name="ZeroLabel"
                           Text="0"
                           FontSize="9" Opacity="0.55"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            </Grid>

            <!-- Chart canvas with background and mid grid line -->
            <Border Grid.Row="0" Grid.Column="1"
                    Background="#16FFFFFF" CornerRadius="4">
                <Grid>
                    <!-- Faint mid-value horizontal grid line -->
                    <Rectangle VerticalAlignment="Center"
                               HorizontalAlignment="Stretch"
                               Height="1"
                               Fill="#25FFFFFF"
                               IsHitTestVisible="False"/>
                    <!-- Drawing canvas.
                         ⚠️ Background="Transparent" is load-bearing: a Canvas with no
                         background is not hit-testable, so without it PointerMoved never
                         fires and the hover readout silently does nothing. -->
                    <Canvas x:Name="ChartCanvas"
                            Background="Transparent"
                            SizeChanged="ChartCanvas_SizeChanged"
                            PointerMoved="ChartCanvas_PointerMoved"
                            PointerExited="ChartCanvas_PointerExited"
                            PointerCanceled="ChartCanvas_PointerExited">
                        <!-- Stream start/stop markers, drawn behind the data -->
                        <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False"/>
                        <!-- Min/max band (envelope mode): drawn behind the average line
                             so downsampled spikes stay visible instead of being averaged away. -->
                        <Polygon x:Name="EnvelopeBand"
                                 StrokeThickness="0"
                                 IsHitTestVisible="False"/>
                        <Polyline x:Name="DataLine"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"/>
                        <!-- Stream labels (S1, S2, …): above the data so they stay readable,
                             below the hover readout (ZIndex 10+) so they never cover it. -->
                        <Canvas x:Name="StreamLabelCanvas"
                                Canvas.ZIndex="5"
                                IsHitTestVisible="False"/>
                        <!-- Hover readout: vertical guide, dot, and value popup.
                             ⚠️ Canvas.ZIndex is load-bearing: multi-line mode adds its
                             polylines to this canvas at runtime, AFTER these elements, so
                             without it the lines are drawn over the readout. -->
                        <Line x:Name="HoverGuide"
                              Canvas.ZIndex="10"
                              Stroke="#66FFFFFF" StrokeThickness="1"
                              Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Ellipse x:Name="HoverDot"
                                 Canvas.ZIndex="11"
                                 Width="7" Height="7"
                                 Stroke="#FFFFFFFF" StrokeThickness="1.5"
                                 Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="HoverPopup"
                                Canvas.ZIndex="12"
                                Background="#F0161616"
                                BorderBrush="#40FFFFFF" BorderThickness="1"
                                CornerRadius="4" Padding="6,3"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <StackPanel>
                                <TextBlock x:Name="HoverTime" FontSize="10" Opacity="0.7"/>
                                <TextBlock x:Name="HoverValue" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>
            </Border>

            <!-- X-axis labels. Populated by DrawXAxis(): clock times when a TimeAxis is
                 supplied, otherwise the legacy "0 → duration" pair. -->
            <Canvas x:Name="XAxisCanvas" Grid.Row="1" Grid.Column="1" Margin="0,2,0,0"/>
        </Grid>
    </Grid>

</UserControl>
