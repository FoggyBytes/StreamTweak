<UserControl
    x:Class="StreamTweak.Controls.SparklineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- title -->
            <RowDefinition Height="*"/>     <!-- chart + axis labels -->
        </Grid.RowDefinitions>

        <!-- Title row: title on the left, optional multi-line legend on the right -->
        <Grid Grid.Row="0" Margin="0,0,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText"
                       Grid.Column="0"
                       FontSize="10" Opacity="0.65"
                       VerticalAlignment="Center"/>
            <StackPanel x:Name="LegendPanel"
                        Grid.Column="1"
                        Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"/>
        </Grid>

        <!-- Chart area: Y-labels column | chart canvas | X-labels row -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>    <!-- chart + y-labels -->
                <RowDefinition Height="15"/>   <!-- x-axis labels -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/> <!-- y-axis labels -->
                <ColumnDefinition Width="*"/>  <!-- chart canvas -->
            </Grid.ColumnDefinitions>

            <!-- Y-axis labels (right-aligned to sit flush against chart edge) -->
            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,3,0">
                <TextBlock x:Name="MaxLabel"
                           FontSize="9" Opacity="0.55"
                           HorizontalAlignment="Right" VerticalAlignment="Top"/>
                <TextBlock x:Name="MidLabel"
                           FontSize="9" Opacity="0.55"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock x:Name="ZeroLabel"
                           Text="0"
                           FontSize="9" Opacity="0.55"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            </Grid>

            <!-- Chart canvas with background and mid grid line -->
            <Border Grid.Row="0" Grid.Column="1"
                    Background="#16FFFFFF" CornerRadius="4">
                <Grid>
                    <!-- Faint mid-value horizontal grid line -->
                    <Rectangle VerticalAlignment="Center"
                               HorizontalAlignment="Stretch"
                               Height="1"
                               Fill="#25FFFFFF"
                               IsHitTestVisible="False"/>
                    <!-- Drawing canvas -->
                    <Canvas x:Name="ChartCanvas"
                            SizeChanged="ChartCanvas_SizeChanged">
                        <!-- Min/max band (envelope mode): drawn behind the average line
                             so downsampled spikes stay visible instead of being averaged away. -->
                        <Polygon x:Name="EnvelopeBand"
                                 StrokeThickness="0"
                                 IsHitTestVisible="False"/>
                        <Polyline x:Name="DataLine"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"/>
                    </Canvas>
                </Grid>
            </Border>

            <!-- X-axis labels: "0" left, duration right -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,2,0,0">
                <TextBlock Text="0"
                           FontSize="9" Opacity="0.55"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="XEndLabel"
                           FontSize="9" Opacity="0.55"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
