<Window x:Class="StreamTweak.StreamingAdjustmentAlert"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamTweak" Height="300" Width="500"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        WindowStyle="None"
        Topmost="True"
        Background="#FF202020"
        Foreground="#FFFFFFFF"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Resources/streamtweak.ico">

    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Resources/streamtweak.ico" Width="48" Height="48" 
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <TextBlock FontWeight="Bold" FontSize="18" TextAlignment="Center" Margin="0,0,0,14">
                <InlineUIContainer BaselineAlignment="Center">
                    <Image Source="/Resources/Twemoji/gear_3d.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                </InlineUIContainer>
                <Run Text=" Adjusting Network Speed"/>
            </TextBlock>

            <TextBlock Text="Setting network speed to 1Gbps for optimal streaming." 
                       FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="20"/>

            <TextBlock Text="Your stream will briefly disconnect. Reconnect within 30 seconds or speed will revert to original." 
                       FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Foreground="#FFABABAB" Margin="0,0,0,0" LineHeight="18"/>
        </StackPanel>
    </Grid>
</Window>
