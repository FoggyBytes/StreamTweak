<Window x:Class="StreamTweak.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StreamTweak"
        Title="StreamTweak" Height="692" Width="920"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#FF202020"
        Foreground="{DynamicResource TextForeground}"
        FontSize="13"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="36"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ═══════════════ Converters ═══════════════ -->
        <local:QualityGradeColorConverter       x:Key="GradeColorConverter"/>
        <local:QualityGradeLabelConverter       x:Key="GradeLabelConverter"/>
        <local:QualityGradeShortLabelConverter  x:Key="GradeShortLabelConverter"/>
        <BooleanToVisibilityConverter           x:Key="BoolToVis"/>
        <local:CoverPathToImageConverter        x:Key="CoverPathConverter"/>
        <local:StoreBadgeGeometryConverter      x:Key="StoreBadgeGeomConverter"/>
        <local:StoreBadgeNameConverter          x:Key="StoreBadgeNameConverter"/>
        <local:StoreBadgeVisibilityConverter    x:Key="StoreBadgeVisConverter"/>

        <!-- ═══════════════ Color Palette ═══════════════ -->
        <SolidColorBrush x:Key="WindowBackground"         Color="#19FFFFFF"/>
        <SolidColorBrush x:Key="SidebarBackground"        Color="#FF202020"/>
        <SolidColorBrush x:Key="PanelBackground"          Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="TextForeground"           Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="BorderColor"              Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="AccentColor"              Color="#FFBE5438"/>
        <SolidColorBrush x:Key="AccentHoverColor"         Color="#FFA0361A"/>
        <SolidColorBrush x:Key="SecondaryTextForeground"  Color="#FFBABABA"/>
        <SolidColorBrush x:Key="WarningForeground"        Color="#FFFFC107"/>

        <!-- ═══════════════ Toggle Switch ═══════════════ -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Grid.Column="0" Width="44" Height="24"
                                    CornerRadius="12" Background="{DynamicResource BorderColor}">
                                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="23,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ ComboBox ═══════════════ -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#FF252525"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                            <Grid Margin="8,0">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"/>
                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                      Data="M 0 0 L 4 4 L 8 0" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2" StrokeEndLineCap="Round"/>
                            </Grid>
                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                          FocusVisualStyle="{x:Null}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=MainBorder}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=MainBorder}"
                                        Background="#FF252525"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,4,0,0">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ Button Styles ═══════════════ -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.03" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.03" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.96" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.96" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.03" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.03" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButtonAnimOnly" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.03" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.03" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.96" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.96" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.03" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.03" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButtonAnimOnly}">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- ═══════════════ Sidebar Nav Item ═══════════════ -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3C2924"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButtonActive" TargetType="Button" BasedOn="{StaticResource TabButton}">
            <Setter Property="Background" Value="#FFBE5438"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ═══════════════ Caption Button (Minimize) ═══════════════ -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ ScrollBar ═══════════════ -->
        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="#606060" Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFBE5438"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFA0361A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarLineButtonUp" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="2">
                            <Path x:Name="Arrow"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="#808080"
                                  Data="M 1,5 L 5,1 L 9,5 Z"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="#FFBE5438"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="#FFA0361A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarLineButtonDown" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="2">
                            <Path x:Name="Arrow"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="#808080"
                                  Data="M 1,1 L 5,5 L 9,1 Z"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="#FFBE5438"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="#FFA0361A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Up button -->
                            <RepeatButton Grid.Row="0"
                                          Style="{StaticResource ScrollBarLineButtonUp}"
                                          Command="ScrollBar.LineUpCommand"/>
                            <!-- Track background -->
                            <Border Grid.Row="1" CornerRadius="4" Background="#22FFFFFF" Margin="2,2"/>
                            <Track Grid.Row="1" x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}" MinHeight="24"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <!-- Down button -->
                            <RepeatButton Grid.Row="2"
                                          Style="{StaticResource ScrollBarLineButtonDown}"
                                          Command="ScrollBar.LineDownCommand"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="10"/>
                                <Setter Property="MinHeight" Value="10"/>
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="MinWidth" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ Close Button ═══════════════ -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ RadioButton (spatial format selector) ═══════════════ -->
        <Style x:Key="SpatialFormatRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse x:Name="RadioOuter"
                                         Stroke="{DynamicResource BorderColor}" StrokeThickness="2"
                                         Fill="Transparent"/>
                                <Ellipse x:Name="RadioInner"
                                         Width="8" Height="8"
                                         Fill="{DynamicResource AccentColor}" Opacity="0"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioOuter" Property="Stroke" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="RadioInner" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ Title bar ═══════════════ -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <Image Source="pack://application:,,,/Resources/streamtweak.ico"
                       Width="18" Height="18" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock Text="StreamTweak" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextForeground}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="46" VerticalAlignment="Stretch"
                        Style="{StaticResource CaptionButton}" Click="MinimizeButton_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="─" FontSize="10"/>
                </Button>
                <Button Width="46" VerticalAlignment="Stretch"
                        Style="{StaticResource CloseButton}" Click="CloseButton_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="✕" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════════ Main area: sidebar + content ═══════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── Sidebar ─── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackground}"
                    BorderThickness="0">
                <Grid Margin="8,12,8,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Top">
                        <Button x:Name="HomeTabButton"
                                Style="{StaticResource TabButtonActive}"
                                HorizontalAlignment="Stretch"
                                Click="HomeTabButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Resources/streamtweak.png"
                                       Width="18" Height="18"
                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Home" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NetworkTabButton"
                                Style="{StaticResource TabButton}"
                                HorizontalAlignment="Stretch"
                                Click="NetworkTabButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Resources/Twemoji/globe_3d.png"
                                       Width="18" Height="18"
                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Network" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="DisplayTabButton"
                                Style="{StaticResource TabButton}"
                                HorizontalAlignment="Stretch"
                                Click="DisplayTabButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Resources/Twemoji/desktop_3d.png"
                                       Width="18" Height="18"
                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Display" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="AudioTabButton"
                                Style="{StaticResource TabButton}"
                                HorizontalAlignment="Stretch"
                                Click="AudioTabButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Resources/Twemoji/headphones_3d.png"
                                       Width="18" Height="18"
                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Audio" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="AppTabButton"
                                Style="{StaticResource TabButton}"
                                HorizontalAlignment="Stretch"
                                Click="AppTabButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Resources/Twemoji/card_index_dividers_3d.png"
                                       Width="18" Height="18"
                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="App" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="GameLibTabButton"
                                Style="{StaticResource TabButton}"
                                HorizontalAlignment="Stretch"
                                Click="GameLibTabButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Resources/Twemoji/video_game_3d.png"
                                       Width="18" Height="18"
                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Games" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="LogsTabButton"
                                Style="{StaticResource TabButton}"
                                HorizontalAlignment="Stretch"
                                Click="LogsTabButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Resources/Twemoji/clipboard_3d.png"
                                       Width="18" Height="18"
                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Logs" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="GlossaryTabButton"
                                Style="{StaticResource TabButton}"
                                HorizontalAlignment="Stretch"
                                Click="GlossaryTabButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Resources/Twemoji/open_book_3d.png"
                                       Width="18" Height="18"
                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Glossary" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ─── Content panels ─── -->
            <Grid Grid.Column="1" Margin="12,12,16,16">

                <!-- ═══════════════ HOME PANEL ═══════════════ -->
                <Border x:Name="HomePanel"
                        Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="10" Padding="28,16,28,16"
                        TextElement.Foreground="{DynamicResource TextForeground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 0: header -->
                            <RowDefinition Height="18"/>     <!-- 1: gap -->
                            <RowDefinition Height="8"/>      <!-- 2: gap -->
                            <RowDefinition Height="Auto"/>   <!-- 3: separatore -->
                            <RowDefinition Height="10"/>     <!-- 4: gap -->
                            <RowDefinition Height="Auto"/>   <!-- 5: Streaming Session -->
                            <RowDefinition Height="Auto"/>   <!-- 6: Last session -->
                            <RowDefinition Height="*"/>      <!-- 7: spazio flessibile -->
                            <RowDefinition Height="Auto"/>   <!-- 8: card grid -->
                            <RowDefinition Height="Auto"/>   <!-- 9: Stream Host -->
                            <RowDefinition Height="Auto"/>   <!-- 10: GPL/GitHub/Donate -->
                        </Grid.RowDefinitions>

                        <!-- Riga 0: logo centrato + titolo + info -->
                        <StackPanel Grid.Row="0" Orientation="Vertical"
                                    HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Image Source="pack://application:,,,/Resources/streamtweak.ico"
                                   Width="52" Height="52" HorizontalAlignment="Center"
                                   Margin="0,0,0,6" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="StreamTweak" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextForeground}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                <TextBlock x:Name="AboutVersionText" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextForeground}"/>
                                <TextBlock Text="  ·  Developed by FoggyBytes  ·  " FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextForeground}"/>
                                <TextBlock x:Name="AboutBuildDateText" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextForeground}"/>
                            </StackPanel>
                            <TextBlock x:Name="UpdateStatusText" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,3,0,0"
                                       Foreground="{DynamicResource SecondaryTextForeground}"
                                       MouseLeftButtonUp="UpdateStatusText_Click"/>
                        </StackPanel>

                        <!-- Riga 1: (vuota) -->

                        <!-- Riga 2: (vuota) -->

                        <!-- Riga 3: separatore -->
                        <Separator Grid.Row="3" Background="{DynamicResource BorderColor}" Margin="0,0,0,8"/>

                        <!-- Riga 4: (vuota) -->

                        <!-- Riga 5: Streaming Session card -->
                        <Border Grid.Row="5"
                                Background="#1AFFFFFF" CornerRadius="8" Padding="12,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Image Source="/Resources/Twemoji/play_button_3d.png"
                                           Width="18" Height="18" Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="Streaming Session" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextForeground}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse x:Name="HomeSessionDot"
                                             Width="10" Height="10" Fill="#808080"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="HomeSessionText"
                                               Text="Inactive" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Riga 6: Last session card -->
                        <Border x:Name="HomeLastSessionCard" Grid.Row="6"
                                Background="#1AFFFFFF" CornerRadius="8"
                                Padding="14,10" Margin="0,8,0,0"
                                VerticalAlignment="Top" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Last session"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextForeground}"
                                           Margin="0,0,0,8"/>
                                <Grid Grid.Row="1" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="HomeLastSessionDate" FontSize="15"
                                                   Foreground="{DynamicResource TextForeground}"
                                                   Margin="0,0,18,0"/>
                                        <TextBlock x:Name="HomeLastSessionDuration" FontSize="15"
                                                   Foreground="{DynamicResource SecondaryTextForeground}"/>
                                    </StackPanel>
                                    <Border x:Name="HomeLastSessionGradeBorder" Grid.Column="1"
                                            CornerRadius="10" Padding="12,4,12,4"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock x:Name="HomeLastSessionGradeText"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Border>
                                </Grid>
                                <StackPanel x:Name="HomeLastSessionTelemetryRow" Grid.Row="2"
                                            Orientation="Horizontal" Visibility="Collapsed">
                                    <TextBlock x:Name="HomeLastSessionRtt" FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextForeground}"
                                               Margin="0,0,18,0"/>
                                    <TextBlock x:Name="HomeLastSessionDrops" FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextForeground}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="HomeNoSessionText" Grid.Row="6"
                                   Text="No sessions recorded yet."
                                   FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource SecondaryTextForeground}"
                                   Visibility="Collapsed"/>

                        <!-- Riga 7: (vuota) -->

                        <!-- Riga 8: card grid 3×2 -->
                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- NIC Speed -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    Background="#1AFFFFFF" CornerRadius="8" Padding="12,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Image Source="/Resources/Twemoji/high_voltage_3d.png"
                                               Width="18" Height="18" Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="NIC Speed" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryTextForeground}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border x:Name="HomeNicSpeedPill" CornerRadius="6" Padding="8,3"
                                            Background="#33FFFFFF" HorizontalAlignment="Right">
                                        <TextBlock x:Name="HomeNicSpeedText" Text="—"
                                                   FontSize="14" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Auto Streaming -->
                            <Border Grid.Row="0" Grid.Column="2"
                                    Background="#1AFFFFFF" CornerRadius="8" Padding="12,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Image Source="/Resources/Twemoji/globe_3d.png"
                                               Width="18" Height="18" Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Auto Streaming" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryTextForeground}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border x:Name="HomeAutoStreamPill" CornerRadius="6" Padding="8,3"
                                            Background="#33FFFFFF" HorizontalAlignment="Right">
                                        <TextBlock x:Name="HomeAutoStreamText" Text="Off"
                                                   FontSize="14" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- HDR -->
                            <Border Grid.Row="0" Grid.Column="4"
                                    Background="#1AFFFFFF" CornerRadius="8" Padding="12,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Image Source="/Resources/Twemoji/rainbow_3d.png"
                                               Width="18" Height="18" Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="HDR" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryTextForeground}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border x:Name="HomeHdrPill" CornerRadius="6" Padding="8,3"
                                            Background="#33FFFFFF" HorizontalAlignment="Right">
                                        <TextBlock x:Name="HomeHdrText" Text="Off"
                                                   FontSize="14" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Spatial Audio -->
                            <Border Grid.Row="2" Grid.Column="0"
                                    Background="#1AFFFFFF" CornerRadius="8" Padding="12,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Image Source="/Resources/Twemoji/headphones_3d.png"
                                               Width="18" Height="18" Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Spatial Audio" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryTextForeground}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border x:Name="HomeSpatialPill" CornerRadius="6" Padding="8,3"
                                            Background="#33FFFFFF" HorizontalAlignment="Right">
                                        <TextBlock x:Name="HomeSpatialText" Text="Off"
                                                   FontSize="14" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Game Library -->
                            <Border Grid.Row="2" Grid.Column="2"
                                    Background="#1AFFFFFF" CornerRadius="8" Padding="12,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Image Source="/Resources/Twemoji/video_game_3d.png"
                                               Width="18" Height="18" Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Game Library" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryTextForeground}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border x:Name="HomeGameLibPill" CornerRadius="6" Padding="8,3"
                                            Background="#33FFFFFF" HorizontalAlignment="Right">
                                        <TextBlock x:Name="HomeGameLibText" Text="Off"
                                                   FontSize="14" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Auto HDR -->
                            <Border Grid.Row="2" Grid.Column="4"
                                    Background="#1AFFFFFF" CornerRadius="8" Padding="12,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Image Source="/Resources/Twemoji/desktop_3d.png"
                                               Width="18" Height="18" Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Auto HDR" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryTextForeground}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border x:Name="HomeAutoHdrPill" CornerRadius="6" Padding="8,3"
                                            Background="#33FFFFFF" HorizontalAlignment="Right">
                                        <TextBlock x:Name="HomeAutoHdrText" Text="Off"
                                                   FontSize="14" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Riga 9: stream host -->
                        <StackPanel Grid.Row="9" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,10,0,0">
                            <TextBlock Text="Stream Host"
                                       FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextForeground}"
                                       Margin="0,0,8,0"/>
                            <Image x:Name="HomeHostAppIcon"
                                   Width="16" Height="16" VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="HomeAppNameText"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextForeground}"/>
                        </StackPanel>

                        <!-- Riga 10: badge GPL + GitHub + Donate -->
                        <StackPanel Grid.Row="10" Orientation="Vertical" Margin="0,10,0,0">
                            <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Cursor="Hand"
                                            MouseLeftButtonUp="GplBadge_Click"
                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Border Background="#555555" CornerRadius="3,0,0,3" Padding="6,4">
                                        <TextBlock Text="License" FontSize="11" Foreground="White" FontFamily="Segoe UI"/>
                                    </Border>
                                    <Border Background="#4caf50" CornerRadius="0,3,3,0" Padding="6,4">
                                        <TextBlock Text="GPL v3" FontSize="11" Foreground="White"
                                                   FontFamily="Segoe UI" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <Button Width="128" Height="28" Margin="0,0,6,0" Click="GitHubButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModernButtonAnimOnly}">
                                            <Setter Property="Background" Value="#24292e"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="/Resources/Twemoji/link_3d.png"
                                               Width="18" Height="18" Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="View on GitHub" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Width="128" Height="28" Click="DonateButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModernButtonAnimOnly}">
                                            <Setter Property="Background" Value="#0070BA"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="/Resources/Twemoji/credit_card_3d.png"
                                               Width="18" Height="18" Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Donate via PayPal" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- ═══════════════ NETWORK PANEL ═══════════════ -->
                <Border x:Name="NetworkPanel" Visibility="Collapsed"
                        Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14,12,14,14" TextElement.Foreground="{DynamicResource TextForeground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Network Speed Management"
                                       FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextForeground}"/>
                            <Separator Background="{DynamicResource BorderColor}" Margin="0,0,0,8"/>
                        </StackPanel>

                        <TextBlock Text="Select Physical Network Adapter:" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,0,0,5" Grid.Row="2"/>
                        <ComboBox x:Name="AdapterComboBox" Margin="0,0,0,10" Grid.Row="3"
                                  SelectionChanged="AdapterComboBox_SelectionChanged"/>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="Current Speed:" FontWeight="Medium" Margin="0,0,10,0"/>
                            <TextBlock x:Name="CurrentSpeedTextBlock" Text="Detecting..." FontWeight="Bold"
                                       Foreground="{DynamicResource AccentColor}"/>
                        </StackPanel>

                        <TextBlock Text="Target Link Speed:" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,0,0,5" Grid.Row="5"/>
                        <ComboBox x:Name="SpeedComboBox" Margin="0,0,0,10" Grid.Row="6"/>

                        <Separator Grid.Row="8" Margin="0,0,0,10" Background="{DynamicResource BorderColor}"/>

                        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Auto Streaming Mode" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox x:Name="AutoStreamingToggle" Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center" Checked="AutoStreamingToggle_Changed"
                                      Unchecked="AutoStreamingToggle_Changed"/>
                        </StackPanel>

                        <StackPanel Grid.Row="11" Orientation="Vertical" Margin="0,12,0,0">
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextForeground}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,3" LineHeight="16">
                                <Run Text="Auto-sets network speed to 1Gbps when Moonlight streams."/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextForeground}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,3" LineHeight="16">
                                <InlineUIContainer BaselineAlignment="Center">
                                    <Image Source="/Resources/Twemoji/warning_3d.png" Width="12" Height="12" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </InlineUIContainer>
                                <Run Text=" A brief disconnect will occur during speed adjustment."/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextForeground}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,0" LineHeight="16">
                                <Run Text="Reconnect within 30 seconds or the original speed will be restored."/>
                            </TextBlock>
                        </StackPanel>

                        <Grid Grid.Row="13" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="StreamingModeButton" Content="Start Streaming Mode"
                                    Height="42" Click="StreamingModeButton_Click"
                                    Style="{StaticResource ModernButtonAnimOnly}" HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="2" Content="Apply Settings" Height="42"
                                    Click="ApplyButton_Click" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch"/>
                        </Grid>

                        <TextBlock Grid.Row="14" FontSize="12" Foreground="{DynamicResource SecondaryTextForeground}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,20,0,0">
                            <Run Text="Streaming Mode auto-sets the Target Link Speed to 1Gbps. Stop to revert to original Speed."/>
                        </TextBlock>

                        <Separator Grid.Row="15" Margin="0,12,0,10" Background="{DynamicResource BorderColor}"/>

                        <!-- Tailscale detection -->
                        <StackPanel Grid.Row="16" Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White"
                                          Data="M24 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm-9 9a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm0-9a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm6-6a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm0-.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM3 24a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm0-.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zm18 .5a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm0-.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM6 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm9-9a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm-3 2.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM6 3a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM3 5.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Tailscale" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TailscaleIpTextBlock" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextForeground}"/>
                            <Button x:Name="TailscaleCopyButton" Click="TailscaleCopyButton_Click"
                                    Width="18" Height="18" Padding="0" Margin="6,0,0,0"
                                    Background="Transparent" BorderThickness="0"
                                    VerticalAlignment="Center" Cursor="Hand"
                                    Visibility="Collapsed" ToolTip="Copy IP"
                                    Style="{StaticResource ModernButtonAnimOnly}">
                                <Path Fill="{DynamicResource SecondaryTextForeground}" Stretch="Uniform"
                                      Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
                            </Button>
                            <TextBlock x:Name="TailscaleCopiedText" Text="Copied"
                                       FontSize="11" Opacity="0"
                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                       Foreground="{DynamicResource SecondaryTextForeground}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════ DISPLAY PANEL ═══════════════ -->
                <Border x:Name="DisplayPanel" Visibility="Collapsed"
                        Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="14,12,14,12"
                        TextElement.Foreground="{DynamicResource TextForeground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Per-Display HDR Output"
                                   FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextForeground}"/>

                        <Separator Grid.Row="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,10"/>

                        <TextBlock x:Name="DisplayLoadingText"
                                   Grid.Row="2"
                                   Text="Reading display info…"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,8"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextForeground}"/>

                        <ScrollViewer Grid.Row="3"
                                      VerticalScrollBarVisibility="Auto"
                                      Margin="0,0,0,0">
                            <StackPanel x:Name="MonitorStackPanel" Visibility="Collapsed"/>
                        </ScrollViewer>

                        <Button Grid.Row="4"
                                Style="{StaticResource ModernButton}"
                                Width="60" Height="30" Padding="0,4" FontSize="12"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0"
                                Click="DisplayRefreshButton_Click">Refresh</Button>

                        <StackPanel x:Name="AutoHdrSection"
                                    Grid.Row="5"
                                    Visibility="Collapsed"
                                    Margin="0,20,0,0">
                            <Separator Background="{DynamicResource BorderColor}" Margin="0,0,0,10"/>
                            <Border Padding="12,10"
                                    BorderThickness="1" CornerRadius="6"
                                    Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource BorderColor}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Auto HDR" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextForeground}"/>
                                        <TextBlock Text="Enables Windows Auto HDR for supported SDR games."
                                                   FontSize="12" Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextForeground}"/>
                                        <TextBlock Text="Changes apply immediately. Reopen Windows Settings to see them reflected there."
                                                   FontSize="12" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextForeground}"/>
                                        <TextBlock x:Name="AutoHdrWarning"
                                                   Visibility="Collapsed"
                                                   FontSize="12" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningForeground}">
                                            <InlineUIContainer BaselineAlignment="Center">
                                                <Image Source="/Resources/Twemoji/warning_3d.png" Width="12" Height="12" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </InlineUIContainer>
                                            <Run Text="  Auto HDR requires at least one display with HDR enabled."/>
                                        </TextBlock>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoHdrToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"
                                              Checked="AutoHdrToggle_Changed"
                                              Unchecked="AutoHdrToggle_Changed"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- ═══════════════ AUDIO PANEL ═══════════════ -->
                <Border x:Name="AudioPanel" Visibility="Collapsed"
                        Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="10" Padding="14,12,14,14"
                        TextElement.Foreground="{DynamicResource TextForeground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Spatial Audio Control"
                                       FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextForeground}"/>
                            <Separator Background="{DynamicResource BorderColor}" Margin="0,0,0,0"/>
                        </StackPanel>

                        <Image Grid.Row="2" Source="/Resources/Twemoji/headphones_3d.png"
                               Width="48" Height="48"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,10"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Output device selector -->
                        <ComboBox Grid.Row="3" x:Name="AudioDeviceComboBox" Margin="0,0,0,10"
                                  SelectionChanged="AudioDeviceComboBox_SelectionChanged"/>

                        <!-- Dolby Atmos availability -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                            <TextBlock x:Name="DolbyAccessIcon" Text="●" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,5,0"
                                       Foreground="Gray"/>
                            <TextBlock x:Name="DolbyAccessText" FontSize="12" VerticalAlignment="Center"
                                       Text="Checking Dolby Atmos for Headphones…"
                                       Foreground="{DynamicResource SecondaryTextForeground}"/>
                        </StackPanel>

                        <!-- Windows Sonic availability -->
                        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="SonicAccessIcon" Text="●" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,5,0"
                                       Foreground="Gray"/>
                            <TextBlock x:Name="SonicAccessText" FontSize="12" VerticalAlignment="Center"
                                       Text="Checking Windows Sonic for Headphones…"
                                       Foreground="{DynamicResource SecondaryTextForeground}"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Separator Grid.Row="7" Background="{DynamicResource BorderColor}"/>

                        <!-- Auto spatial audio toggle -->
                        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="Auto spatial audio" FontWeight="SemiBold" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox x:Name="SpatialAudioToggle" Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center" Checked="SpatialAudioToggle_Changed"
                                      Unchecked="SpatialAudioToggle_Changed"/>
                        </StackPanel>

                        <!-- Format selection -->
                        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <RadioButton x:Name="DolbyFormatRadio"
                                         Content="Dolby Atmos for Headphones"
                                         Style="{StaticResource SpatialFormatRadioStyle}"
                                         GroupName="SpatialFormat" Margin="0,0,24,0"
                                         Checked="AudioFormatRadio_Changed"/>
                            <RadioButton x:Name="SonicFormatRadio"
                                         Content="Windows Sonic for Headphones"
                                         Style="{StaticResource SpatialFormatRadioStyle}"
                                         GroupName="SpatialFormat"
                                         Checked="AudioFormatRadio_Changed"/>
                        </StackPanel>

                        <!-- Description -->
                        <TextBlock Grid.Row="11" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextForeground}"
                                   TextWrapping="Wrap" TextAlignment="Center" LineHeight="16"
                                   Text="The selected spatial audio format will be enabled on the chosen output device."/>

                        <!-- Status box -->
                        <Border Grid.Row="13" Padding="10,8"
                                Background="{DynamicResource WindowBackground}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Status:" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource TextForeground}"/>
                                <TextBlock x:Name="DolbyStatusText" FontSize="12" VerticalAlignment="Center"
                                           Text="Disabled" Foreground="{DynamicResource SecondaryTextForeground}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════════════ LOGS PANEL ═══════════════ -->
                <Border x:Name="LogsPanel" Visibility="Collapsed"
                        Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14,12,14,14" TextElement.Foreground="{DynamicResource TextForeground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Streaming Session History"
                                       FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextForeground}"/>
                            <Separator Background="{DynamicResource BorderColor}" Margin="0,0,0,8"/>
                        </StackPanel>

                        <!-- Session list: ListView + GridView for proportional columns -->
                        <ListView x:Name="SessionHistoryList"
                                  Grid.Row="1" Grid.RowSpan="2"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Margin="0,0,0,12"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SizeChanged="SessionHistoryList_SizeChanged"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">

                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,4,0,6"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GridViewColumnHeader">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="Role" Value="Padding">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.Resources>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0,2,0,2"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <GridViewRowPresenter
                                                        Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        Content="{TemplateBinding Content}"
                                                        VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <EventSetter Event="MouseLeftButtonUp" Handler="SessionRow_Click"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Grade}" Value="{x:Null}">
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.View>
                                <GridView>

                                    <!-- Col 0: telemetry button — fixed 30 DIP -->
                                    <GridViewColumn Width="30" Header="">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Width="22" Height="20"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        ToolTip="View session telemetry"
                                                        Click="SessionRow_Click"
                                                        Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background"      Value="#22FFFFFF"/>
                                                            <Setter Property="BorderBrush"     Value="#33FFFFFF"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Padding"         Value="0"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="4">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#44FFFFFF"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter Property="Background" Value="#66FFFFFF"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Grade}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Image Source="/Resources/Twemoji/bar_chart_3d.png"
                                                           Width="14" Height="14"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Button>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Col 1: Date / Time -->
                                    <GridViewColumn Width="120" Header="Date / Time">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StartTimeDisplay}" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextForeground}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Col 2: Duration -->
                                    <GridViewColumn Width="65" Header="Duration">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DurationDisplay}" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextForeground}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Col 3: NIC Throttle -->
                                    <GridViewColumn Width="80" Header="NIC Throttle">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding NicThrottleDisplay}" FontSize="12" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentColor}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Col 4: Original NIC Speed -->
                                    <GridViewColumn Width="140" Header="Original NIC Speed">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding OriginalNicSpeedDisplay}" FontSize="12" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentColor}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Col 5: Quality badge -->
                                    <GridViewColumn Width="90" Header="Quality">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center"
                                                             Fill="{Binding Grade, Converter={StaticResource GradeColorConverter}}"/>
                                                    <TextBlock Text="{Binding Grade, Converter={StaticResource GradeShortLabelConverter}}"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SecondaryTextForeground}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                </GridView>
                            </ListView.View>

                        </ListView>

                        <TextBlock x:Name="NoHistoryLabel" Grid.Row="2"
                                   Text="No sessions recorded yet." FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextForeground}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>

                        <StackPanel Grid.Row="3" Margin="0,0,0,4" HorizontalAlignment="Center">
                            <Button x:Name="ClearLogsButton"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource ModernButton}"
                                    FontSize="12" Height="28" Width="195"
                                    ToolTip="Clear session history"
                                    Click="ClearLogsButton_Click">Clear Session History</Button>
                            <TextBlock Text="Stream host log folder"
                                       FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"
                                       Foreground="{DynamicResource SecondaryTextForeground}"/>
                        </StackPanel>

                        <!-- ── Session detail popup overlay ── -->
                        <!-- Background #FF373737 = opaque composite of #202020 window + #1AFFFFFF PanelBackground.
                             Margin extends to cover LogsPanel's Padding="14,12,14,14" so the overlay fills
                             the entire rounded panel area including its padding. -->
                        <Border x:Name="SessionDetailOverlay"
                                Grid.Row="0" Grid.RowSpan="5"
                                Panel.ZIndex="20"
                                Visibility="Collapsed"
                                Opacity="0"
                                Background="#FF373737"
                                CornerRadius="9"
                                Margin="-14,-12,-14,-14"
                                RenderTransformOrigin="0.5,0.08">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="OverlayScaleTransform" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="14,12,14,0">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Session Detail" FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextForeground}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding StartTimeDisplay}" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextForeground}"/>
                                            <TextBlock Text="  ·  " FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextForeground}"/>
                                            <TextBlock Text="{Binding TelemetryDurationDisplay}" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextForeground}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Content="✕" Width="24" Height="24" FontSize="12"
                                            Click="CloseDetailOverlay_Click"
                                            Style="{StaticResource ModernButton}"/>
                                </Grid>

                                <Separator Grid.Row="1" Background="{DynamicResource BorderColor}" Margin="0,10,0,8"/>

                                <!-- Content: Grid distributes space — sparklines expand to fill all
                                     remaining vertical space between stats and grade badge. -->
                                <Grid Grid.Row="2" Margin="14,0,14,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>   <!-- CLIENT | HOST stats -->
                                        <RowDefinition Height="14"/>     <!-- spacer -->
                                        <RowDefinition Height="*"/>      <!-- sparklines — fill remaining -->
                                        <RowDefinition Height="12"/>     <!-- spacer -->
                                        <RowDefinition Height="Auto"/>   <!-- grade badge -->
                                    </Grid.RowDefinitions>

                                    <!-- CLIENT | HOST stats -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6"
                                                Padding="10,8">
                                            <StackPanel>
                                                <TextBlock Text="CLIENT  (StreamLight)" FontSize="12" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextForeground}" Margin="0,0,0,6"/>
                                                <local:StatRow Label="Jitter"  Val="{Binding QualityStats.JitterAvgMs,    StringFormat='avg {0:F1} ms'}" Val2="{Binding QualityStats.JitterMaxMs,    StringFormat='max {0:F0} ms'}"/>
                                                <local:StatRow Label="Drops"   Val="{Binding QualityStats.DropRatePct,    StringFormat='{}{0:F2}%'}"/>
                                                <local:StatRow Label="RTT"     Val="{Binding QualityStats.RttAvgMs,       StringFormat='avg {0:F1} ms'}" Val2="{Binding QualityStats.RttMaxMs,      StringFormat='max {0:F0} ms'}"/>
                                                <local:StatRow Label="Decode"  Val="{Binding QualityStats.DecodeAvgMs,    StringFormat='avg {0:F1} ms'}"/>
                                                <local:StatRow Label="Bitrate" Val="{Binding QualityStats.BitrateAvgMbps, StringFormat='avg {0:F0} Mbps'}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2"
                                                BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6"
                                                Padding="10,8">
                                            <StackPanel>
                                                <TextBlock Text="HOST  (StreamTweak)" FontSize="12" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextForeground}" Margin="0,0,0,6"/>
                                                <local:StatRow Label="GPU"      Val="{Binding QualityStats.HostGpuAvg,     StringFormat='avg {0}%'}"   Val2="{Binding QualityStats.HostGpuPeak,    StringFormat='peak {0}%'}"/>
                                                <local:StatRow Label="Encoder"  Val="{Binding QualityStats.HostGpuEncAvg,  StringFormat='avg {0}%'}"   Val2="{Binding QualityStats.HostGpuEncPeak, StringFormat='peak {0}%'}"/>
                                                <local:StatRow Label="GPU Temp" Val="{Binding QualityStats.HostGpuTempAvg, StringFormat='avg {0}°C'}"  Val2="{Binding QualityStats.HostGpuTempMax, StringFormat='max {0}°C'}"/>
                                                <local:StatRow Label="CPU"      Val="{Binding QualityStats.HostCpuAvg,     StringFormat='avg {0}%'}"   Val2="{Binding QualityStats.HostCpuPeak,    StringFormat='peak {0}%'}"/>
                                                <local:StatRow Label="Net TX"   Val="{Binding QualityStats.HostNetTxAvg,   StringFormat='avg {0} Mbps'}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Sparklines — client-only; Row Height="*" provides all remaining space -->
                                    <Border Grid.Row="2"
                                            BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6"
                                            Padding="10,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="6"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0"
                                                Text="CLIENT  Charts"
                                                FontSize="11" FontWeight="SemiBold"
                                                HorizontalAlignment="Center"
                                                Foreground="{DynamicResource TextForeground}"/>
                                            <Grid Grid.Row="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <local:SparklineControl Grid.Row="0" Grid.Column="0"
                                                    Points="{Binding RttTimeSeries}"
                                                    DurationSeconds="{Binding SessionDurationSeconds}"
                                                    Label="RTT ms"
                                                    StrokeBrush="#FFFF9800"
                                                    Tag="Rtt" Cursor="Hand"
                                                    MouseLeftButtonUp="Chart_Click"/>
                                                <local:SparklineControl Grid.Row="0" Grid.Column="2"
                                                    Points="{Binding DropsTimeSeries}"
                                                    DurationSeconds="{Binding SessionDurationSeconds}"
                                                    Label="Frame Drops"
                                                    StrokeBrush="#FFEF5350"
                                                    Tag="Drops" Cursor="Hand"
                                                    MouseLeftButtonUp="Chart_Click"/>
                                                <local:SparklineControl Grid.Row="2" Grid.Column="0"
                                                    Points="{Binding BitrateTimeSeries}"
                                                    DurationSeconds="{Binding SessionDurationSeconds}"
                                                    Label="Bitrate Mbps"
                                                    StrokeBrush="#FF29B6F6"
                                                    Tag="Bitrate" Cursor="Hand"
                                                    MouseLeftButtonUp="Chart_Click"/>
                                                <local:SparklineControl Grid.Row="2" Grid.Column="2"
                                                    Points="{Binding DecodeTimeSeries}"
                                                    DurationSeconds="{Binding SessionDurationSeconds}"
                                                    Label="Decode ms"
                                                    StrokeBrush="#FFA78BFA"
                                                    Tag="Decode" Cursor="Hand"
                                                    MouseLeftButtonUp="Chart_Click"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Grade badge -->
                                    <Border Grid.Row="4" Padding="8,5"
                                            BorderBrush="{Binding Grade, Converter={StaticResource GradeColorConverter}}"
                                            BorderThickness="1" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"
                                                     Fill="{Binding Grade, Converter={StaticResource GradeColorConverter}}"/>
                                            <TextBlock FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextForeground}"
                                                       Text="{Binding Grade, Converter={StaticResource GradeLabelConverter}}"/>
                                        </StackPanel>
                                    </Border>

                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="4" Padding="8,7"
                                Background="{DynamicResource WindowBackground}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <StackPanel x:Name="StreamingAppFoundPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="StreamingAppNameText"
                                               FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextForeground}"/>
                                    <TextBlock x:Name="StreamingAppLogPathText"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center"
                                               Margin="0,1,0,0"
                                               Foreground="{DynamicResource TextForeground}"
                                               Cursor="Hand"
                                               ToolTip="Click to open log folder"
                                               MouseLeftButtonUp="StreamingAppLogPathText_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="StreamingAppNotFoundText"
                                           Text="No streaming software detected"
                                           FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextForeground}"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>


                <!-- ═══════════════ APP PANEL ═══════════════ -->
                <Border x:Name="AppPanel" Visibility="Collapsed"
                        Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="10" Padding="14,12,14,14"
                        TextElement.Foreground="{DynamicResource TextForeground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Streaming App Manager"
                                   FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextForeground}"/>

                        <Separator Grid.Row="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" FontSize="12" Margin="0,0,0,8"
                                   Foreground="{DynamicResource SecondaryTextForeground}"
                                   TextWrapping="Wrap" TextAlignment="Center">
                            Apps in this list are closed when a streaming session starts and relaunched when it ends.
                        </TextBlock>

                        <ListBox x:Name="ManagedAppsList" Grid.Row="3"
                                 Margin="0,0,0,10"
                                 Background="{DynamicResource WindowBackground}"
                                 BorderBrush="{DynamicResource BorderColor}"
                                 BorderThickness="1"
                                 Foreground="{DynamicResource TextForeground}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="20" Height="20"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding Path}" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextForeground}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding AutoManage, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="12,0,0,0"
                                                  Click="AppAutoManage_Changed"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="4" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button Content="Add" Style="{StaticResource ModernButton}"
                                    Height="30" Width="80" Margin="0,0,8,0"
                                    Click="AddAppButton_Click"/>
                            <Button Content="Remove" Style="{StaticResource ModernButton}"
                                    Height="30" Width="80" Margin="0,0,8,0"
                                    Click="RemoveAppButton_Click"/>
                            <Button Content="End now" Style="{StaticResource ModernButton}"
                                    Height="30" Width="80" Margin="0,0,8,0"
                                    Click="KillAppButton_Click"/>
                            <Button Content="Restart" Style="{StaticResource ModernButton}"
                                    Height="30" Width="80"
                                    Click="RestartAppButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════ GAME LIBRARY PANEL ═══════════════ -->
                <Border x:Name="GameLibPanel" Visibility="Collapsed"
                        Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="10" Padding="14,12,14,14"
                        TextElement.Foreground="{DynamicResource TextForeground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Game Library Sync"
                                   FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextForeground}"/>

                        <Separator Grid.Row="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,10"/>

                        <!-- Enable toggle -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Enable Game Library Sync" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextForeground}"
                                           TextWrapping="Wrap">
                                    Discover installed games. Use Add to include games manually.
                                </TextBlock>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="GameLibSyncEnabledToggle"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center" Margin="14,0,0,0"
                                      Click="GameLibSyncEnabled_Changed"/>
                        </Grid>

                        <!-- Sync Now + Clear Sync buttons + status -->
                        <StackPanel Grid.Row="3" Margin="0,0,0,10"
                                    Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="SyncNowButton"
                                    Content="Sync Now" Style="{StaticResource ModernButton}"
                                    Height="30" Width="90"
                                    Click="SyncNow_Click"/>
                            <Button x:Name="ClearSyncButton"
                                    Content="Clear Sync" Style="{StaticResource ModernButton}"
                                    Height="30" Width="90" Margin="8,0,0,0"
                                    Click="ClearSync_Click"/>
                            <Button x:Name="AddGameButton"
                                    Content="Add" Style="{StaticResource ModernButton}"
                                    Height="30" Width="60" Margin="8,0,0,0"
                                    Click="AddGame_Click"/>
                            <TextBlock x:Name="GameLibStatusLabel"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextForeground}"
                                       TextWrapping="Wrap" Text="Not yet synced."/>
                        </StackPanel>

                        <!-- Discovered game list — cover art grid -->
                        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="GameLibList" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="136"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4"
                                                Background="{DynamicResource PanelBackground}"
                                                BorderBrush="{DynamicResource BorderColor}"
                                                BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <!-- Cover image with store badge overlay -->
                                                <Grid>
                                                    <Border Background="#1A1A2A" CornerRadius="5,5,0,0">
                                                        <Image Source="{Binding CoverImagePath, Converter={StaticResource CoverPathConverter}}"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>
                                                    <!-- Store badge -->
                                                    <Border Visibility="{Binding Store, Converter={StaticResource StoreBadgeVisConverter}}"
                                                            Background="#CC000000" CornerRadius="3" Padding="4,2"
                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            Margin="0,0,5,5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Viewbox Width="11" Height="11" Margin="0,0,3,0"
                                                                     SnapsToDevicePixels="True">
                                                                <Path Data="{Binding Store, Converter={StaticResource StoreBadgeGeomConverter}}"
                                                                      Fill="White"/>
                                                            </Viewbox>
                                                            <TextBlock Text="{Binding Store, Converter={StaticResource StoreBadgeNameConverter}}"
                                                                       FontSize="9" Foreground="White"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <!-- Sync toggle + remove button -->
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,7,0,7">
                                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              VerticalAlignment="Center" Margin="0,0,8,0"
                                                              Click="GameLibEntry_EnabledChanged"/>
                                                    <Button Content="Remove"
                                                            Style="{StaticResource ModernButton}"
                                                            FontSize="11"
                                                            Width="60" Height="28"
                                                            Click="RemoveGame_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>


                    </Grid>
                </Border>

                <!-- ═══════════════ GLOSSARY PANEL ═══════════════ -->
                <Border x:Name="GlossaryPanel" Visibility="Collapsed"
                        Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="10" Padding="14,12,14,14"
                        TextElement.Foreground="{DynamicResource TextForeground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Glossary"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextForeground}"/>
                            <Separator Background="{DynamicResource BorderColor}" Margin="0,0,0,8"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="#0E0E0E"
                                BorderBrush="{DynamicResource AccentColor}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,14,22,14"
                                            TextElement.FontFamily="Cascadia Code, Cascadia Mono, Consolas, Courier New">

                                    <!-- ── NETWORK ── -->
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentColor}"
                                               Margin="0,2,0,2">
                                        <InlineUIContainer BaselineAlignment="Center">
                                            <Image Source="/Resources/Twemoji/globe_3d.png" Width="12" Height="12" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </InlineUIContainer>
                                        <Run Text="  // NETWORK"/>
                                    </TextBlock>
                                    <Rectangle Height="0.5" Fill="{DynamicResource AccentColor}" Opacity="0.25" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="NIC" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="Network Interface Card — the physical network adapter in the computer." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Link Speed" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="Negotiated transmission speed between two network adapters (e.g. 1 Gbps, 2.5 Gbps)." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="NIC Throttle" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="Temporary reduction of the host NIC speed to match the client, eliminating bufferbloat." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Bufferbloat" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="High latency caused by excessive packet queuing in network buffers between host and client." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Net TX" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="Outbound network throughput from the host, expressed in Mbps." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <!-- ── STREAMING · CLIENT ── -->
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentColor}"
                                               Margin="0,18,0,2">
                                        <InlineUIContainer BaselineAlignment="Center">
                                            <Image Source="/Resources/Twemoji/satellite_3d.png" Width="12" Height="12" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </InlineUIContainer>
                                        <Run Text="  // STREAMING · CLIENT"/>
                                    </TextBlock>
                                    <Rectangle Height="0.5" Fill="{DynamicResource AccentColor}" Opacity="0.25" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="RTT" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="Round Trip Time — time for a packet to travel from client to host and back." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Jitter" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="RTT variability. Low but unstable RTT causes perceptible micro-stutter during streaming." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Frame Drops" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="Video frames lost in transit during network transmission." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Bitrate" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="Amount of video data transmitted per second, expressed in Mbps." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Decode Latency" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="Time the client takes to decode each received video frame, in milliseconds." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <!-- ── HOST METRICS ── -->
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentColor}"
                                               Margin="0,18,0,2">
                                        <InlineUIContainer BaselineAlignment="Center">
                                            <Image Source="/Resources/Twemoji/bar_chart_3d.png" Width="12" Height="12" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </InlineUIContainer>
                                        <Run Text="  // HOST METRICS"/>
                                    </TextBlock>
                                    <Rectangle Height="0.5" Fill="{DynamicResource AccentColor}" Opacity="0.25" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="GPU" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="Graphics Processing Unit — 3D engine utilization of the graphics card (%)." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="GPU Encoder" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="Hardware video encoding engine on the GPU used to compress the stream (NVENC on NVIDIA)." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="GPU Temp" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="GPU temperature in degrees Celsius. Available on NVIDIA hardware only via NVML." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="VRAM" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="Dedicated video memory of the GPU, shown as used / total in MB." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="CPU" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="Main processor utilization averaged across all cores (%)." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <!-- ── DISPLAY & AUDIO ── -->
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentColor}"
                                               Margin="0,18,0,2">
                                        <InlineUIContainer BaselineAlignment="Center">
                                            <Image Source="/Resources/Twemoji/desktop_3d.png" Width="12" Height="12" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </InlineUIContainer>
                                        <Run Text="  // DISPLAY &amp; AUDIO"/>
                                    </TextBlock>
                                    <Rectangle Height="0.5" Fill="{DynamicResource AccentColor}" Opacity="0.25" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="HDR" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="High Dynamic Range — display mode that expands luminance range beyond standard SDR limits." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Dolby Atmos" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="Spatial audio format that positions sound as 3D objects around the listener." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Windows Sonic" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="Microsoft's spatial audio platform, an alternative to Dolby Atmos for headphones." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Spatial Audio" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="Technology simulating three-dimensional surround sound through headphones or speakers." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Steam Streaming&#x0a;Speakers" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="Virtual audio device created by Steam during a remote play session." FontSize="13" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>

                                    <!-- ── STREAMING SERVERS ── -->
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentColor}"
                                               Margin="0,18,0,2">
                                        <InlineUIContainer BaselineAlignment="Center">
                                            <Image Source="/Resources/Twemoji/gear_3d.png" Width="12" Height="12" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </InlineUIContainer>
                                        <Run Text="  // STREAMING SERVERS"/>
                                    </TextBlock>
                                    <Rectangle Height="0.5" Fill="{DynamicResource AccentColor}" Opacity="0.25" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
